%% APP_FLOW.mmd — mifos-x-open-banking screen navigation graph
%% Rebuilt 2026-08-07 by /idea-sync STEP 4. Previous generation: 2026-08-03.

%% WHY THIS PASS WAS A REBUILD, NOT A REFRESH:
%%   The 2026-08-03 generation was correct for the app that existed on 2026-08-03 and wrong
%%   in BOTH directions for the app that exists now. It carried 46 screen nodes; 13 of them
%%   describe screens that have since been deleted, and 9 screens that now exist were absent
%%   entirely. Neither change was knowable on 2026-08-03:

%%   REMOVED — 13 nodes, and every edge that touched them:
%%     2026-08-06 seven-type payments rewrite + OBP eviction (11):
%%       send-money, send-money-amount, send-money-confirm, payment-result
%%         — superseded by the payments hub and the seven per-type rails.
%%       sca-challenge, change-password, forgot-password, transaction-tags
%%         — impossible under OBIE FAPI; there is no in-app credential and no tag resource.
%%       standing-order-edit  — PISP amendment is prohibited by the OBL CEG.
%%       standing-order-create — folded into pay-domestic-standing-order.
%%       fx-rates             — OBIE exposes no FX rate endpoint, so the screen had no data
%%                              source at all.
%%     2026-08-07 OBP-era surface removal (2):
%%       cards, card-detail   — OBIE has no card resource. A card is an Account whose
%%                              Account[].SchemeName == UK.OBIE.PAN, so there is nothing for a
%%                              separate cards spine to read; and card-detail's central
%%                              interactions (freeze/unfreeze, spending limits) are writes this
%%                              API does not have. Confirmed by the repository owner 2026-08-07.

%%   ADDED — 9 nodes:
%%     payments (the hub) plus pay-domestic-{single,scheduled,standing-order},
%%     pay-international-{single,scheduled,standing-order} and pay-vrp-mandate — the seven
%%     rails the single send-money form could never express, because the rails differ in
%%     step count, in debtor handling and in authorisation lifetime.
%%     branch-locator — the Open Data sort-code surface, reachable with no session.

%% 42 screens (screens/_list.json, every one verified present on disk) · 80 declared edges
%% · 1 shell node · 5 shell ingress edges.

%% NODE STYLE = lifecycle status:
%%   solid          implemented (20) — ui.yaml#implementation.status, shipped in source
%%   :::approved    approved (7)     — docs.yaml#status, specified, not yet wired into source
%%   :::enriched    enriched (15)    — docs.yaml#status, spec still in progress
%% NOTE ON THE STATUS SOURCE: the 2026-08-03 pass read ui.yaml#status. That key was moved to
%% the docs sibling by the 2026-08-04 CROSS_LEAK repair, so this pass reads
%% ui.yaml#implementation.status for "shipped" and docs.yaml#status for everything else.
%% RED BORDER (:::orphan) = no inbound edge. 10 nodes — see ORPHAN NOTES at the foot.
%% Dashed shell node = non-screen endpoint. Dotted edge = placeholder or shell ingress.

flowchart TD
    app_shell_bottom_nav["app shell · bottom nav"]:::shell

    %% ─── nodes ───
    %% Declared BEFORE any edge, because a Mermaid node joins whichever subgraph
    %% first mentions it — referencing a rail before the subgraph block would silently
    %% pull it out of the group.
    about["about"]:::enriched
    account_detail["account-detail"]
    account_holder["account-holder"]
    accounts["accounts"]
    atm_locator["atm-locator"]:::approved
    beneficiaries["beneficiaries"]
    branch_locator["branch-locator"]:::enriched
    consent_callback["consent-callback"]
    consent_detail["consent-detail"]
    consent_list["consent-list"]
    consent_manager["consent-manager"]:::approved
    direct_debit_detail["direct-debit-detail"]:::approved
    direct_debits["direct-debits"]
    home["home"]
    licences["licences"]
    login["login"]
    notifications["notifications"]:::approved
    payment_consent["payment-consent"]:::enriched
    payments["payments"]:::enriched
    payment_status["payment-status"]:::enriched
    pay_vrp_mandate["pay-vrp-mandate"]:::enriched
    privacy_policy["privacy-policy"]:::enriched
    product["product"]
    products["products"]:::enriched
    profile["profile"]:::approved
    scheduled_payments["scheduled-payments"]
    settings["settings"]
    splash["splash"]:::approved
    standing_order_detail["standing-order-detail"]:::approved
    standing_orders["standing-orders"]
    statement_detail["statement-detail"]
    statements["statements"]
    terms_of_service["terms-of-service"]:::enriched
    transaction_detail["transaction-detail"]
    transactions["transactions"]
    user_onboarding["user-onboarding"]

    %% ─── the six form rails ───
    %% Grouped because all six declare the SAME three edges with the same params, and
    %% because payment-consent and payment-status address the group rather than any member.
    %% pay-vrp-mandate is deliberately NOT in here — see the payments section.
    subgraph pay_rails["the six form rails — the originating type screen"]
        pay_domestic_single["pay-domestic-single"]:::enriched
        pay_domestic_scheduled["pay-domestic-scheduled"]:::enriched
        pay_domestic_standing_order["pay-domestic-standing-order"]:::enriched
        pay_international_single["pay-international-single"]:::enriched
        pay_international_scheduled["pay-international-scheduled"]:::enriched
        pay_international_standing_order["pay-international-standing-order"]:::enriched
    end

    %% ─── app-shell ingress (design-system/app-shell.yaml -> bottom_navigation.items) ───
    %% FOUR tabs, not five. The Cards tab was struck from flows/app-main.yaml on 2026-08-07;
    %% app-shell.yaml never had it, and app-shell.yaml is the shipped rail.
    app_shell_bottom_nav -.->|"0 Home"| home
    app_shell_bottom_nav -.->|"1 Accounts"| accounts
    app_shell_bottom_nav -.->|"2 Pay"| payments
    app_shell_bottom_nav -.->|"3 More"| settings
    %% Secondary Pay-tab ingress, declared in payment-status/flow.yaml -> entry_points[1]:
    %% settlement is batched on five-minute boundaries, so a PSU who leaves mid-settlement
    %% must be able to find the payment again rather than land on an empty hub.
    app_shell_bottom_nav -.->|"2 Pay — a payment is already in progress"| payment_status

    %% ─── entry / auth ───
    splash --> home
    splash --> login
    login -->|"HSBC authorisation redirect returns OAuth callback with auth code"| consent_callback
    login -->|"User taps Cancel"| user_onboarding
    user_onboarding -->|"Tap Connect with HSBC on step 3"| login
    consent_callback -->|"Consent status confirmed Authorised"| accounts
    consent_callback -->|"PSU rejected consent or token exchange failed"| login

    %% ─── accounts spine ───
    accounts -->|"Tap account card"| account_detail
    accounts -->|"401 access token expired or no active consent"| login
    accounts -->|"Tap Reconfirm access in the consent_expiring banner"| consent_detail
    accounts -->|"403 consent revoked mid-session"| consent_list
    account_detail -->|"Back button"| accounts
    account_detail -->|"AccountDetailChip.Transactions"| transactions
    account_detail -->|"AccountDetailChip.Statements"| statements
    account_detail -->|"AccountDetailChip.StandingOrders"| standing_orders
    account_detail -->|"AccountDetailChip.DirectDebits"| direct_debits
    account_detail -->|"AccountDetailChip.ScheduledPayments"| scheduled_payments
    account_detail -->|"AccountDetailChip.Beneficiaries"| beneficiaries
    account_detail -->|"AccountDetailChip.Product"| product
    account_detail -->|"AccountDetailChip.Party"| account_holder
    %% Declared under placeholder_transitions, not transitions: it ships and navigates, but
    %% lands on PlaceholderScreen. A real edge to a real screen, drawn dotted to say so.
    account_detail -.->|"AccountDetailChip.AtmLocator — placeholder route"| atm_locator
    account_holder -->|"Back navigation"| account_detail
    product -->|"Back navigation"| account_detail
    beneficiaries -->|"Back button"| account_detail
    beneficiaries -->|"View Consents on 403 ConsentRevoked"| consent_list
    scheduled_payments -->|"Back button"| account_detail
    standing_orders -->|"Back button"| account_detail
    direct_debits -->|"Back button"| account_detail

    %% ─── transactions / statements ───
    home -->|"Tap View all in recent transactions"| transactions
    home -->|"Tap a recent transaction row"| transaction_detail
    transactions -->|"Tap transaction row"| transaction_detail
    transactions -->|"Back button"| account_detail
    transaction_detail -->|"Back button"| transactions
    statements -->|"Tap statement row"| statement_detail
    statements -->|"Back navigation"| account_detail
    statement_detail -->|"Back navigation"| statements
    statement_detail -->|"Tap transaction row in the statement list"| transaction_detail

    %% ─── payments · hub -> the seven rails (screens/payments/flow.yaml) ───
    payments -->|"Tap the Domestic single tile"| pay_domestic_single
    payments -->|"Tap the Domestic scheduled tile"| pay_domestic_scheduled
    payments -->|"Tap the Domestic standing order tile"| pay_domestic_standing_order
    payments -->|"Tap the International single tile"| pay_international_single
    payments -->|"Tap the International scheduled tile"| pay_international_scheduled
    payments -->|"Tap the International standing order tile"| pay_international_standing_order
    payments -->|"Tap the VRP mandate tile — opens the mandate LIST"| pay_vrp_mandate

    %% ─── payments · the shared legs ───
    %% WHY THESE POINT AT THE GROUP AND NOT AT A SCREEN:
    %% payment-consent and payment-status are SHARED legs across every rail. Their own
    %% flow.yaml files (both corrected 2026-08-07) declare their parent as the ORIGINATING
    %% TYPE SCREEN, resolved at runtime from a nav param — never a fixed screen. The
    %% originator holds the x-idempotency-key generated once per staged payment and the
    %% staged Initiation it must resend; returning to the wrong rail loses both and the
    %% submit fails U008. So a single fixed edge would be a lie, and seven hardcoded
    %% return edges would assert seven bindings the spec explicitly refuses to make.
    %% The group edge is the honest shape: one relationship, dynamically resolved.
    pay_rails ==>|"Confirm on the Review step, consent stages 201 — each rail declares this"| payment_consent
    payment_consent ==>|"Consent reaches AUTH — returns to the ORIGINATING rail, resolved at runtime"| pay_rails
    pay_rails ==>|"Submit returns 201 — Tap View status"| payment_status
    payment_status ==>|"Back — to the rail that produced the payment, resolved from paymentFamily"| pay_rails
    pay_rails ==>|"Back from the first step, or Cancel"| payments

    %% Only the two international rails declare an RJCT return — a real observed terminal
    %% state (consent 45121), not a shared leg. Drawn per-rail because only these two have it.
    payment_consent -->|"Consent reaches RJCT — PSU denied it at the bank"| pay_international_single
    payment_consent -->|"Consent reaches RJCT"| pay_international_scheduled

    %% ─── payments · VRP, the asymmetric rail ───
    %% VRP is kept OUT of pay_rails because its authorisation model inverts the others':
    %% one authorisation per MANDATE, not per payment. The consent stays AUTH and funds many
    %% payments, so the pay path never touches payment-consent at all. Grouping it with the
    %% six would assert a per-payment authorise leg that would defeat the point of the rail.
    %% pay-vrp-mandate-create and pay-vrp-mandate-detail are STEPS inside this one route,
    %% not screens in screens/_list.json, so their edges are collapsed onto this node.
    pay_vrp_mandate -->|"Create: Confirm on Review step 4 of 4 — fires ONCE per mandate"| payment_consent
    payment_consent -->|"Consent reaches AUTH — lands on the mandate detail"| pay_vrp_mandate
    pay_vrp_mandate -->|"Pay now, funds confirmed, POST domestic-vrps 201 — no re-authentication"| payment_status
    payment_status -->|"Manage mandate, when paymentFamily is domestic-vrp"| pay_vrp_mandate
    %% A TERMINAL NON-TRANSITION: consent AUTH, funds confirmed Available, payment refused
    %% 400 U021 because the bank wrote a non-SortCodeAccountNumber debtor into the consent.
    %% Consent 45224 failed three times and stayed AUTH. There is no route forward.
    pay_vrp_mandate -->|"Pay now refused 400 U021 — mandate marked unpayable, no retry"| pay_vrp_mandate

    payment_status -->|"New payment on a Rejected status — to the HUB, so the PSU may pick another rail"| payments

    %% ─── recurring payments ───
    direct_debit_detail -->|"ddd_empty_back — the mandate no longer resolves"| direct_debits
    direct_debit_detail -->|"ddd_view_all — the funding account history"| transactions
    standing_order_detail -->|"sod_history_row — a Recent Executions row"| transaction_detail

    %% ─── branch locator (Open Data, no session required) ───
    %% Every edge here is declared in screens/branch-locator/flow.yaml -> entry_points[],
    %% not in the source screens' own files. The three sort-code entries were added
    %% 2026-08-07: they are the places the app already holds a sort code.
    settings -->|"Find a branch"| branch_locator
    atm_locator -->|"Branch reference on an ATM record"| branch_locator
    beneficiaries -->|"Sort code on a saved payee"| branch_locator
    standing_order_detail -->|"Sort code on the destination account"| branch_locator
    transaction_detail -->|"Sort code on the counterparty account"| branch_locator

    %% ─── consents ───
    consent_list -->|"Tap a consent card"| consent_detail
    consent_list -->|"Tap Connect HSBC on empty state"| login
    consent_list -->|"Tap Sign in again on auth error state, 401"| login
    consent_detail -->|"Consent successfully revoked"| consent_list
    consent_detail -->|"Tap Reconfirm before expiry"| login
    consent_manager --> settings

    %% ─── settings / profile / legal ───
    settings -->|"Tap Manage Consents row"| consent_list
    settings -->|"Tap Licences row"| licences
    licences -->|"Back navigation"| settings
    profile --> login

    %% ─── orphan marking (no inbound edge) ───
    class splash,privacy_policy,terms_of_service,about,profile orphan
    class products,notifications,consent_manager,direct_debit_detail,standing_order_detail orphan

    classDef approved fill:#EBEEF3,stroke:#50606E,stroke-dasharray:4 3
    classDef enriched fill:#F1F4F9,stroke:#72787E,stroke-dasharray:2 2
    classDef shell fill:#FFFFFF,stroke:#72787E,stroke-dasharray:6 3
    classDef orphan stroke:#BA1A1A,stroke-width:2px

%% ─────────────────────────────────────────────────────────────────────────────
%% ORPHAN NOTES — 10 nodes carry no inbound edge. These are NOT all defects.

%%   splash              ENTRY POINT. Orphan by design; the app opens here.

%%   privacy-policy      settings/flow.yaml lists the Privacy row under
%%   terms-of-service    external_transitions, not transitions — it hands a URL to
%%                       LocalUriHandler and leaves the app. The in-app screens exist and are
%%                       specified, but nothing in-app navigates to them.

%%   about               flows/app-main.yaml declares about -> {terms-of-service,
%%                       privacy-policy, licences} and flows/consumer-banking.yaml declares
%%                       settings -> about. NEITHER is mirrored in any screen's flow.yaml:
%%                       about/flow.yaml is navigates_to: [] and settings/flow.yaml declares
%%                       only consent-list and licences. This diagram follows flow.yaml, so
%%                       about reads as an orphan here while the flow roster says otherwise.
%%                       That contradiction is real and is the item most worth resolving.

%%   profile             settings/flow.yaml carries an explicit removed_in_sync entry:
%%                       "the profile screen was never built; no such row or callback exists".
%%                       docs.yaml#status is orphaned-pending-decision. The orphan state is
%%                       the accurate record of an undecided screen, not a missing edge.

%%   products            Reachable-before-login by design (reachable_before_login: true —
%%                       the Open Data Product Finder takes no token, consent or session).
%%                       A pre-auth surface has no in-app parent by definition. Do not
%%                       "fix" this by inventing an edge from accounts: products reads a
%%                       PUBLIC catalogue and touches nothing belonging to the PSU.

%%   notifications       Specified but not wired. Each has NO outbound edge either
%%   consent-manager       (except consent-manager, which declares its return to settings
%%                       while settings still points at the older consent-list).

%%   direct-debit-detail Each declares its return edge; the PARENT has not declared the
%%   standing-order-detail forward one. flows/consumer-banking.yaml DOES declare both
%%                       (direct-debits -> direct-debit-detail, standing-orders ->
%%                       standing-order-detail) — the per-screen flow.yaml files are the
%%                       half that was never updated. This is the same one-directional
%%                       declaration gap the 2026-08-03 pass recorded, still open.

%% NOT ORPHANS ANY MORE, and worth naming:
%%   atm-locator         gained an inbound edge this pass. account-detail/flow.yaml declares
%%                       AccountDetailChip.AtmLocator under placeholder_transitions, which
%%                       the 2026-08-03 pass read only from `transitions` and so missed.
%%   branch-locator      five inbound edges, all declared in its OWN entry_points[] rather
%%                       than in the source screens' files. Reading entry_points as an edge
%%                       source is what makes it reachable.

%% ─────────────────────────────────────────────────────────────────────────────
%% EDGE SOURCE — this diagram follows screens/{feature}/flow.yaml (transitions[],
%% entry_points[], placeholder_transitions[], navigates_to[] and flow_logic[]) plus
%% design-system/app-shell.yaml for shell ingress. It does NOT draw the app-level
%% connections[] in flows/app-main.yaml and flows/consumer-banking.yaml, because on several
%% pairs the two disagree and flow.yaml is the declared nav contract. The disagreements,
%% recorded rather than silently resolved:

%%   home/flow.yaml states homeGraph declares exactly TWO outward callbacks and carries a
%%   removed_in_sync block rejecting home -> {account-detail, statements, consent-list}.
%%   flows/consumer-banking.yaml still declares nine outward edges from home. Drawing them
%%   would assert bindings that home/flow.yaml explicitly denies.

%%   flows/consumer-banking.yaml declares settings -> about, standing-orders ->
%%   standing-order-detail, standing-orders -> pay-domestic-standing-order, direct-debits ->
%%   direct-debit-detail and beneficiaries -> payments. None is mirrored in the parent's
%%   flow.yaml. Each is a plausible product edge missing its per-screen declaration, and
%%   each is the reason for an orphan above.

%% RESOLVING THAT DELTA IS A SEPARATE PASS: it means editing the parents' flow.yaml files to
%% declare the forward edges, not editing this diagram. A generated view must not paper over
%% a disagreement between its own inputs.
%% ─────────────────────────────────────────────────────────────────────────────
