{
  "_meta": {
    "project": "mifos-x-group-banking",
    "purpose": "Runnable POST /datatables register definitions for all 21 MifosSave custom datatables under the Group-centric model (the savings group IS a Fineract m_group). Each entry is a self-contained Fineract `POST /datatables` (COMP-DT-001 register) payload. Run in array order via ../register-datatables.sh.",
    "source_of_truth": "idea-layer/server/DATATABLE_REGISTRY.yaml (single SoT \u2014 Group-centric) + idea-layer/server/ENTITY_MODEL.yaml. Conformance enforced by mifos-bridge gate MB-5/MB-6/MB-7 (capsules/idea/mifos-bridge/verify/datatable-conformance.sh).",
    "fineract_type_note": "Types are lowercase (string|number|decimal|boolean|date|datetime|text). entitySubType \u2208 GROUP|CLIENT|LOAN (ENTITY_MODEL.yaml INV-1). The 7 group state tables (dt_group_config, dt_group_corpus, dt_meeting_record, dt_share_out, dt_social_fund, dt_sync_metadata, dt_group_loan_policy) are parented to m_group.",
    "total": 21,
    "by_parent": {
      "m_group": 14,
      "m_client": 5,
      "m_loan": 2
    },
    "deprecated_note": "dt_member_invitation removed from the active array \u2014 superseded by dt_companion_invitations on m_group (DATATABLE_REGISTRY.yaml deprecated[])."
  },
