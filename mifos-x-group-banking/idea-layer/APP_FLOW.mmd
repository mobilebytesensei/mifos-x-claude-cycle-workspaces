%%{init: {'theme': 'default', 'flowchart': {'curve': 'basis'}}}%%
flowchart TD
    APP([App Launch]) --> LS[login-signup]

    %% ─── Unified self-signup — one screen, role auto-resolved per group ───
    LS -->|sign up / login success · has organizer role| OD[organizer-dashboard]
    LS -->|login success · member-only| PD[personal-dashboard]
    LS -->|zero groups — empty state| ZERO{{create first group / join with code}}
    LS -->|opened an invite link| JWC[join-with-code]
    ZERO -->|create a group| GC[group-create]
    ZERO -->|join with code| JWC
    JWC -->|code accepted · self-registered| PD

    %% ─── Organizer surface ───────────────────────────────────────────
    OD -->|my groups| GL[group-list]
    OD -->|+ new group| GC
    GL -->|tap group card| GD[group-dashboard]
    GL -->|+ FAB| GC
    GC -->|choose type| GTP[group-type-picker]
    GTP -->|type configured| GD

    %% Group-dashboard outgoing navigation
    GD -->|members tab| ML[member-list]
    ML -->|tap member| MP[member-profile]
    ML -->|+ invite member| MI[member-invite]
    MP -->|+ Add Member| MA[member-add]
    MP -->|View Savings tap| MSD[member-savings-detail]
    MSD -->|back| MP
    MA -->|saved| MP
    MI -->|link sent| ML

    GD -->|loans tab| LL[loan-list]
    LL -->|tap loan| LD[loan-detail]
    LL -->|+ apply| LA[loan-apply]
    LA -->|submitted pending vote| LD
    LD -->|Repay tap| LRD{{loan-repayment-dialog}}
    LD -->|Mark Defaulted tap| LMD{{loan-mark-defaulted-dialog}}
    LRD -->|payment recorded| LD
    LMD -->|marked defaulted| LD

    GD -->|meeting calendar| MC_CAL[meeting-calendar]
    MC_CAL -->|upcoming meeting — Start| PMR[previous-meeting-review]
    PMR -->|start meeting| MC[meeting-conduct]
    MC -->|Step vote approved| LD
    MC -->|wizard complete| MS[meeting-summary]
    MS -->|back to group| GD

    GD -->|savings tab| SD[savings-dashboard]

    GD -->|Share Out| SOP[share-out-preview]
    SOP -->|confirm preview| SOE[share-out-execute]
    SOE -->|distributed| GD

    %% ─── Member surface ──────────────────────────────────────────────
    PD -->|savings card| PS[personal-savings]
    PD -->|loan card or FAB| PL[personal-loans]
    PD -->|Request Loan CTA| LR[loan-request]
    LR -->|submitted — appears in next meeting| PL

    %% ─── Platform / shared screens ───────────────────────────────────
    OD -->|sync indicator| SS[sync-status]
    GD -->|sync indicator| SS
    PD -->|sync indicator| SS
    OD -->|settings| SET[settings]
    PD -->|settings| SET
    SET -->|logout| SLD{{settings-logout-dialog}}
    SLD -->|confirm logout| LS
    SET -->|language changed| SET

    %% ─── v1.1.0 supervisory tier (dashed, demoted) ───────────────────
    OD -.->|field officer role| FOD[field-officer-dashboard]
    FOD -.->|group health card| GD

    %% ─── Style ────────────────────────────────────────────────────────
    style APP fill:#f9f,stroke:#333,stroke-width:2px
    style LS fill:#ff9,stroke:#333,stroke-width:2px
    style OD fill:#bfb,stroke:#333,stroke-width:2px
    style PD fill:#bfb,stroke:#333,stroke-width:2px
    style GD fill:#bfb,stroke:#333,stroke-width:2px
    style MC fill:#bbf,stroke:#333,stroke-width:2px
    style SS fill:#fdb,stroke:#333

