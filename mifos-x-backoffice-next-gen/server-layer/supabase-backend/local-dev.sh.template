#!/bin/bash
# Local Supabase Development Helper — ${PROJECT_NAME}
# Template source: core/blueprints/workspace-project/server-layer/supabase-backend/local-dev.sh.template
# Generated by /server-init on <DATE> — customize freely; re-generating preserves customizations
#
# Usage: ./local-dev.sh <command>
#
# Commands:
#   start           Start local Supabase + migrate + seed
#   stop            Stop local Supabase (data preserved)
#   reset           Wipe DB, re-apply migrations + seed
#   status          Show running status, URLs, and keys
#   studio          Open Supabase Studio in browser
#   logs            Tail container logs (Ctrl+C to stop)
#   nuke            Full stop + remove volumes (clean slate)
#   functions       Serve Edge Functions locally (reads .env.local)
#   functions-stop  Stop Edge Functions runtime container

set -e
cd "$(dirname "$0")"

# ── Colors ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ── Paths ─────────────────────────────────────────────────────────
CONFIG_FILE="supabase/config.toml"
SEED_FILE="supabase/seed.sql"
ENV_LOCAL="../.env.local"
FUNCTIONS_CONTAINER="supabase_edge_runtime_supabase-backend"

# ── Read ports from config.toml ─────────────────────────────────────
API_PORT=$(grep -A3 '^\[api\]' "$CONFIG_FILE" | grep '^port' | head -1 | sed 's/.*= *//')
STUDIO_PORT=$(grep -A3 '^\[studio\]' "$CONFIG_FILE" | grep '^port' | head -1 | sed 's/.*= *//')
DB_PORT=$(grep -A3 '^\[db\]' "$CONFIG_FILE" | grep '^port' | head -1 | sed 's/.*= *//')
DB_URL="postgresql://postgres:postgres@127.0.0.1:${DB_PORT}/postgres"

# ── Helpers ──────────────────────────────────────────────────────────
check_docker() {
    if docker info &>/dev/null; then
        return 0
    fi

    echo -e "${YELLOW}Docker is not running. Starting Docker Desktop...${NC}"

    # macOS: open Docker Desktop
    if [ -d "/Applications/Docker.app" ]; then
        open -a Docker
    elif [ -d "$HOME/Applications/Docker.app" ]; then
        open -a "$HOME/Applications/Docker.app"
    else
        echo -e "${RED}Docker Desktop not found. Install from https://docker.com/products/docker-desktop${NC}"
        exit 1
    fi

    # Wait for Docker to be ready (max 60s)
    echo -n "  Waiting for Docker"
    local waited=0
    while ! docker info &>/dev/null; do
        echo -n "."
        sleep 2
        waited=$((waited + 2))
        if [ "$waited" -ge 60 ]; then
            echo ""
            echo -e "${RED}Docker did not start within 60 seconds.${NC}"
            exit 1
        fi
    done
    echo -e " ${GREEN}ready${NC}"
}

is_running() {
    supabase status &>/dev/null 2>&1
}

ensure_supabase() {
    check_docker
    if is_running; then
        return 0
    fi

    echo -e "${YELLOW}Local Supabase containers stopped. Starting...${NC}"
    supabase start
    echo -e "${GREEN}Supabase is running.${NC}"
}

print_ready() {
    local ANON_KEY
    ANON_KEY=$(supabase status -o json 2>/dev/null | grep -o '"ANON_KEY":"[^"]*"' | head -1 | cut -d'"' -f4 || echo "run 'supabase status'")

    echo ""
    echo -e "${BOLD}${GREEN}━━━ \${PROJECT_NAME} Local Supabase ━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${CYAN}API${NC}       http://127.0.0.1:${API_PORT}"
    echo -e "  ${CYAN}Studio${NC}    http://127.0.0.1:${STUDIO_PORT}"
    echo -e "  ${CYAN}DB${NC}        ${DB_URL}"
    echo -e "  ${CYAN}Anon Key${NC}  ${ANON_KEY}"
    echo -e "${BOLD}${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  ${BOLD}Studio${NC}        ./local-dev.sh studio"
    echo -e "  ${BOLD}Reset DB${NC}      ./local-dev.sh reset"
    echo -e "  ${BOLD}Stop${NC}          ./local-dev.sh stop"
    echo ""
}

# ── Commands ─────────────────────────────────────────────────────────
case "${1:-help}" in
    start)
        check_docker

        if is_running; then
            echo -e "${YELLOW}Local Supabase is already running.${NC}"
            print_ready
            exit 0
        fi

        echo -e "${GREEN}Starting local Supabase...${NC}"
        supabase start

        echo ""
        echo -e "${GREEN}Applying migrations and seed data...${NC}"
        supabase db reset

        print_ready
        ;;

    stop)
        echo -e "${GREEN}Stopping local Supabase...${NC}"
        supabase stop
        echo -e "${YELLOW}Stopped. Data preserved — run './local-dev.sh start' to resume.${NC}"
        ;;

    reset)
        check_docker

        echo -e "${GREEN}Resetting database (re-apply all migrations + seed)...${NC}"
        supabase db reset

        print_ready
        ;;

    status)
        if is_running; then
            supabase status
        else
            echo -e "${YELLOW}Local Supabase is not running.${NC}"
            echo "Run: ./local-dev.sh start"
        fi
        ;;

    studio)
        ensure_supabase
        echo -e "${CYAN}Opening Studio...${NC}"
        open "http://127.0.0.1:${STUDIO_PORT}"
        ;;

    logs)
        check_docker
        echo -e "${CYAN}Tailing Supabase logs (Ctrl+C to stop)...${NC}"
        docker logs -f supabase_db_supabase-backend 2>&1
        ;;

    nuke)
        echo -e "${RED}${BOLD}This will DELETE all local data and volumes.${NC}"
        read -p "Are you sure? (y/N) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            supabase stop --no-backup 2>/dev/null || true
            echo -e "${GREEN}Nuked. Run './local-dev.sh start' for a clean slate.${NC}"
        else
            echo "Cancelled."
        fi
        ;;

    functions)
        ensure_supabase

        if [ ! -f "$ENV_LOCAL" ]; then
            echo -e "${YELLOW}No .env.local found at ${ENV_LOCAL}${NC}"
            echo -e "${YELLOW}Run /server-init to generate, or create manually.${NC}"
            exit 1
        fi

        # Remove stale container if exists
        docker rm -f "$FUNCTIONS_CONTAINER" 2>/dev/null || true

        echo -e "${GREEN}Serving Edge Functions...${NC}"
        echo -e "  ${CYAN}Env file${NC}  ${ENV_LOCAL}"
        echo ""
        echo -e "  ${BOLD}Available functions:${NC}"
        for dir in supabase/functions/*/; do
            fname=$(basename "$dir")
            [ "$fname" = "_shared" ] && continue
            echo -e "    ${CYAN}POST${NC} http://127.0.0.1:${API_PORT}/functions/v1/${fname}"
        done
        echo ""
        echo -e "  ${YELLOW}Press Ctrl+C to stop${NC}"
        echo ""
        supabase functions serve --env-file "$ENV_LOCAL"
        ;;

    functions-stop)
        echo -e "${GREEN}Stopping Edge Functions runtime...${NC}"
        docker rm -f "$FUNCTIONS_CONTAINER" 2>/dev/null || true
        echo -e "${GREEN}Edge Functions stopped.${NC}"
        ;;

    help|*)
        echo -e "${BOLD}Local Supabase Development Helper${NC} — \${PROJECT_NAME}"
        echo ""
        echo -e "Usage: ${CYAN}./local-dev.sh <command>${NC}"
        echo ""
        echo "Commands:"
        echo -e "  ${BOLD}start${NC}            Start Supabase + migrate + seed"
        echo -e "  ${BOLD}stop${NC}             Stop local Supabase (data preserved)"
        echo -e "  ${BOLD}reset${NC}            Wipe DB, re-apply migrations + seed"
        echo -e "  ${BOLD}status${NC}           Show running status, URLs, and keys"
        echo -e "  ${BOLD}studio${NC}           Open Supabase Studio in browser"
        echo -e "  ${BOLD}logs${NC}             Tail container logs"
        echo -e "  ${BOLD}nuke${NC}             Full stop + remove all data (clean slate)"
        echo -e "  ${BOLD}functions${NC}        Serve Edge Functions locally (needs .env.local)"
        echo -e "  ${BOLD}functions-stop${NC}   Stop Edge Functions runtime container"
        echo ""
        echo -e "Ports: API=${API_PORT}  Studio=${STUDIO_PORT}  DB=${DB_PORT}"
        echo ""
        echo "Edge Functions require ../.env.local — generated by /server-init."
        ;;
esac
