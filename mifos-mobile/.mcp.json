{
  "mcpServers": {
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      },
      "_comment": "Primary: Remote Stitch MCP server for fast mockup generation. Get API key at: https://stitch.withgoogle.com/settings"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--headless"],
      "_comment": "Fallback: Chrome DevTools MCP for browser automation. Auto-installed on first use."
    },
    "figma": {
      "type": "http",
      "url": "https://api.figma.com/v1",
      "headers": {
        "X-Figma-Token": "${FIGMA_API_TOKEN}"
      },
      "_comment": "Optional: Figma REST API integration. Get token at: https://www.figma.com/developers/api#authentication",
      "_status": "optional"
    }
  },
  "mockupAutomation": {
    "enabled": true,
    "primaryPlatform": "stitch",
    "fallbackChain": ["stitch", "chrome", "manual"],
    "stitchConfig": {
      "url": "https://stitch.withgoogle.com/",
      "mcpEndpoint": "https://stitch.googleapis.com/mcp",
      "modelId": "GEMINI_3_PRO"
    },
    "chromeConfig": {
      "url": "https://stitch.withgoogle.com/",
      "autoInstall": true,
      "headless": true,
      "selectors": {
        "prompt": [
          "textarea[aria-label*='prompt']",
          "textarea[placeholder*='describe']",
          "textarea[data-testid='prompt-input']",
          "div[contenteditable='true']",
          "textarea:first-of-type"
        ],
        "generate": [
          "button[type='submit']",
          "button:has-text('Generate')",
          "button[aria-label*='generate']"
        ]
      }
    }
  }
}
