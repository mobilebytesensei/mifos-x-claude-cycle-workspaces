%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#4CAF50', 'primaryTextColor': '#fff', 'primaryBorderColor': '#388E3C', 'lineColor': '#757575', 'secondaryColor': '#E3F2FD', 'tertiaryColor': '#F5F5F5'}}}%%

flowchart TD
    %% ============================================================
    %% AUTHENTICATION FLOW - mifos-mobile
    %% Generated: 2026-01-19
    %% Based on: features/auth/SPEC.md
    %% ============================================================

    %% ENTRY POINT
    START([App Launch]) --> SPLASH

    %% ============================================================
    %% SPLASH / AUTH CHECK
    %% ============================================================
    subgraph splash[Splash]
        SPLASH[Splash Screen]
        SPLASH --> AUTH_CHECK{Has Valid\nSession?}
        AUTH_CHECK -->|Yes| PASSCODE_CHECK{Passcode\nEnabled?}
        AUTH_CHECK -->|No| LOGIN
        PASSCODE_CHECK -->|Yes| PASSCODE_VERIFY
        PASSCODE_CHECK -->|No| HOME
    end

    %% ============================================================
    %% LOGIN FLOW
    %% ============================================================
    subgraph login[Login]
        LOGIN[Login Screen]
        LOGIN --> INPUT_CREDS[Enter Username\nEnter Password]
        INPUT_CREDS --> VALIDATE_LOGIN{Valid\nCredentials?}
        VALIDATE_LOGIN -->|Error| LOGIN_ERROR[Show Error Dialog]
        LOGIN_ERROR --> INPUT_CREDS
        VALIDATE_LOGIN -->|Success| PASSCODE_SETUP
    end

    %% ============================================================
    %% PASSCODE FLOW
    %% ============================================================
    subgraph passcode[Passcode]
        PASSCODE_SETUP[Setup Passcode]
        PASSCODE_SETUP --> ENTER_PIN[Enter 4-digit PIN]
        ENTER_PIN --> CONFIRM_PIN[Confirm PIN]
        CONFIRM_PIN --> PIN_MATCH{PINs\nMatch?}
        PIN_MATCH -->|No| PIN_ERROR[Show Mismatch Error]
        PIN_ERROR --> ENTER_PIN
        PIN_MATCH -->|Yes| SAVE_PASSCODE[Save Passcode]
        SAVE_PASSCODE --> HOME

        PASSCODE_VERIFY[Verify Passcode]
        PASSCODE_VERIFY --> CHECK_PIN{PIN\nCorrect?}
        CHECK_PIN -->|Yes| HOME
        CHECK_PIN -->|No| RETRY_PIN[Show Error]
        RETRY_PIN --> PASSCODE_VERIFY
        RETRY_PIN -->|Max Retries| LOGOUT[Force Logout]
        LOGOUT --> LOGIN
    end

    %% ============================================================
    %% REGISTRATION FLOW
    %% ============================================================
    subgraph registration[Registration]
        SIGNUP[Registration Screen]
        SIGNUP --> REG_FORM[Fill Registration Form]
        REG_FORM --> |First Name, Last Name\nEmail, Mobile, Password\nAccount Number| VALIDATE_REG{Valid\nForm?}
        VALIDATE_REG -->|Error| REG_ERROR[Show Validation Error]
        REG_ERROR --> REG_FORM
        VALIDATE_REG -->|Success| UPLOAD_ID
    end

    %% ============================================================
    %% DOCUMENT UPLOAD FLOW
    %% ============================================================
    subgraph upload[Document Upload]
        UPLOAD_ID[Upload ID Screen]
        UPLOAD_ID --> SELECT_DOC[Select ID Document]
        SELECT_DOC --> CAPTURE_DOC{Capture\nMethod?}
        CAPTURE_DOC -->|Camera| TAKE_PHOTO[Take Photo]
        CAPTURE_DOC -->|Gallery| SELECT_PHOTO[Select from Gallery]
        TAKE_PHOTO --> PREVIEW_DOC[Preview Document]
        SELECT_PHOTO --> PREVIEW_DOC
        PREVIEW_DOC --> UPLOAD_DOC[Upload Document]
        UPLOAD_DOC --> OTP_VERIFY
    end

    %% ============================================================
    %% OTP VERIFICATION FLOW
    %% ============================================================
    subgraph otp[OTP Verification]
        OTP_VERIFY[OTP Screen]
        OTP_VERIFY --> ENTER_OTP[Enter OTP Code]
        ENTER_OTP --> VERIFY_OTP{OTP\nValid?}
        VERIFY_OTP -->|Error| OTP_ERROR[Show Error]
        OTP_ERROR --> RESEND_OTP[Resend OTP]
        RESEND_OTP --> ENTER_OTP
        VERIFY_OTP -->|Success| REG_SUCCESS
    end

    %% ============================================================
    %% PASSWORD RECOVERY FLOW
    %% ============================================================
    subgraph recovery[Password Recovery]
        FORGOT_PWD[Forgot Password Screen]
        FORGOT_PWD --> ENTER_EMAIL[Enter Email/Username]
        ENTER_EMAIL --> SEND_RESET[Send Reset Code]
        SEND_RESET --> VERIFY_RESET[Verify Reset Code]
        VERIFY_RESET --> SET_NEW_PWD[Set New Password]
        SET_NEW_PWD --> PWD_UPDATED[Password Updated]
        PWD_UPDATED --> LOGIN
    end

    %% ============================================================
    %% SUCCESS STATES
    %% ============================================================
    subgraph success[Success States]
        REG_SUCCESS[Registration Success]
        REG_SUCCESS --> STATUS_SCREEN[Status Screen]
        STATUS_SCREEN --> LOGIN
    end

    %% ============================================================
    %% NAVIGATION LINKS
    %% ============================================================
    LOGIN -->|Sign Up| SIGNUP
    SIGNUP -->|Already have account| LOGIN
    LOGIN -->|Forgot Password| FORGOT_PWD

    %% ============================================================
    %% EXIT TO HOME
    %% ============================================================
    HOME([Home Screen])

    %% ============================================================
    %% STYLES
    %% ============================================================
    classDef entry fill:#4CAF50,stroke:#388E3C,color:#fff
    classDef screen fill:#2196F3,stroke:#1976D2,color:#fff
    classDef decision fill:#FF9800,stroke:#F57C00,color:#fff
    classDef action fill:#E3F2FD,stroke:#90CAF9,color:#333
    classDef error fill:#FFCDD2,stroke:#EF5350,color:#333
    classDef success fill:#C8E6C9,stroke:#66BB6A,color:#333
    classDef exit fill:#9C27B0,stroke:#7B1FA2,color:#fff

    class START,SPLASH entry
    class LOGIN,SIGNUP,UPLOAD_ID,OTP_VERIFY,FORGOT_PWD,PASSCODE_SETUP,PASSCODE_VERIFY screen
    class AUTH_CHECK,VALIDATE_LOGIN,VALIDATE_REG,PIN_MATCH,VERIFY_OTP,CHECK_PIN,PASSCODE_CHECK decision
    class INPUT_CREDS,REG_FORM,ENTER_PIN,CONFIRM_PIN,ENTER_OTP,ENTER_EMAIL,SELECT_DOC action
    class LOGIN_ERROR,REG_ERROR,PIN_ERROR,OTP_ERROR,RETRY_PIN error
    class REG_SUCCESS,STATUS_SCREEN,PWD_UPDATED,SAVE_PASSCODE success
    class HOME exit
