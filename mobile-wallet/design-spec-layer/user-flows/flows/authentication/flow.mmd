%% Flow: authentication
%% Version: 1.0
%% Created: 2026-03-18
%% Generated by: /flow-generate --from-features
%%
%% Features: auth, editpassword, profile, kyc
%% Screens: SplashScreen, LoginScreen, RegistrationScreen, PasscodeScreen,
%%          BiometricPrompt, HomeScreen, EditPasswordScreen, ProfileScreen,
%%          EditProfileScreen, KYCLevel1Screen, KYCLevel2Screen, DocumentUploadScreen,
%%          KYCStatusScreen, ForgotPasswordScreen, ErrorScreen
%% Entry Points: App Launch, Deep Link
%% Exit Points: Home Screen, Error

flowchart TD
    %% ──────────────────────────────────────
    %% Entry Points
    %% ──────────────────────────────────────
    ENTRY_APP([App Launch]):::entryPoint
    ENTRY_DEEP([Deep Link]):::entryPoint

    %% ──────────────────────────────────────
    %% Splash & Session Check
    %% ──────────────────────────────────────
    SPLASH[SplashScreen<br/>Loading...]:::screenLoading

    ENTRY_APP --> SPLASH
    ENTRY_DEEP --> SPLASH

    SPLASH --> CHECK_SESSION{Session token<br/>exists?}:::decision

    CHECK_SESSION -->|Yes| CHECK_TOKEN_VALID{Token still<br/>valid?}:::decision
    CHECK_SESSION -->|No| LOGIN

    CHECK_TOKEN_VALID -->|Valid| CHECK_BIOMETRIC{Biometric<br/>available?}:::decision
    CHECK_TOKEN_VALID -->|Expired| REFRESH_TOKEN[Refresh Token<br/>POST /oauth/token]:::apiCall

    REFRESH_TOKEN --> REFRESH_RESULT{Refresh<br/>succeeded?}:::decision
    REFRESH_RESULT -->|Yes| CHECK_BIOMETRIC
    REFRESH_RESULT -->|No| LOGIN

    %% ──────────────────────────────────────
    %% Biometric Authentication
    %% ──────────────────────────────────────
    CHECK_BIOMETRIC -->|Yes + Enabled| BIOMETRIC_PROMPT[BiometricPrompt<br/>Fingerprint / Face]:::screen
    CHECK_BIOMETRIC -->|No / Disabled| PASSCODE

    BIOMETRIC_PROMPT --> BIO_RESULT{Biometric<br/>result?}:::decision
    BIO_RESULT -->|Success| HOME
    BIO_RESULT -->|Failed / Retry| BIOMETRIC_PROMPT
    BIO_RESULT -->|Cancelled / Lockout| PASSCODE

    %% ──────────────────────────────────────
    %% Passcode Verification
    %% ──────────────────────────────────────
    PASSCODE[PasscodeScreen<br/>Enter 4-digit passcode]:::screen
    PASSCODE --> PASSCODE_RESULT{Passcode<br/>correct?}:::decision
    PASSCODE_RESULT -->|Yes| HOME
    PASSCODE_RESULT -->|No, attempts < 3| PASSCODE_ERROR[PasscodeScreen<br/>Invalid passcode]:::screenError
    PASSCODE_ERROR --> PASSCODE
    PASSCODE_RESULT -->|No, max attempts| FORCE_LOGOUT[Force Logout<br/>Clear session]:::actionNode
    FORCE_LOGOUT --> LOGIN

    %% ──────────────────────────────────────
    %% Login Flow
    %% ──────────────────────────────────────
    LOGIN[LoginScreen<br/>Username + Password]:::screen

    LOGIN -->|Submit| LOGIN_LOADING[LoginScreen<br/>Authenticating...]:::screenLoading
    LOGIN -->|Forgot Password| FORGOT_PASSWORD
    LOGIN -->|Create Account| REGISTER

    LOGIN_LOADING --> LOGIN_API[Fineract Auth<br/>POST /authentication]:::apiCall
    LOGIN_API --> LOGIN_RESULT{Auth<br/>response?}:::decision

    LOGIN_RESULT -->|200 OK| SAVE_TOKEN[Save Token<br/>+ Client ID]:::actionNode
    LOGIN_RESULT -->|401 Invalid| LOGIN_ERROR[LoginScreen<br/>Invalid credentials]:::screenError
    LOGIN_RESULT -->|Network Error| LOGIN_NET_ERROR[LoginScreen<br/>Network error - Retry]:::screenError

    LOGIN_ERROR --> LOGIN
    LOGIN_NET_ERROR -->|Retry| LOGIN_LOADING

    SAVE_TOKEN --> SETUP_PASSCODE{First login?<br/>Passcode set?}:::decision
    SETUP_PASSCODE -->|First login| CREATE_PASSCODE[PasscodeScreen<br/>Create passcode]:::screen
    SETUP_PASSCODE -->|Passcode exists| HOME

    CREATE_PASSCODE --> CONFIRM_PASSCODE[PasscodeScreen<br/>Confirm passcode]:::screen
    CONFIRM_PASSCODE --> PASSCODE_MATCH{Passcodes<br/>match?}:::decision
    PASSCODE_MATCH -->|Yes| SETUP_BIO{Offer biometric<br/>setup?}:::decision
    PASSCODE_MATCH -->|No| CREATE_PASSCODE

    SETUP_BIO -->|Yes, device supports| ENABLE_BIO[Enable Biometric<br/>Auth]:::actionNode
    SETUP_BIO -->|No / Skip| HOME
    ENABLE_BIO --> HOME

    %% ──────────────────────────────────────
    %% Registration Flow
    %% ──────────────────────────────────────
    REGISTER[RegistrationScreen<br/>Step 1: Personal Info]:::screen
    REGISTER --> REG_VALIDATE_1{Fields<br/>valid?}:::decision
    REG_VALIDATE_1 -->|No| REG_ERROR_1[RegistrationScreen<br/>Validation errors]:::screenError
    REG_ERROR_1 --> REGISTER
    REG_VALIDATE_1 -->|Yes| REG_STEP2[RegistrationScreen<br/>Step 2: Account Details]:::screen

    REG_STEP2 --> REG_VALIDATE_2{Fields<br/>valid?}:::decision
    REG_VALIDATE_2 -->|No| REG_ERROR_2[RegistrationScreen<br/>Validation errors]:::screenError
    REG_ERROR_2 --> REG_STEP2
    REG_VALIDATE_2 -->|Yes| REG_LOADING[RegistrationScreen<br/>Creating account...]:::screenLoading

    REG_LOADING --> REG_API[Fineract Register<br/>POST /registration]:::apiCall
    REG_API --> REG_RESULT{Registration<br/>response?}:::decision

    REG_RESULT -->|Success| REG_VERIFY[RegistrationScreen<br/>Verify email / OTP]:::screen
    REG_RESULT -->|409 Duplicate| REG_DUP_ERROR[RegistrationScreen<br/>Account already exists]:::screenError
    REG_RESULT -->|Network Error| REG_NET_ERROR[RegistrationScreen<br/>Network error - Retry]:::screenError

    REG_DUP_ERROR --> REGISTER
    REG_NET_ERROR -->|Retry| REG_LOADING

    REG_VERIFY --> REG_VERIFY_API[Verify Registration<br/>POST /registration/verify]:::apiCall
    REG_VERIFY_API --> REG_VERIFY_RESULT{Verification<br/>result?}:::decision
    REG_VERIFY_RESULT -->|Success| LOGIN
    REG_VERIFY_RESULT -->|Invalid code| REG_VERIFY_ERROR[RegistrationScreen<br/>Invalid code - Retry]:::screenError
    REG_VERIFY_ERROR --> REG_VERIFY

    %% ──────────────────────────────────────
    %% Forgot Password Flow
    %% ──────────────────────────────────────
    FORGOT_PASSWORD[ForgotPasswordScreen<br/>Enter email]:::screen
    FORGOT_PASSWORD --> FORGOT_SUBMIT[ForgotPasswordScreen<br/>Sending reset link...]:::screenLoading
    FORGOT_SUBMIT --> FORGOT_API[Password Reset<br/>POST /user/reset]:::apiCall
    FORGOT_API --> FORGOT_RESULT{Reset<br/>response?}:::decision
    FORGOT_RESULT -->|Success| FORGOT_SUCCESS[ForgotPasswordScreen<br/>Check your email]:::screenSuccess
    FORGOT_RESULT -->|404 Not found| FORGOT_NOT_FOUND[ForgotPasswordScreen<br/>Email not registered]:::screenError
    FORGOT_RESULT -->|Network Error| FORGOT_NET_ERROR[ForgotPasswordScreen<br/>Network error - Retry]:::screenError
    FORGOT_SUCCESS --> LOGIN
    FORGOT_NOT_FOUND --> FORGOT_PASSWORD
    FORGOT_NET_ERROR -->|Retry| FORGOT_SUBMIT

    %% ──────────────────────────────────────
    %% Home Screen (Exit Point / Hub)
    %% ──────────────────────────────────────
    HOME[HomeScreen<br/>Dashboard]:::exitPoint

    %% ──────────────────────────────────────
    %% Edit Password Flow (from Settings)
    %% ──────────────────────────────────────
    HOME -->|Settings > Change Password| EDIT_PASSWORD

    EDIT_PASSWORD[EditPasswordScreen<br/>Current + New + Confirm]:::screen
    EDIT_PASSWORD --> EDIT_PW_VALIDATE{Fields<br/>valid?}:::decision
    EDIT_PW_VALIDATE -->|No| EDIT_PW_VALIDATION_ERR[EditPasswordScreen<br/>Validation errors]:::screenError
    EDIT_PW_VALIDATION_ERR --> EDIT_PASSWORD
    EDIT_PW_VALIDATE -->|Yes| EDIT_PW_LOADING[EditPasswordScreen<br/>Updating...]:::screenLoading

    EDIT_PW_LOADING --> EDIT_PW_API[Change Password<br/>PUT /users/{userId}]:::apiCall
    EDIT_PW_API --> EDIT_PW_RESULT{Update<br/>response?}:::decision
    EDIT_PW_RESULT -->|Success| EDIT_PW_SUCCESS[EditPasswordScreen<br/>Password updated]:::screenSuccess
    EDIT_PW_RESULT -->|400 Wrong current| EDIT_PW_WRONG[EditPasswordScreen<br/>Current password incorrect]:::screenError
    EDIT_PW_RESULT -->|Network Error| EDIT_PW_NET_ERROR[EditPasswordScreen<br/>Network error - Retry]:::screenError

    EDIT_PW_SUCCESS --> HOME
    EDIT_PW_WRONG --> EDIT_PASSWORD
    EDIT_PW_NET_ERROR -->|Retry| EDIT_PW_LOADING

    %% ──────────────────────────────────────
    %% Profile Management Flow
    %% ──────────────────────────────────────
    HOME -->|Profile Tab / Avatar| PROFILE

    PROFILE[ProfileScreen<br/>View Profile]:::screen
    PROFILE --> PROFILE_LOADING[ProfileScreen<br/>Loading...]:::screenLoading
    PROFILE_LOADING --> PROFILE_API[Get Client<br/>GET /clients/{id}]:::apiCall
    PROFILE_API --> PROFILE_LOAD_RESULT{Load<br/>response?}:::decision
    PROFILE_LOAD_RESULT -->|Success| PROFILE_LOADED[ProfileScreen<br/>Profile Data]:::screenSuccess
    PROFILE_LOAD_RESULT -->|Error| PROFILE_LOAD_ERROR[ProfileScreen<br/>Failed to load - Retry]:::screenError
    PROFILE_LOAD_ERROR -->|Retry| PROFILE_LOADING

    PROFILE_LOADED -->|Edit| EDIT_PROFILE
    PROFILE_LOADED -->|Back| HOME

    EDIT_PROFILE[EditProfileScreen<br/>Edit personal info]:::screen
    EDIT_PROFILE --> EDIT_PROFILE_VALIDATE{Fields<br/>valid?}:::decision
    EDIT_PROFILE_VALIDATE -->|No| EDIT_PROFILE_VAL_ERR[EditProfileScreen<br/>Validation errors]:::screenError
    EDIT_PROFILE_VAL_ERR --> EDIT_PROFILE
    EDIT_PROFILE_VALIDATE -->|Yes| EDIT_PROFILE_LOADING[EditProfileScreen<br/>Saving...]:::screenLoading

    EDIT_PROFILE_LOADING --> EDIT_PROFILE_API[Update Client<br/>PUT /clients/{id}]:::apiCall
    EDIT_PROFILE_API --> EDIT_PROFILE_RESULT{Update<br/>response?}:::decision
    EDIT_PROFILE_RESULT -->|Success| EDIT_PROFILE_SUCCESS[EditProfileScreen<br/>Profile updated]:::screenSuccess
    EDIT_PROFILE_RESULT -->|Error| EDIT_PROFILE_ERROR[EditProfileScreen<br/>Update failed - Retry]:::screenError

    EDIT_PROFILE_SUCCESS --> PROFILE
    EDIT_PROFILE_ERROR -->|Retry| EDIT_PROFILE_LOADING

    %% ──────────────────────────────────────
    %% KYC Verification Flow
    %% ──────────────────────────────────────
    HOME -->|KYC Banner / Settings| KYC_CHECK

    KYC_CHECK{Current<br/>KYC level?}:::decision

    KYC_CHECK -->|None / Level 0| KYC_L1
    KYC_CHECK -->|Level 1| KYC_L2
    KYC_CHECK -->|Level 2 Pending| KYC_STATUS
    KYC_CHECK -->|Level 2 Verified| HOME

    %% KYC Level 1
    KYC_L1[KYCLevel1Screen<br/>Basic Identity Info]:::screen
    KYC_L1 --> KYC_L1_VALIDATE{Fields<br/>valid?}:::decision
    KYC_L1_VALIDATE -->|No| KYC_L1_VAL_ERR[KYCLevel1Screen<br/>Validation errors]:::screenError
    KYC_L1_VAL_ERR --> KYC_L1
    KYC_L1_VALIDATE -->|Yes| KYC_L1_LOADING[KYCLevel1Screen<br/>Submitting...]:::screenLoading

    KYC_L1_LOADING --> KYC_L1_API[Submit KYC L1<br/>POST /clients/{id}/identifiers]:::apiCall
    KYC_L1_API --> KYC_L1_RESULT{KYC L1<br/>response?}:::decision
    KYC_L1_RESULT -->|Success| KYC_L1_SUCCESS[KYCLevel1Screen<br/>Level 1 complete]:::screenSuccess
    KYC_L1_RESULT -->|Error| KYC_L1_ERROR[KYCLevel1Screen<br/>Submission failed - Retry]:::screenError
    KYC_L1_SUCCESS --> KYC_L2_PROMPT{Proceed to<br/>Level 2?}:::decision
    KYC_L1_ERROR -->|Retry| KYC_L1_LOADING

    KYC_L2_PROMPT -->|Yes| KYC_L2
    KYC_L2_PROMPT -->|Later| HOME

    %% KYC Level 2
    KYC_L2[KYCLevel2Screen<br/>Address + Employment]:::screen
    KYC_L2 --> KYC_L2_VALIDATE{Fields<br/>valid?}:::decision
    KYC_L2_VALIDATE -->|No| KYC_L2_VAL_ERR[KYCLevel2Screen<br/>Validation errors]:::screenError
    KYC_L2_VAL_ERR --> KYC_L2
    KYC_L2_VALIDATE -->|Yes| DOC_UPLOAD

    %% Document Upload
    DOC_UPLOAD[DocumentUploadScreen<br/>ID + Selfie + Proof]:::screen
    DOC_UPLOAD --> DOC_SELECT{Document<br/>type?}:::decision
    DOC_SELECT -->|Camera| DOC_CAMERA[Camera Capture]:::actionNode
    DOC_SELECT -->|Gallery| DOC_GALLERY[Gallery Pick]:::actionNode
    DOC_CAMERA --> DOC_PREVIEW[DocumentUploadScreen<br/>Preview + Confirm]:::screen
    DOC_GALLERY --> DOC_PREVIEW

    DOC_PREVIEW --> DOC_UPLOAD_ALL{All docs<br/>uploaded?}:::decision
    DOC_UPLOAD_ALL -->|No, more needed| DOC_UPLOAD
    DOC_UPLOAD_ALL -->|Yes| KYC_L2_SUBMIT

    KYC_L2_SUBMIT[KYCLevel2Screen<br/>Submitting verification...]:::screenLoading
    KYC_L2_SUBMIT --> KYC_L2_API[Submit KYC L2<br/>POST /clients/{id}/documents]:::apiCall
    KYC_L2_API --> KYC_L2_RESULT{KYC L2<br/>response?}:::decision
    KYC_L2_RESULT -->|Success| KYC_STATUS
    KYC_L2_RESULT -->|Error| KYC_L2_ERROR[KYCLevel2Screen<br/>Upload failed - Retry]:::screenError
    KYC_L2_ERROR -->|Retry| KYC_L2_SUBMIT

    %% KYC Status
    KYC_STATUS[KYCStatusScreen<br/>Verification pending]:::screen
    KYC_STATUS --> KYC_STATUS_CHECK{Verification<br/>status?}:::decision
    KYC_STATUS_CHECK -->|Approved| KYC_APPROVED[KYCStatusScreen<br/>Verified - Level 2]:::screenSuccess
    KYC_STATUS_CHECK -->|Rejected| KYC_REJECTED[KYCStatusScreen<br/>Rejected - Resubmit]:::screenError
    KYC_STATUS_CHECK -->|Pending| KYC_STATUS

    KYC_APPROVED --> HOME
    KYC_REJECTED -->|Resubmit| KYC_L2

    %% ──────────────────────────────────────
    %% Logout Flow
    %% ──────────────────────────────────────
    HOME -->|Settings > Logout| LOGOUT_CONFIRM{Confirm<br/>logout?}:::decision
    LOGOUT_CONFIRM -->|Yes| LOGOUT[Clear Session<br/>+ Tokens]:::actionNode
    LOGOUT_CONFIRM -->|Cancel| HOME
    LOGOUT --> LOGIN

    %% ──────────────────────────────────────
    %% Global Error Screen
    %% ──────────────────────────────────────
    ERROR_SCREEN[ErrorScreen<br/>Something went wrong]:::errorExit

    %% ══════════════════════════════════════
    %% Style Classes
    %% ══════════════════════════════════════

    classDef entryPoint fill:#4CAF50,stroke:#2E7D32,color:#fff,stroke-width:2px
    classDef exitPoint fill:#2196F3,stroke:#1565C0,color:#fff,stroke-width:2px
    classDef screen fill:#E3F2FD,stroke:#1976D2,color:#1A237E,stroke-width:1px
    classDef screenLoading fill:#FFF9C4,stroke:#F9A825,color:#5D4037,stroke-width:1px
    classDef screenSuccess fill:#C8E6C9,stroke:#388E3C,color:#1B5E20,stroke-width:1px
    classDef screenError fill:#FFCDD2,stroke:#D32F2F,color:#B71C1C,stroke-width:1px
    classDef decision fill:#F3E5F5,stroke:#7B1FA2,color:#4A148C,stroke-width:1px
    classDef apiCall fill:#FFE0B2,stroke:#E65100,color:#BF360C,stroke-width:1px
    classDef actionNode fill:#B2DFDB,stroke:#00695C,color:#004D40,stroke-width:1px
    classDef errorExit fill:#F44336,stroke:#B71C1C,color:#fff,stroke-width:2px
