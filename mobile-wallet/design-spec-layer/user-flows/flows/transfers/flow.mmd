%% Flow: transfers
%% Version: 1.0
%% Created: 2026-03-18
%% Generated by: /flow-generate --from-features
%%
%% Features: transfer-interbank, transfer-intrabank, beneficiary, standing-instruction
%% Screens: TransferHub, IntraBankTransfer, InterBankTransfer, BeneficiaryList, AddBeneficiary,
%%          EditBeneficiary, StandingInstructionList, CreateStandingInstruction,
%%          TransferConfirmation, OTPVerification, TransferReceipt, TransferHistory
%% Entry Points: Home Quick Action, Accounts Detail, Bottom Nav
%% Exit Points: Transfer Receipt, Home Screen

flowchart TD
    %% ============================================================
    %% ENTRY POINTS
    %% ============================================================
    EP_HOME["Home Screen<br/>Quick Action: Transfer"]
    EP_ACCOUNT["Account Detail<br/>Action: Send Money"]
    EP_NAV["Bottom Nav<br/>Transfers Tab"]

    EP_HOME --> TRANSFER_HUB
    EP_ACCOUNT --> TRANSFER_HUB
    EP_NAV --> TRANSFER_HUB

    %% ============================================================
    %% TRANSFER HUB (Main Landing)
    %% ============================================================
    TRANSFER_HUB["TransferHub Screen<br/>─────────────────<br/>P2P Transfer | Bank Transfer<br/>Beneficiaries | Standing Instructions<br/>Recent Transfers"]

    TRANSFER_HUB --> SELECT_TYPE{User selects<br/>transfer type?}
    TRANSFER_HUB --> NAV_BENEFICIARY["Manage Beneficiaries"]
    TRANSFER_HUB --> NAV_STANDING["Standing Instructions"]
    TRANSFER_HUB --> NAV_HISTORY["Transfer History"]

    SELECT_TYPE -->|"P2P / Same Bank"| INTRA_FLOW
    SELECT_TYPE -->|"Bank Transfer / Other Bank"| INTER_FLOW

    %% ============================================================
    %% INTRABANK TRANSFER (P2P - Same Bank)
    %% ============================================================
    subgraph INTRA["Intrabank Transfer (P2P)"]
        INTRA_FLOW["IntraBankTransfer Screen<br/>─────────────────<br/>From Account (dropdown)<br/>To Account / Beneficiary<br/>Amount | Note"]

        INTRA_FLOW --> INTRA_LOADING_ACCOUNTS["Loading...<br/>GET /savingsaccounts<br/>GET /beneficiaries/tpt"]
        INTRA_LOADING_ACCOUNTS --> INTRA_LOAD_CHECK{API<br/>success?}
        INTRA_LOAD_CHECK -->|"Error"| INTRA_LOAD_ERROR["Error State<br/>Failed to load accounts<br/>[Retry]"]
        INTRA_LOAD_ERROR --> INTRA_LOADING_ACCOUNTS
        INTRA_LOAD_CHECK -->|"Success"| INTRA_FORM_READY["Form Ready<br/>─────────────────<br/>Select source account<br/>Enter recipient account/ID<br/>or pick from beneficiary list"]

        INTRA_FORM_READY --> INTRA_PICK_BENEFICIARY{Use saved<br/>beneficiary?}
        INTRA_PICK_BENEFICIARY -->|"Yes"| INTRA_SELECT_BENEFICIARY["Select Beneficiary<br/>from saved list"]
        INTRA_PICK_BENEFICIARY -->|"No"| INTRA_MANUAL_ENTRY["Enter Account ID<br/>manually"]
        INTRA_SELECT_BENEFICIARY --> INTRA_ENTER_AMOUNT
        INTRA_MANUAL_ENTRY --> INTRA_ENTER_AMOUNT

        INTRA_ENTER_AMOUNT["Enter Amount & Note"]
        INTRA_ENTER_AMOUNT --> INTRA_VALIDATE{Validate<br/>input fields}
        INTRA_VALIDATE -->|"Empty/Invalid fields"| INTRA_VALIDATION_ERROR["Validation Error<br/>─────────────────<br/>- Amount required<br/>- Invalid account<br/>- Amount must be > 0"]
        INTRA_VALIDATION_ERROR --> INTRA_ENTER_AMOUNT
        INTRA_VALIDATE -->|"Valid"| INTRA_CHECK_BALANCE{Sufficient<br/>balance?}

        INTRA_CHECK_BALANCE -->|"No"| INTRA_INSUFFICIENT["Error State<br/>Insufficient Balance<br/>Available: $X.XX<br/>[Edit Amount] [Cancel]"]
        INTRA_INSUFFICIENT -->|"Edit"| INTRA_ENTER_AMOUNT
        INTRA_INSUFFICIENT -->|"Cancel"| TRANSFER_HUB
        INTRA_CHECK_BALANCE -->|"Yes"| CONFIRM_SCREEN
    end

    %% ============================================================
    %% INTERBANK TRANSFER (Different Bank)
    %% ============================================================
    subgraph INTER["Interbank Transfer (Bank Transfer)"]
        INTER_FLOW["InterBankTransfer Screen<br/>─────────────────<br/>From Account (dropdown)<br/>Bank Selection<br/>Recipient Details<br/>Amount | IFSC/Routing | Note"]

        INTER_FLOW --> INTER_LOADING["Loading...<br/>GET /savingsaccounts<br/>GET /beneficiaries/tpt<br/>GET /interoperation/banks"]
        INTER_LOADING --> INTER_LOAD_CHECK{API<br/>success?}
        INTER_LOAD_CHECK -->|"Error"| INTER_LOAD_ERROR["Error State<br/>Failed to load data<br/>[Retry]"]
        INTER_LOAD_ERROR --> INTER_LOADING
        INTER_LOAD_CHECK -->|"Success"| INTER_FORM_READY["Form Ready<br/>─────────────────<br/>Select source account<br/>Select destination bank<br/>Enter recipient details"]

        INTER_FORM_READY --> INTER_PICK_BENEFICIARY{Use saved<br/>beneficiary?}
        INTER_PICK_BENEFICIARY -->|"Yes"| INTER_SELECT_BENEFICIARY["Select Beneficiary<br/>from saved list<br/>(auto-fills bank + account)"]
        INTER_PICK_BENEFICIARY -->|"No"| INTER_MANUAL_ENTRY["Enter Details Manually<br/>─────────────────<br/>Bank name / IFSC code<br/>Account number<br/>Account holder name"]
        INTER_SELECT_BENEFICIARY --> INTER_ENTER_AMOUNT
        INTER_MANUAL_ENTRY --> INTER_ENTER_AMOUNT

        INTER_ENTER_AMOUNT["Enter Amount & Note"]
        INTER_ENTER_AMOUNT --> INTER_VALIDATE{Validate<br/>input fields}
        INTER_VALIDATE -->|"Empty/Invalid"| INTER_VALIDATION_ERROR["Validation Error<br/>─────────────────<br/>- Bank required<br/>- IFSC/Routing invalid<br/>- Account number required<br/>- Amount must be > 0"]
        INTER_VALIDATION_ERROR --> INTER_ENTER_AMOUNT
        INTER_VALIDATE -->|"Valid"| INTER_CHECK_BALANCE{Sufficient<br/>balance?}

        INTER_CHECK_BALANCE -->|"No"| INTER_INSUFFICIENT["Error State<br/>Insufficient Balance<br/>Available: $X.XX<br/>[Edit Amount] [Cancel]"]
        INTER_INSUFFICIENT -->|"Edit"| INTER_ENTER_AMOUNT
        INTER_INSUFFICIENT -->|"Cancel"| TRANSFER_HUB
        INTER_CHECK_BALANCE -->|"Yes"| CONFIRM_SCREEN
    end

    %% ============================================================
    %% TRANSFER CONFIRMATION & OTP/PIN
    %% ============================================================
    subgraph CONFIRM["Transfer Confirmation & Verification"]
        CONFIRM_SCREEN["Confirmation Screen<br/>─────────────────<br/>From: Account X<br/>To: Account Y / Bank Z<br/>Amount: $XX.XX<br/>Fee: $X.XX<br/>Total: $XX.XX<br/>Transfer Date<br/>[Confirm] [Edit] [Cancel]"]

        CONFIRM_SCREEN --> CONFIRM_ACTION{User action?}
        CONFIRM_ACTION -->|"Edit"| EDIT_BACK["Back to Transfer Form"]
        CONFIRM_ACTION -->|"Cancel"| CANCEL_DIALOG["Cancel Dialog<br/>Are you sure?<br/>[Yes, Cancel] [No, Continue]"]
        CONFIRM_ACTION -->|"Confirm"| OTP_CHECK{OTP/PIN<br/>required?}

        CANCEL_DIALOG -->|"Yes"| TRANSFER_HUB
        CANCEL_DIALOG -->|"No"| CONFIRM_SCREEN

        OTP_CHECK -->|"Yes"| OTP_SCREEN["OTP / PIN Verification<br/>─────────────────<br/>Enter 6-digit OTP<br/>sent to +XX XXXX XXXX<br/>or Enter PIN<br/>[Verify] [Resend OTP]"]
        OTP_CHECK -->|"No (low value)"| SUBMIT_TRANSFER

        OTP_SCREEN --> OTP_VERIFY{OTP/PIN<br/>verified?}
        OTP_VERIFY -->|"Invalid"| OTP_ERROR["Error: Invalid OTP/PIN<br/>Attempts remaining: X<br/>[Try Again] [Resend]"]
        OTP_ERROR --> OTP_RETRY{Attempts<br/>exhausted?}
        OTP_RETRY -->|"No"| OTP_SCREEN
        OTP_RETRY -->|"Yes"| OTP_LOCKED["Account Locked<br/>Too many failed attempts<br/>Try again after 30 min<br/>[Go Home]"]
        OTP_LOCKED --> EXIT_HOME

        OTP_SCREEN --> OTP_RESEND["Resend OTP<br/>Loading..."]
        OTP_RESEND --> OTP_RESEND_CHECK{Resend<br/>success?}
        OTP_RESEND_CHECK -->|"Success"| OTP_SCREEN
        OTP_RESEND_CHECK -->|"Error"| OTP_RESEND_ERROR["Failed to resend OTP<br/>[Retry]"]
        OTP_RESEND_ERROR --> OTP_SCREEN

        OTP_VERIFY -->|"Valid"| SUBMIT_TRANSFER

        SUBMIT_TRANSFER["Submitting Transfer...<br/>POST /savingsaccounts/{id}<br/>/transactions<br/>or POST /interoperation<br/>/transfers"]
        SUBMIT_TRANSFER --> SUBMIT_CHECK{API<br/>response?}
        SUBMIT_CHECK -->|"Success"| SAVE_BENEFICIARY_PROMPT
        SUBMIT_CHECK -->|"Error - Network"| SUBMIT_NETWORK_ERROR["Network Error<br/>Transfer may not have<br/>been processed<br/>[Retry] [Check Status]"]
        SUBMIT_CHECK -->|"Error - Server"| SUBMIT_SERVER_ERROR["Server Error<br/>Transfer failed<br/>Reason: {error_message}<br/>[Try Again] [Cancel]"]
        SUBMIT_NETWORK_ERROR -->|"Retry"| SUBMIT_TRANSFER
        SUBMIT_NETWORK_ERROR -->|"Check Status"| NAV_HISTORY
        SUBMIT_SERVER_ERROR -->|"Try Again"| CONFIRM_SCREEN
        SUBMIT_SERVER_ERROR -->|"Cancel"| TRANSFER_HUB
    end

    EDIT_BACK -->|"Intrabank"| INTRA_ENTER_AMOUNT
    EDIT_BACK -->|"Interbank"| INTER_ENTER_AMOUNT

    %% ============================================================
    %% POST-TRANSFER: SAVE BENEFICIARY PROMPT
    %% ============================================================
    SAVE_BENEFICIARY_PROMPT{Beneficiary<br/>already saved?}
    SAVE_BENEFICIARY_PROMPT -->|"Yes"| RECEIPT_SCREEN
    SAVE_BENEFICIARY_PROMPT -->|"No"| SAVE_BENEFICIARY_DIALOG["Save as Beneficiary?<br/>Name: {recipient}<br/>[Save] [Skip]"]
    SAVE_BENEFICIARY_DIALOG -->|"Save"| SAVE_BENEFICIARY_API["Saving...<br/>POST /beneficiaries/tpt"]
    SAVE_BENEFICIARY_API --> SAVE_BENE_CHECK{Save<br/>success?}
    SAVE_BENE_CHECK -->|"Success"| RECEIPT_SCREEN
    SAVE_BENE_CHECK -->|"Error"| SAVE_BENE_ERROR["Failed to save<br/>beneficiary<br/>[Retry] [Skip]"]
    SAVE_BENE_ERROR -->|"Retry"| SAVE_BENEFICIARY_API
    SAVE_BENE_ERROR -->|"Skip"| RECEIPT_SCREEN
    SAVE_BENEFICIARY_DIALOG -->|"Skip"| RECEIPT_SCREEN

    %% ============================================================
    %% TRANSFER RECEIPT / SUCCESS
    %% ============================================================
    RECEIPT_SCREEN["Transfer Receipt<br/>─────────────────<br/>Transfer Successful!<br/>Transaction ID: #XXXX<br/>From: Account X<br/>To: Account Y<br/>Amount: $XX.XX<br/>Date: YYYY-MM-DD HH:MM<br/>Status: Completed<br/>─────────────────<br/>[Share Receipt] [Download PDF]<br/>[Make Another Transfer]<br/>[Go Home]"]

    RECEIPT_SCREEN --> RECEIPT_ACTION{User action?}
    RECEIPT_ACTION -->|"Share"| SHARE_RECEIPT["Share via<br/>System Share Sheet"]
    RECEIPT_ACTION -->|"Download"| DOWNLOAD_RECEIPT["Download PDF Receipt"]
    RECEIPT_ACTION -->|"Another Transfer"| TRANSFER_HUB
    RECEIPT_ACTION -->|"Go Home"| EXIT_HOME
    SHARE_RECEIPT --> RECEIPT_SCREEN
    DOWNLOAD_RECEIPT --> RECEIPT_SCREEN

    %% ============================================================
    %% BENEFICIARY MANAGEMENT
    %% ============================================================
    subgraph BENEFICIARY["Beneficiary Management"]
        NAV_BENEFICIARY --> BENE_LIST_LOADING["Loading...<br/>GET /beneficiaries/tpt"]
        BENE_LIST_LOADING --> BENE_LOAD_CHECK{API<br/>success?}
        BENE_LOAD_CHECK -->|"Error"| BENE_LOAD_ERROR["Error State<br/>Failed to load beneficiaries<br/>[Retry]"]
        BENE_LOAD_ERROR --> BENE_LIST_LOADING
        BENE_LOAD_CHECK -->|"Success, empty"| BENE_EMPTY["Empty State<br/>No beneficiaries yet<br/>[Add Beneficiary]"]
        BENE_LOAD_CHECK -->|"Success, has data"| BENE_LIST["BeneficiaryList Screen<br/>─────────────────<br/>Search bar<br/>Beneficiary cards<br/>(Name, Account, Bank)<br/>[+Add] per item: [Edit] [Delete]"]

        BENE_EMPTY --> ADD_BENE
        BENE_LIST --> BENE_ACTION{User action?}
        BENE_ACTION -->|"Add"| ADD_BENE
        BENE_ACTION -->|"Edit"| EDIT_BENE
        BENE_ACTION -->|"Delete"| DELETE_BENE
        BENE_ACTION -->|"Select (for transfer)"| BENE_TO_TRANSFER["Route to Transfer<br/>with beneficiary pre-filled"]

        ADD_BENE["AddBeneficiary Screen<br/>─────────────────<br/>Name<br/>Account Number<br/>Transfer Limit<br/>Account Type (dropdown)<br/>[Save]"]
        ADD_BENE --> ADD_BENE_VALIDATE{Valid<br/>input?}
        ADD_BENE_VALIDATE -->|"Invalid"| ADD_BENE_VALIDATION_ERR["Validation Error<br/>- Name required<br/>- Account number required<br/>- Transfer limit required"]
        ADD_BENE_VALIDATION_ERR --> ADD_BENE
        ADD_BENE_VALIDATE -->|"Valid"| ADD_BENE_SUBMIT["Saving...<br/>POST /beneficiaries/tpt"]
        ADD_BENE_SUBMIT --> ADD_BENE_CHECK{API<br/>success?}
        ADD_BENE_CHECK -->|"Success"| ADD_BENE_SUCCESS["Beneficiary Added<br/>[OK]"]
        ADD_BENE_CHECK -->|"Error - Duplicate"| ADD_BENE_DUP_ERR["Error: Beneficiary<br/>already exists<br/>[Edit Existing] [Cancel]"]
        ADD_BENE_CHECK -->|"Error - Other"| ADD_BENE_ERR["Error: Failed to add<br/>{error_message}<br/>[Retry] [Cancel]"]
        ADD_BENE_SUCCESS --> BENE_LIST_LOADING
        ADD_BENE_DUP_ERR -->|"Edit"| EDIT_BENE
        ADD_BENE_DUP_ERR -->|"Cancel"| BENE_LIST
        ADD_BENE_ERR -->|"Retry"| ADD_BENE_SUBMIT
        ADD_BENE_ERR -->|"Cancel"| BENE_LIST

        EDIT_BENE["EditBeneficiary Screen<br/>─────────────────<br/>Name (pre-filled)<br/>Transfer Limit (editable)<br/>[Save Changes]"]
        EDIT_BENE --> EDIT_BENE_SUBMIT["Updating...<br/>PUT /beneficiaries/tpt/{id}"]
        EDIT_BENE_SUBMIT --> EDIT_BENE_CHECK{API<br/>success?}
        EDIT_BENE_CHECK -->|"Success"| EDIT_BENE_SUCCESS["Beneficiary Updated<br/>[OK]"]
        EDIT_BENE_CHECK -->|"Error"| EDIT_BENE_ERR["Error: Failed to update<br/>[Retry] [Cancel]"]
        EDIT_BENE_SUCCESS --> BENE_LIST_LOADING
        EDIT_BENE_ERR -->|"Retry"| EDIT_BENE_SUBMIT
        EDIT_BENE_ERR -->|"Cancel"| BENE_LIST

        DELETE_BENE["Delete Confirmation<br/>─────────────────<br/>Remove {name}?<br/>This cannot be undone<br/>[Delete] [Cancel]"]
        DELETE_BENE -->|"Cancel"| BENE_LIST
        DELETE_BENE -->|"Delete"| DELETE_BENE_SUBMIT["Deleting...<br/>DELETE /beneficiaries/tpt/{id}"]
        DELETE_BENE_SUBMIT --> DELETE_BENE_CHECK{API<br/>success?}
        DELETE_BENE_CHECK -->|"Success"| BENE_LIST_LOADING
        DELETE_BENE_CHECK -->|"Error"| DELETE_BENE_ERR["Error: Failed to delete<br/>[Retry] [Cancel]"]
        DELETE_BENE_ERR -->|"Retry"| DELETE_BENE_SUBMIT
        DELETE_BENE_ERR -->|"Cancel"| BENE_LIST
    end

    BENE_TO_TRANSFER -->|"Intrabank beneficiary"| INTRA_FORM_READY
    BENE_TO_TRANSFER -->|"Interbank beneficiary"| INTER_FORM_READY

    %% ============================================================
    %% STANDING INSTRUCTIONS
    %% ============================================================
    subgraph STANDING["Standing Instructions (Recurring Transfers)"]
        NAV_STANDING --> SI_LIST_LOADING["Loading...<br/>GET /standinginstructions<br/>?clientId={id}"]
        SI_LIST_LOADING --> SI_LOAD_CHECK{API<br/>success?}
        SI_LOAD_CHECK -->|"Error"| SI_LOAD_ERROR["Error State<br/>Failed to load instructions<br/>[Retry]"]
        SI_LOAD_ERROR --> SI_LIST_LOADING
        SI_LOAD_CHECK -->|"Success, empty"| SI_EMPTY["Empty State<br/>No standing instructions<br/>Set up recurring transfers<br/>[Create New]"]
        SI_LOAD_CHECK -->|"Success, has data"| SI_LIST["StandingInstructionList<br/>─────────────────<br/>Active / Paused / Completed tabs<br/>Instruction cards:<br/>(From, To, Amount, Frequency,<br/>Next Execution, Status)<br/>[+Create New]"]

        SI_EMPTY --> CREATE_SI
        SI_LIST --> SI_ACTION{User action?}
        SI_ACTION -->|"Create"| CREATE_SI
        SI_ACTION -->|"View Detail"| SI_DETAIL
        SI_ACTION -->|"Pause/Resume"| SI_TOGGLE
        SI_ACTION -->|"Delete"| SI_DELETE

        CREATE_SI["CreateStandingInstruction<br/>─────────────────<br/>From Account (dropdown)<br/>To Account / Beneficiary<br/>Amount<br/>Frequency: Weekly/Monthly/Quarterly<br/>Start Date<br/>End Date (optional)<br/>Instruction Name<br/>[Create]"]
        CREATE_SI --> CREATE_SI_VALIDATE{Valid<br/>input?}
        CREATE_SI_VALIDATE -->|"Invalid"| CREATE_SI_VALIDATION_ERR["Validation Error<br/>- Accounts required<br/>- Amount must be > 0<br/>- Start date must be future<br/>- End date must be after start"]
        CREATE_SI_VALIDATION_ERR --> CREATE_SI
        CREATE_SI_VALIDATE -->|"Valid"| CREATE_SI_CONFIRM["Confirm Instruction<br/>─────────────────<br/>Review all details<br/>Frequency summary<br/>Estimated total (if end date)<br/>[Confirm] [Edit]"]
        CREATE_SI_CONFIRM -->|"Edit"| CREATE_SI
        CREATE_SI_CONFIRM -->|"Confirm"| CREATE_SI_SUBMIT["Creating...<br/>POST /standinginstructions"]
        CREATE_SI_SUBMIT --> CREATE_SI_CHECK{API<br/>success?}
        CREATE_SI_CHECK -->|"Success"| CREATE_SI_SUCCESS["Standing Instruction Created<br/>Next execution: {date}<br/>[View Instructions] [Home]"]
        CREATE_SI_CHECK -->|"Error"| CREATE_SI_ERR["Error: Failed to create<br/>{error_message}<br/>[Retry] [Cancel]"]
        CREATE_SI_SUCCESS -->|"View"| SI_LIST_LOADING
        CREATE_SI_SUCCESS -->|"Home"| EXIT_HOME
        CREATE_SI_ERR -->|"Retry"| CREATE_SI_SUBMIT
        CREATE_SI_ERR -->|"Cancel"| SI_LIST

        SI_DETAIL["Instruction Detail<br/>─────────────────<br/>All instruction details<br/>Execution history list<br/>Next execution date<br/>Status badge<br/>[Edit] [Pause] [Delete]"]
        SI_DETAIL --> SI_DETAIL_ACTION{User action?}
        SI_DETAIL_ACTION -->|"Edit"| EDIT_SI["Edit Instruction<br/>─────────────────<br/>Amount (editable)<br/>Frequency (editable)<br/>End Date (editable)<br/>[Save]"]
        SI_DETAIL_ACTION -->|"Pause/Resume"| SI_TOGGLE
        SI_DETAIL_ACTION -->|"Delete"| SI_DELETE

        EDIT_SI --> EDIT_SI_SUBMIT["Updating...<br/>PUT /standinginstructions/{id}"]
        EDIT_SI_SUBMIT --> EDIT_SI_CHECK{API<br/>success?}
        EDIT_SI_CHECK -->|"Success"| SI_LIST_LOADING
        EDIT_SI_CHECK -->|"Error"| EDIT_SI_ERR["Error: Failed to update<br/>[Retry] [Cancel]"]
        EDIT_SI_ERR -->|"Retry"| EDIT_SI_SUBMIT
        EDIT_SI_ERR -->|"Cancel"| SI_DETAIL

        SI_TOGGLE["Toggle Status<br/>─────────────────<br/>Pause/Resume instruction?<br/>[Confirm] [Cancel]"]
        SI_TOGGLE -->|"Cancel"| SI_LIST
        SI_TOGGLE -->|"Confirm"| SI_TOGGLE_SUBMIT["Updating status...<br/>PUT /standinginstructions/{id}<br/>?command=update"]
        SI_TOGGLE_SUBMIT --> SI_TOGGLE_CHECK{API<br/>success?}
        SI_TOGGLE_CHECK -->|"Success"| SI_LIST_LOADING
        SI_TOGGLE_CHECK -->|"Error"| SI_TOGGLE_ERR["Error: Failed to update<br/>[Retry]"]
        SI_TOGGLE_ERR --> SI_LIST

        SI_DELETE["Delete Confirmation<br/>─────────────────<br/>Delete this instruction?<br/>Remaining executions will<br/>be cancelled<br/>[Delete] [Cancel]"]
        SI_DELETE -->|"Cancel"| SI_LIST
        SI_DELETE -->|"Delete"| SI_DELETE_SUBMIT["Deleting...<br/>DELETE /standinginstructions/{id}"]
        SI_DELETE_SUBMIT --> SI_DELETE_CHECK{API<br/>success?}
        SI_DELETE_CHECK -->|"Success"| SI_LIST_LOADING
        SI_DELETE_CHECK -->|"Error"| SI_DELETE_ERR["Error: Failed to delete<br/>[Retry] [Cancel]"]
        SI_DELETE_ERR -->|"Retry"| SI_DELETE_SUBMIT
        SI_DELETE_ERR -->|"Cancel"| SI_LIST
    end

    %% ============================================================
    %% TRANSFER HISTORY
    %% ============================================================
    subgraph HISTORY["Transfer History"]
        NAV_HISTORY --> HISTORY_LOADING["Loading...<br/>GET /savingsaccounts/{id}<br/>/transactions<br/>?limit=20&offset=0"]
        HISTORY_LOADING --> HISTORY_LOAD_CHECK{API<br/>success?}
        HISTORY_LOAD_CHECK -->|"Error"| HISTORY_LOAD_ERROR["Error State<br/>Failed to load history<br/>[Retry]"]
        HISTORY_LOAD_ERROR --> HISTORY_LOADING
        HISTORY_LOAD_CHECK -->|"Success, empty"| HISTORY_EMPTY["Empty State<br/>No transfers yet<br/>[Make a Transfer]"]
        HISTORY_LOAD_CHECK -->|"Success"| HISTORY_LIST["TransferHistory Screen<br/>─────────────────<br/>Account selector (dropdown)<br/>Date range filter<br/>Type filter: All/Sent/Received<br/>─────────────────<br/>Transaction cards:<br/>(Date, Recipient/Sender,<br/>Amount, Status, Type)<br/>─────────────────<br/>Pull to refresh<br/>Infinite scroll pagination"]

        HISTORY_EMPTY --> TRANSFER_HUB
        HISTORY_LIST --> HISTORY_ACTION{User action?}
        HISTORY_ACTION -->|"Filter/Search"| HISTORY_FILTER["Apply Filters<br/>Re-fetch with params"]
        HISTORY_ACTION -->|"View Detail"| HISTORY_DETAIL["Transaction Detail<br/>─────────────────<br/>Transaction ID<br/>Type (P2P/Interbank)<br/>From / To details<br/>Amount / Fee<br/>Date & Time<br/>Status<br/>Reference note<br/>[Repeat Transfer]<br/>[Share Receipt]"]
        HISTORY_ACTION -->|"Load More"| HISTORY_PAGINATE["Loading more...<br/>GET ...?offset={next}"]

        HISTORY_FILTER --> HISTORY_LOADING
        HISTORY_PAGINATE --> HISTORY_LIST
        HISTORY_DETAIL --> HISTORY_DETAIL_ACTION{User action?}
        HISTORY_DETAIL_ACTION -->|"Repeat"| TRANSFER_HUB
        HISTORY_DETAIL_ACTION -->|"Share"| SHARE_RECEIPT_HIST["Share via<br/>System Share Sheet"]
        SHARE_RECEIPT_HIST --> HISTORY_DETAIL
        HISTORY_DETAIL_ACTION -->|"Back"| HISTORY_LIST
    end

    %% ============================================================
    %% EXIT POINTS
    %% ============================================================
    EXIT_HOME["Home Screen"]

    %% ============================================================
    %% STYLING
    %% ============================================================
    classDef entryPoint fill:#4CAF50,stroke:#2E7D32,color:#fff
    classDef exitPoint fill:#2196F3,stroke:#1565C0,color:#fff
    classDef screen fill:#fff,stroke:#333,color:#000
    classDef decision fill:#FFF9C4,stroke:#F9A825,color:#000
    classDef error fill:#FFCDD2,stroke:#C62828,color:#000
    classDef loading fill:#E3F2FD,stroke:#1565C0,color:#000
    classDef success fill:#C8E6C9,stroke:#2E7D32,color:#000
    classDef dialog fill:#F3E5F5,stroke:#7B1FA2,color:#000

    class EP_HOME,EP_ACCOUNT,EP_NAV entryPoint
    class EXIT_HOME exitPoint
    class TRANSFER_HUB,INTRA_FLOW,INTER_FLOW,INTRA_FORM_READY,INTER_FORM_READY,BENE_LIST,ADD_BENE,EDIT_BENE,SI_LIST,CREATE_SI,SI_DETAIL,EDIT_SI,HISTORY_LIST,HISTORY_DETAIL,INTRA_ENTER_AMOUNT,INTER_ENTER_AMOUNT,CONFIRM_SCREEN,OTP_SCREEN,RECEIPT_SCREEN screen
    class SELECT_TYPE,INTRA_LOAD_CHECK,INTRA_PICK_BENEFICIARY,INTRA_VALIDATE,INTRA_CHECK_BALANCE,INTER_LOAD_CHECK,INTER_PICK_BENEFICIARY,INTER_VALIDATE,INTER_CHECK_BALANCE,CONFIRM_ACTION,OTP_CHECK,OTP_VERIFY,OTP_RETRY,SUBMIT_CHECK,SAVE_BENEFICIARY_PROMPT,RECEIPT_ACTION,BENE_LOAD_CHECK,BENE_ACTION,ADD_BENE_VALIDATE,ADD_BENE_CHECK,EDIT_BENE_CHECK,DELETE_BENE_CHECK,SI_LOAD_CHECK,SI_ACTION,CREATE_SI_VALIDATE,CREATE_SI_CHECK,SI_DETAIL_ACTION,EDIT_SI_CHECK,SI_TOGGLE_CHECK,SI_DELETE_CHECK,HISTORY_LOAD_CHECK,HISTORY_ACTION,HISTORY_DETAIL_ACTION,OTP_RESEND_CHECK decision
    class INTRA_LOAD_ERROR,INTRA_VALIDATION_ERROR,INTRA_INSUFFICIENT,INTER_LOAD_ERROR,INTER_VALIDATION_ERROR,INTER_INSUFFICIENT,SUBMIT_NETWORK_ERROR,SUBMIT_SERVER_ERROR,OTP_ERROR,OTP_LOCKED,OTP_RESEND_ERROR,BENE_LOAD_ERROR,ADD_BENE_VALIDATION_ERR,ADD_BENE_DUP_ERR,ADD_BENE_ERR,EDIT_BENE_ERR,DELETE_BENE_ERR,SI_LOAD_ERROR,CREATE_SI_VALIDATION_ERR,CREATE_SI_ERR,EDIT_SI_ERR,SI_TOGGLE_ERR,SI_DELETE_ERR,HISTORY_LOAD_ERROR,SAVE_BENE_ERROR error
    class INTRA_LOADING_ACCOUNTS,INTER_LOADING,BENE_LIST_LOADING,SI_LIST_LOADING,HISTORY_LOADING,SUBMIT_TRANSFER,ADD_BENE_SUBMIT,EDIT_BENE_SUBMIT,DELETE_BENE_SUBMIT,CREATE_SI_SUBMIT,EDIT_SI_SUBMIT,SI_TOGGLE_SUBMIT,SI_DELETE_SUBMIT,HISTORY_PAGINATE,OTP_RESEND,SAVE_BENEFICIARY_API loading
    class CREATE_SI_SUCCESS,ADD_BENE_SUCCESS,EDIT_BENE_SUCCESS,CREATE_SI_CONFIRM success
    class CANCEL_DIALOG,DELETE_BENE,SI_DELETE,SI_TOGGLE,SAVE_BENEFICIARY_DIALOG dialog
    class BENE_EMPTY,SI_EMPTY,HISTORY_EMPTY screen
