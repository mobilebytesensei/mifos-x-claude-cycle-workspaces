%% Generated by: /flow-generate --from-features
%%
%% Features: invoices, savedcards, history, receipt
%% Screens: InvoiceListScreen, InvoiceDetailScreen, InvoicePayScreen,
%%          SavedCardsScreen, AddCardScreen, CardDetailScreen,
%%          TransactionHistoryScreen, HistoryFilterScreen, HistorySearchScreen,
%%          ReceiptDetailScreen, ReceiptShareScreen
%% Entry Points: Bottom Nav, Home Quick Action, Notification
%% Exit Points: Home Screen, Payment Flow

flowchart TD

    %% ============================================================
    %% ENTRY POINTS
    %% ============================================================
    ENTRY_NAV["Bottom Nav > Financial Services"]
    ENTRY_HOME["Home Quick Action"]
    ENTRY_NOTIF["Notification Tap"]

    ENTRY_NAV --> DOMAIN_HUB
    ENTRY_HOME --> DOMAIN_HUB
    ENTRY_NOTIF --> NOTIF_ROUTE{"Notification Type?"}

    NOTIF_ROUTE -->|Invoice Due| INVOICE_DETAIL_LOAD
    NOTIF_ROUTE -->|Payment Received| RECEIPT_DETAIL_LOAD
    NOTIF_ROUTE -->|Card Expiring| SAVED_CARDS_LOAD

    %% ============================================================
    %% DOMAIN HUB
    %% ============================================================
    DOMAIN_HUB{"Select Section"}
    DOMAIN_HUB -->|Invoices| INVOICE_LIST_LOAD
    DOMAIN_HUB -->|Saved Cards| SAVED_CARDS_LOAD
    DOMAIN_HUB -->|History| HISTORY_LOAD
    DOMAIN_HUB -->|Recent Receipt| RECEIPT_DETAIL_LOAD

    %% ============================================================
    %% INVOICES FLOW
    %% ============================================================
    subgraph INVOICES ["Invoices"]
        direction TB

        INVOICE_LIST_LOAD[/"Loading Invoice List
        (Shimmer)"/]
        INVOICE_LIST_LOAD --> INVOICE_FETCH{"Fetch Invoices
        GET /invoices"}
        INVOICE_FETCH -->|Success| INVOICE_HAS{"Has Invoices?"}
        INVOICE_FETCH -->|Error| INVOICE_LIST_ERROR["Error State
        Retry Button"]
        INVOICE_FETCH -->|Network Error| INVOICE_LIST_OFFLINE["Offline State
        Show Cached / Retry"]

        INVOICE_LIST_ERROR -->|Retry| INVOICE_LIST_LOAD
        INVOICE_LIST_OFFLINE -->|Retry| INVOICE_LIST_LOAD

        INVOICE_HAS -->|Yes| INVOICE_LIST["Invoice List Screen
        - Pending / Paid / Overdue tabs
        - Amount, Date, Status
        - Pull-to-Refresh"]
        INVOICE_HAS -->|No| INVOICE_EMPTY["Empty State
        No invoices found
        Illustration + Message"]

        INVOICE_LIST -->|Tap Invoice| INVOICE_DETAIL_LOAD
        INVOICE_LIST -->|Pull Refresh| INVOICE_LIST_LOAD

        INVOICE_DETAIL_LOAD[/"Loading Invoice Detail
        (Shimmer)"/]
        INVOICE_DETAIL_LOAD --> INVOICE_DETAIL_FETCH{"Fetch Invoice Detail
        GET /invoices/:id"}
        INVOICE_DETAIL_FETCH -->|Success| INVOICE_DETAIL["Invoice Detail Screen
        - Invoice Number
        - Line Items
        - Total Amount
        - Due Date
        - Status Badge"]
        INVOICE_DETAIL_FETCH -->|Error| INVOICE_DETAIL_ERROR["Error State
        Retry Button"]
        INVOICE_DETAIL_ERROR -->|Retry| INVOICE_DETAIL_LOAD

        INVOICE_DETAIL --> INVOICE_ACTION{"Invoice Action?"}
        INVOICE_ACTION -->|Pay Invoice| INVOICE_PAY_CHECK{"Invoice Status?"}
        INVOICE_ACTION -->|Share| INVOICE_SHARE["Share Invoice
        PDF / Link"]
        INVOICE_ACTION -->|Back| INVOICE_LIST

        INVOICE_PAY_CHECK -->|Unpaid / Overdue| INVOICE_PAY["Pay Invoice Screen
        - Select Payment Method
        - Saved Cards List
        - Amount (pre-filled)
        - Confirm Button"]
        INVOICE_PAY_CHECK -->|Already Paid| INVOICE_PAID_MSG["Already Paid
        Toast Message"]
        INVOICE_PAID_MSG --> INVOICE_DETAIL

        INVOICE_PAY --> INVOICE_PAY_CONFIRM{"Confirm Payment?"}
        INVOICE_PAY_CONFIRM -->|Yes| INVOICE_PAY_PROCESS[/"Processing Payment
        (Spinner)"/]
        INVOICE_PAY_CONFIRM -->|Cancel| INVOICE_DETAIL

        INVOICE_PAY_PROCESS --> INVOICE_PAY_RESULT{"Payment Result
        POST /invoices/:id/pay"}
        INVOICE_PAY_RESULT -->|Success| INVOICE_PAY_SUCCESS["Payment Success
        - Confirmation
        - Receipt Link"]
        INVOICE_PAY_RESULT -->|Failure| INVOICE_PAY_FAIL["Payment Failed
        - Error Message
        - Retry / Cancel"]

        INVOICE_PAY_SUCCESS -->|View Receipt| RECEIPT_DETAIL_LOAD
        INVOICE_PAY_SUCCESS -->|Done| INVOICE_LIST_LOAD
        INVOICE_PAY_FAIL -->|Retry| INVOICE_PAY_PROCESS
        INVOICE_PAY_FAIL -->|Cancel| INVOICE_DETAIL

        INVOICE_SHARE --> INVOICE_DETAIL
    end

    %% ============================================================
    %% SAVED CARDS FLOW
    %% ============================================================
    subgraph SAVEDCARDS ["Saved Cards"]
        direction TB

        SAVED_CARDS_LOAD[/"Loading Saved Cards
        (Shimmer)"/]
        SAVED_CARDS_LOAD --> CARDS_FETCH{"Fetch Cards
        GET /savedcards"}
        CARDS_FETCH -->|Success| CARDS_HAS{"Has Saved Cards?"}
        CARDS_FETCH -->|Error| CARDS_ERROR["Error State
        Retry Button"]
        CARDS_FETCH -->|Network Error| CARDS_OFFLINE["Offline State
        Show Cached / Retry"]

        CARDS_ERROR -->|Retry| SAVED_CARDS_LOAD
        CARDS_OFFLINE -->|Retry| SAVED_CARDS_LOAD

        CARDS_HAS -->|Yes| CARDS_LIST["Saved Cards Screen
        - Card Brand Icon
        - Masked Number (****1234)
        - Expiry Date
        - Default Badge
        - Add Card FAB"]
        CARDS_HAS -->|No| CARDS_EMPTY["Empty State
        No saved cards
        Add Card Button"]

        CARDS_EMPTY -->|Add Card| ADD_CARD
        CARDS_LIST -->|Tap Card| CARD_DETAIL
        CARDS_LIST -->|Add Card FAB| ADD_CARD
        CARDS_LIST -->|Pull Refresh| SAVED_CARDS_LOAD

        %% Add Card
        ADD_CARD["Add Card Screen
        - Card Number (masked input)
        - Expiry Date (MM/YY)
        - CVV (masked)
        - Cardholder Name
        - Set as Default toggle"]
        ADD_CARD --> ADD_CARD_VALIDATE{"Card Validation?"}
        ADD_CARD_VALIDATE -->|Invalid| ADD_CARD_FIELD_ERROR["Field Errors
        - Invalid number
        - Expired card
        - Missing fields"]
        ADD_CARD_FIELD_ERROR --> ADD_CARD
        ADD_CARD_VALIDATE -->|Valid| ADD_CARD_SUBMIT[/"Saving Card
        POST /savedcards
        (Spinner)"/]

        ADD_CARD_SUBMIT --> ADD_CARD_RESULT{"Save Result?"}
        ADD_CARD_RESULT -->|Success| ADD_CARD_SUCCESS["Card Added
        Success Toast"]
        ADD_CARD_RESULT -->|Duplicate| ADD_CARD_DUPLICATE["Card Already Exists
        Error Dialog"]
        ADD_CARD_RESULT -->|Error| ADD_CARD_ERROR["Save Failed
        Retry / Cancel"]

        ADD_CARD_SUCCESS --> SAVED_CARDS_LOAD
        ADD_CARD_DUPLICATE --> ADD_CARD
        ADD_CARD_ERROR -->|Retry| ADD_CARD_SUBMIT
        ADD_CARD_ERROR -->|Cancel| CARDS_LIST

        %% Card Detail
        CARD_DETAIL["Card Detail Screen
        - Full Card Visual
        - Card Brand
        - Masked Number
        - Expiry
        - Default Status
        - Actions Menu"]
        CARD_DETAIL --> CARD_ACTION{"Card Action?"}
        CARD_ACTION -->|Set Default| SET_DEFAULT_CONFIRM{"Confirm Set Default?"}
        CARD_ACTION -->|Remove Card| REMOVE_CARD_CONFIRM{"Confirm Remove?
        Destructive Dialog"}
        CARD_ACTION -->|Back| CARDS_LIST

        SET_DEFAULT_CONFIRM -->|Yes| SET_DEFAULT_PROCESS[/"Setting Default
        PUT /savedcards/:id/default
        (Spinner)"/]
        SET_DEFAULT_CONFIRM -->|No| CARD_DETAIL

        SET_DEFAULT_PROCESS --> SET_DEFAULT_RESULT{"Result?"}
        SET_DEFAULT_RESULT -->|Success| SET_DEFAULT_OK["Default Updated
        Success Toast"]
        SET_DEFAULT_RESULT -->|Error| SET_DEFAULT_FAIL["Update Failed
        Error Toast"]
        SET_DEFAULT_OK --> SAVED_CARDS_LOAD
        SET_DEFAULT_FAIL --> CARD_DETAIL

        REMOVE_CARD_CONFIRM -->|Yes| REMOVE_CARD_PROCESS[/"Removing Card
        DELETE /savedcards/:id
        (Spinner)"/]
        REMOVE_CARD_CONFIRM -->|No| CARD_DETAIL

        REMOVE_CARD_PROCESS --> REMOVE_CARD_RESULT{"Result?"}
        REMOVE_CARD_RESULT -->|Success| REMOVE_CARD_OK["Card Removed
        Success Toast"]
        REMOVE_CARD_RESULT -->|Error| REMOVE_CARD_FAIL["Remove Failed
        Error Toast"]
        REMOVE_CARD_OK --> SAVED_CARDS_LOAD
        REMOVE_CARD_FAIL --> CARD_DETAIL
    end

    %% ============================================================
    %% TRANSACTION HISTORY FLOW
    %% ============================================================
    subgraph HISTORY ["Transaction History"]
        direction TB

        HISTORY_LOAD[/"Loading History
        (Shimmer)"/]
        HISTORY_LOAD --> HISTORY_FETCH{"Fetch Transactions
        GET /transactions"}
        HISTORY_FETCH -->|Success| HISTORY_HAS{"Has History?"}
        HISTORY_FETCH -->|Error| HISTORY_ERROR["Error State
        Retry Button"]
        HISTORY_FETCH -->|Network Error| HISTORY_OFFLINE["Offline State
        Show Cached / Retry"]

        HISTORY_ERROR -->|Retry| HISTORY_LOAD
        HISTORY_OFFLINE -->|Retry| HISTORY_LOAD

        HISTORY_HAS -->|Yes| HISTORY_LIST["Transaction History Screen
        - Timeline View
        - Grouped by Date
        - Amount + Type Icon
        - Status Badge
        - Pagination (load more)"]
        HISTORY_HAS -->|No| HISTORY_EMPTY["Empty State
        No transactions yet
        Illustration + Message"]

        HISTORY_LIST -->|Pull Refresh| HISTORY_LOAD
        HISTORY_LIST -->|Scroll Bottom| HISTORY_PAGINATE[/"Loading More
        GET /transactions?page=N
        (Bottom Spinner)"/]
        HISTORY_PAGINATE --> HISTORY_PAGE_RESULT{"More Pages?"}
        HISTORY_PAGE_RESULT -->|Yes| HISTORY_LIST
        HISTORY_PAGE_RESULT -->|No More| HISTORY_END["End of History
        Footer Message"]
        HISTORY_PAGE_RESULT -->|Error| HISTORY_PAGE_ERROR["Load More Failed
        Retry Button"]
        HISTORY_PAGE_ERROR -->|Retry| HISTORY_PAGINATE

        %% Filter
        HISTORY_LIST -->|Filter Icon| HISTORY_FILTER["History Filter Screen
        - Date Range Picker
        - Type (Credit/Debit/All)
        - Amount Range (Min/Max)
        - Status (Success/Failed/Pending)
        - Apply / Reset Buttons"]
        HISTORY_FILTER --> FILTER_ACTION{"Filter Action?"}
        FILTER_ACTION -->|Apply| HISTORY_FILTER_APPLY[/"Filtering
        GET /transactions?filters
        (Shimmer)"/]
        FILTER_ACTION -->|Reset| HISTORY_LOAD
        FILTER_ACTION -->|Back| HISTORY_LIST

        HISTORY_FILTER_APPLY --> FILTER_RESULT{"Filter Results?"}
        FILTER_RESULT -->|Has Results| HISTORY_LIST
        FILTER_RESULT -->|No Results| HISTORY_FILTER_EMPTY["No Matching Transactions
        Adjust Filters"]
        FILTER_RESULT -->|Error| HISTORY_FILTER_ERROR["Filter Failed
        Retry"]
        HISTORY_FILTER_EMPTY --> HISTORY_FILTER
        HISTORY_FILTER_ERROR -->|Retry| HISTORY_FILTER_APPLY

        %% Search
        HISTORY_LIST -->|Search Icon| HISTORY_SEARCH["History Search Screen
        - Search Bar (auto-focus)
        - Recent Searches
        - Search by ID / Name / Amount"]
        HISTORY_SEARCH --> SEARCH_INPUT{"Search Input?"}
        SEARCH_INPUT -->|Type Query| SEARCH_DEBOUNCE[/"Debounce 300ms
        GET /transactions?search=q"/]
        SEARCH_INPUT -->|Clear| HISTORY_SEARCH
        SEARCH_INPUT -->|Back| HISTORY_LIST

        SEARCH_DEBOUNCE --> SEARCH_RESULT{"Search Results?"}
        SEARCH_RESULT -->|Has Results| SEARCH_LIST["Search Results
        - Highlighted Matches
        - Tap to View"]
        SEARCH_RESULT -->|No Results| SEARCH_EMPTY["No Results Found
        Try different query"]
        SEARCH_RESULT -->|Error| SEARCH_ERROR["Search Failed
        Error Message"]
        SEARCH_EMPTY --> HISTORY_SEARCH
        SEARCH_ERROR --> HISTORY_SEARCH

        SEARCH_LIST -->|Tap Result| RECEIPT_DETAIL_LOAD

        %% Export
        HISTORY_LIST -->|Export Icon| HISTORY_EXPORT{"Export Format?"}
        HISTORY_EXPORT -->|PDF| EXPORT_PROCESS_PDF[/"Generating PDF
        (Spinner)"/]
        HISTORY_EXPORT -->|CSV| EXPORT_PROCESS_CSV[/"Generating CSV
        (Spinner)"/]
        HISTORY_EXPORT -->|Cancel| HISTORY_LIST

        EXPORT_PROCESS_PDF --> EXPORT_RESULT{"Export Result?"}
        EXPORT_PROCESS_CSV --> EXPORT_RESULT

        EXPORT_RESULT -->|Success| EXPORT_SUCCESS["Export Ready
        - Open File
        - Share
        - Save to Device"]
        EXPORT_RESULT -->|Error| EXPORT_FAIL["Export Failed
        Retry / Cancel"]
        EXPORT_SUCCESS --> HISTORY_LIST
        EXPORT_FAIL -->|Retry| HISTORY_EXPORT
        EXPORT_FAIL -->|Cancel| HISTORY_LIST

        %% Tap Transaction
        HISTORY_LIST -->|Tap Transaction| RECEIPT_DETAIL_LOAD
    end

    %% ============================================================
    %% RECEIPT FLOW
    %% ============================================================
    subgraph RECEIPT ["Receipt"]
        direction TB

        RECEIPT_DETAIL_LOAD[/"Loading Receipt
        (Shimmer)"/]
        RECEIPT_DETAIL_LOAD --> RECEIPT_FETCH{"Fetch Receipt
        GET /receipts/:id"}
        RECEIPT_FETCH -->|Success| RECEIPT_DETAIL["Receipt Detail Screen
        - Transaction ID
        - Date & Time
        - Amount
        - From / To
        - Payment Method
        - Status
        - Reference Number"]
        RECEIPT_FETCH -->|Error| RECEIPT_ERROR["Error State
        Retry Button"]
        RECEIPT_FETCH -->|Not Found| RECEIPT_NOT_FOUND["Receipt Not Found
        Back Button"]

        RECEIPT_ERROR -->|Retry| RECEIPT_DETAIL_LOAD
        RECEIPT_NOT_FOUND --> EXIT_HOME

        RECEIPT_DETAIL --> RECEIPT_ACTION{"Receipt Action?"}
        RECEIPT_ACTION -->|Share| RECEIPT_SHARE["Share Receipt
        - System Share Sheet
        - Copy Link
        - Send via Message"]
        RECEIPT_ACTION -->|Download PDF| RECEIPT_PDF_PROCESS[/"Generating PDF
        (Spinner)"/]
        RECEIPT_ACTION -->|Back| RECEIPT_BACK{"Return To?"}

        RECEIPT_SHARE --> RECEIPT_DETAIL
        RECEIPT_PDF_PROCESS --> RECEIPT_PDF_RESULT{"PDF Result?"}
        RECEIPT_PDF_RESULT -->|Success| RECEIPT_PDF_READY["PDF Downloaded
        - Open
        - Share
        - Save"]
        RECEIPT_PDF_RESULT -->|Error| RECEIPT_PDF_FAIL["PDF Failed
        Retry"]
        RECEIPT_PDF_READY --> RECEIPT_DETAIL
        RECEIPT_PDF_FAIL -->|Retry| RECEIPT_PDF_PROCESS

        RECEIPT_BACK -->|From History| HISTORY_LIST
        RECEIPT_BACK -->|From Invoice Pay| INVOICE_LIST_LOAD
        RECEIPT_BACK -->|From Notification| EXIT_HOME
    end

    %% ============================================================
    %% EXIT POINTS
    %% ============================================================
    EXIT_HOME["Exit: Home Screen"]
    EXIT_PAYMENT["Exit: Payment Flow"]

    INVOICE_EMPTY -->|Back| EXIT_HOME
    CARDS_EMPTY -.->|"Use in Payment"| EXIT_PAYMENT
    HISTORY_EMPTY -->|Back| EXIT_HOME
    HISTORY_END --> HISTORY_LIST
    INVOICE_PAY -->|"Select Payment Method
    (No Saved Cards)"| EXIT_PAYMENT

    %% ============================================================
    %% CROSS-FEATURE LINKS
    %% ============================================================
    INVOICE_PAY -.->|"Pick Saved Card"| CARDS_LIST
    INVOICE_PAY_SUCCESS -.->|"View in History"| HISTORY_LOAD

