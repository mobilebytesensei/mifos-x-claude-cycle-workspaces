%% Flow: payments
%% Version: 1.0
%% Created: 2026-03-18
%% Generated by: /flow-generate --from-features
%%
%% Features: payments, mpay-qr, mpay-qr-scan, fast-mpay, merchants, upi-setup
%% Screens: HomeScreen, PaymentsHub, ShowMyQR, QRScannerScreen, QRScanResult,
%%          MerchantDiscovery, MerchantDetails, FastMPayScreen, UPISetupScreen,
%%          UPILinkBankScreen, UPISetPinScreen, PaymentAmountEntry, PaymentReview,
%%          PaymentAuthScreen, PaymentProcessing, PaymentSuccess, PaymentFailure,
%%          PaymentReceipt
%% Entry Points: Home Quick Action, Bottom Nav, QR Deep Link
%% Exit Points: Payment Receipt, Home Screen

flowchart TD
    %% ============================================================
    %% ENTRY POINTS
    %% ============================================================
    HOME[Home Screen]
    DEEP_LINK([QR Deep Link])
    BOTTOM_NAV([Bottom Nav - Payments])

    HOME -->|Quick Action: Pay| PAYMENTS_HUB
    HOME -->|Quick Action: Scan QR| CAM_PERM_CHECK
    HOME -->|Quick Action: Show QR| SHOW_MY_QR
    HOME -->|Quick Action: Fast Pay| FAST_MPAY
    DEEP_LINK --> CAM_PERM_CHECK
    BOTTOM_NAV --> PAYMENTS_HUB

    %% ============================================================
    %% PAYMENTS HUB
    %% ============================================================
    PAYMENTS_HUB[Payments Hub Screen]
    PAYMENTS_HUB -->|Scan & Pay| CAM_PERM_CHECK
    PAYMENTS_HUB -->|Show My QR| SHOW_MY_QR
    PAYMENTS_HUB -->|Fast M-Pay| FAST_MPAY
    PAYMENTS_HUB -->|Pay Merchant| MERCHANT_DISCOVERY
    PAYMENTS_HUB -->|UPI Setup| UPI_CONFIG_CHECK
    PAYMENTS_HUB -->|Enter Mobile / Account| AMOUNT_ENTRY

    %% ============================================================
    %% SHOW MY QR (mpay-qr)
    %% ============================================================
    SHOW_MY_QR[Show My QR Screen]
    SHOW_MY_QR_LOADING[/Loading QR.../]
    SHOW_MY_QR_ERROR[QR Generation Error]

    SHOW_MY_QR --> SHOW_MY_QR_LOADING
    SHOW_MY_QR_LOADING -->|Success| SHOW_MY_QR_READY[My QR Code Displayed]
    SHOW_MY_QR_LOADING -->|Failure| SHOW_MY_QR_ERROR
    SHOW_MY_QR_ERROR -->|Retry| SHOW_MY_QR_LOADING
    SHOW_MY_QR_ERROR -->|Back| PAYMENTS_HUB
    SHOW_MY_QR_READY -->|Set Amount| QR_AMOUNT_SET[Set QR Amount]
    QR_AMOUNT_SET --> SHOW_MY_QR_LOADING
    SHOW_MY_QR_READY -->|Share QR| QR_SHARED([QR Shared via OS Share Sheet])
    SHOW_MY_QR_READY -->|Back| PAYMENTS_HUB

    %% ============================================================
    %% QR SCAN (mpay-qr-scan)
    %% ============================================================
    CAM_PERM_CHECK{Camera Permission Granted?}
    CAM_PERM_CHECK -->|Yes| QR_SCANNER
    CAM_PERM_CHECK -->|No| CAM_PERM_REQUEST[Request Camera Permission]
    CAM_PERM_REQUEST -->|Granted| QR_SCANNER
    CAM_PERM_REQUEST -->|Denied| CAM_PERM_DENIED[Permission Denied Message]
    CAM_PERM_DENIED -->|Open Settings| CAM_SETTINGS([Open App Settings])
    CAM_PERM_DENIED -->|Back| PAYMENTS_HUB

    QR_SCANNER[QR Scanner Screen]
    QR_SCANNER -->|QR Detected| QR_VALIDATE{QR Code Valid?}
    QR_SCANNER -->|Upload from Gallery| QR_GALLERY[Select QR Image]
    QR_GALLERY -->|Image Selected| QR_VALIDATE
    QR_GALLERY -->|Cancelled| QR_SCANNER
    QR_SCANNER -->|Back| PAYMENTS_HUB

    QR_VALIDATE -->|Valid M-Pay QR| QR_SCAN_RESULT
    QR_VALIDATE -->|Valid Merchant QR| MERCHANT_DETAILS
    QR_VALIDATE -->|Invalid QR| QR_INVALID[Invalid QR Error]
    QR_INVALID -->|Scan Again| QR_SCANNER
    QR_INVALID -->|Back| PAYMENTS_HUB

    QR_SCAN_RESULT[QR Scan Result Screen]
    QR_SCAN_RESULT -->|Amount Pre-filled| PAYMENT_REVIEW
    QR_SCAN_RESULT -->|Amount Not Set| AMOUNT_ENTRY

    %% ============================================================
    %% MERCHANT DISCOVERY & DETAILS (merchants)
    %% ============================================================
    MERCHANT_DISCOVERY[Merchant Discovery Screen]
    MERCHANT_DISC_LOADING[/Loading Merchants.../]
    MERCHANT_DISC_ERROR[Merchant Load Error]
    MERCHANT_DISC_EMPTY[No Merchants Found]

    MERCHANT_DISCOVERY --> MERCHANT_DISC_LOADING
    MERCHANT_DISC_LOADING -->|Success| MERCHANT_LIST[Merchant List Displayed]
    MERCHANT_DISC_LOADING -->|Failure| MERCHANT_DISC_ERROR
    MERCHANT_DISC_LOADING -->|Empty| MERCHANT_DISC_EMPTY
    MERCHANT_DISC_ERROR -->|Retry| MERCHANT_DISC_LOADING
    MERCHANT_DISC_ERROR -->|Back| PAYMENTS_HUB
    MERCHANT_DISC_EMPTY -->|Back| PAYMENTS_HUB

    MERCHANT_LIST -->|Select Merchant| MERCHANT_DETAILS
    MERCHANT_LIST -->|Search| MERCHANT_SEARCH[Search Merchants]
    MERCHANT_SEARCH -->|Result Selected| MERCHANT_DETAILS
    MERCHANT_SEARCH -->|No Results| MERCHANT_DISC_EMPTY
    MERCHANT_LIST -->|Filter by Category| MERCHANT_LIST
    MERCHANT_LIST -->|Scan Merchant QR| CAM_PERM_CHECK
    MERCHANT_LIST -->|Back| PAYMENTS_HUB

    MERCHANT_DETAILS[Merchant Details Screen]
    MERCHANT_DETAILS_LOADING[/Loading Merchant Info.../]
    MERCHANT_DETAILS --> MERCHANT_DETAILS_LOADING
    MERCHANT_DETAILS_LOADING -->|Success| MERCHANT_INFO[Merchant Info Displayed]
    MERCHANT_DETAILS_LOADING -->|Failure| MERCHANT_DETAILS_ERROR[Merchant Details Error]
    MERCHANT_DETAILS_ERROR -->|Retry| MERCHANT_DETAILS_LOADING
    MERCHANT_DETAILS_ERROR -->|Back| MERCHANT_DISCOVERY

    MERCHANT_INFO -->|Pay| AMOUNT_ENTRY
    MERCHANT_INFO -->|NFC Tap to Pay| NFC_CHECK{NFC Available?}
    MERCHANT_INFO -->|Back| MERCHANT_DISCOVERY

    NFC_CHECK -->|Yes| NFC_TAP[Tap Device to Pay]
    NFC_CHECK -->|No| NFC_UNAVAILABLE[NFC Not Available]
    NFC_UNAVAILABLE -->|Pay via QR Instead| AMOUNT_ENTRY
    NFC_UNAVAILABLE -->|Back| MERCHANT_INFO
    NFC_TAP -->|NFC Read Success| AMOUNT_ENTRY
    NFC_TAP -->|NFC Read Failed| NFC_ERROR[NFC Read Error]
    NFC_ERROR -->|Retry Tap| NFC_TAP
    NFC_ERROR -->|Pay via QR Instead| AMOUNT_ENTRY

    %% ============================================================
    %% FAST M-PAY (fast-mpay)
    %% ============================================================
    FAST_MPAY[Fast M-Pay Screen]
    FAST_MPAY_LOADING[/Loading Favorites.../]

    FAST_MPAY --> FAST_MPAY_LOADING
    FAST_MPAY_LOADING -->|Success| FAST_MPAY_READY[Favorites & Recent Payees]
    FAST_MPAY_LOADING -->|Failure| FAST_MPAY_ERROR[Load Error]
    FAST_MPAY_LOADING -->|Empty| FAST_MPAY_EMPTY[No Favorites Yet]
    FAST_MPAY_ERROR -->|Retry| FAST_MPAY_LOADING
    FAST_MPAY_ERROR -->|Back| PAYMENTS_HUB
    FAST_MPAY_EMPTY -->|Add Favorite| PAYMENTS_HUB
    FAST_MPAY_EMPTY -->|Back| PAYMENTS_HUB

    FAST_MPAY_READY -->|Select Payee| FAST_AMOUNT[Pre-filled Amount Screen]
    FAST_AMOUNT -->|Confirm Amount| PAYMENT_REVIEW
    FAST_AMOUNT -->|Edit Amount| AMOUNT_ENTRY
    FAST_MPAY_READY -->|Back| PAYMENTS_HUB

    %% ============================================================
    %% UPI SETUP (upi-setup)
    %% ============================================================
    UPI_CONFIG_CHECK{UPI Already Configured?}
    UPI_CONFIG_CHECK -->|Yes| UPI_MANAGE[UPI Management Screen]
    UPI_CONFIG_CHECK -->|No| UPI_SETUP

    UPI_SETUP[UPI Setup Screen]
    UPI_SETUP -->|Link Bank Account| UPI_LINK_BANK
    UPI_SETUP -->|Skip| PAYMENTS_HUB

    UPI_LINK_BANK[Link Bank Account Screen]
    UPI_LINK_BANK_LOADING[/Fetching Banks.../]
    UPI_LINK_BANK --> UPI_LINK_BANK_LOADING
    UPI_LINK_BANK_LOADING -->|Success| UPI_BANK_LIST[Bank List Displayed]
    UPI_LINK_BANK_LOADING -->|Failure| UPI_BANK_ERROR[Bank Fetch Error]
    UPI_BANK_ERROR -->|Retry| UPI_LINK_BANK_LOADING
    UPI_BANK_ERROR -->|Back| UPI_SETUP

    UPI_BANK_LIST -->|Select Bank| UPI_ACCOUNT_VERIFY[Verify Account via SMS]
    UPI_ACCOUNT_VERIFY -->|SMS Sent| UPI_VERIFY_LOADING[/Verifying.../]
    UPI_VERIFY_LOADING -->|Verified| UPI_SET_PIN
    UPI_VERIFY_LOADING -->|Failed| UPI_VERIFY_ERROR[Verification Failed]
    UPI_VERIFY_ERROR -->|Retry| UPI_ACCOUNT_VERIFY
    UPI_VERIFY_ERROR -->|Back| UPI_BANK_LIST

    UPI_SET_PIN[Set UPI PIN Screen]
    UPI_SET_PIN -->|Enter Debit Card Last 6 + Expiry| UPI_PIN_ENTRY[Create UPI PIN]
    UPI_PIN_ENTRY -->|PIN Set| UPI_PIN_CONFIRM[Confirm UPI PIN]
    UPI_PIN_CONFIRM -->|Match| UPI_PIN_LOADING[/Setting PIN.../]
    UPI_PIN_CONFIRM -->|Mismatch| UPI_PIN_MISMATCH[PIN Mismatch Error]
    UPI_PIN_MISMATCH -->|Re-enter| UPI_PIN_ENTRY
    UPI_PIN_LOADING -->|Success| UPI_SETUP_SUCCESS[UPI Setup Complete]
    UPI_PIN_LOADING -->|Failure| UPI_PIN_ERROR[PIN Setup Failed]
    UPI_PIN_ERROR -->|Retry| UPI_SET_PIN
    UPI_SETUP_SUCCESS -->|Done| PAYMENTS_HUB

    UPI_MANAGE -->|Change PIN| UPI_CHANGE_PIN[Change UPI PIN]
    UPI_MANAGE -->|Unlink Account| UPI_UNLINK_CONFIRM{Confirm Unlink?}
    UPI_MANAGE -->|Back| PAYMENTS_HUB
    UPI_CHANGE_PIN -->|Enter Old PIN| UPI_OLD_PIN_VERIFY[/Verifying Old PIN.../]
    UPI_OLD_PIN_VERIFY -->|Correct| UPI_PIN_ENTRY
    UPI_OLD_PIN_VERIFY -->|Incorrect| UPI_OLD_PIN_ERROR[Incorrect PIN]
    UPI_OLD_PIN_ERROR -->|Retry| UPI_CHANGE_PIN
    UPI_UNLINK_CONFIRM -->|Yes| UPI_UNLINK_LOADING[/Unlinking.../]
    UPI_UNLINK_CONFIRM -->|No| UPI_MANAGE
    UPI_UNLINK_LOADING -->|Success| UPI_SETUP
    UPI_UNLINK_LOADING -->|Failure| UPI_UNLINK_ERROR[Unlink Failed]
    UPI_UNLINK_ERROR -->|Retry| UPI_UNLINK_LOADING

    %% ============================================================
    %% PAYMENT AMOUNT ENTRY
    %% ============================================================
    AMOUNT_ENTRY[Payment Amount Entry Screen]
    AMOUNT_ENTRY -->|Enter Amount + Note| PAYMENT_REVIEW
    AMOUNT_ENTRY -->|Back| PAYMENTS_HUB

    %% ============================================================
    %% PAYMENT REVIEW & CONFIRMATION
    %% ============================================================
    PAYMENT_REVIEW[Payment Review Screen]
    PAYMENT_REVIEW -->|Payee, Amount, Note displayed|BALANCE_CHECK{Sufficient Balance?}

    BALANCE_CHECK -->|Yes| UPI_CONFIGURED_CHECK{UPI Configured?}
    BALANCE_CHECK -->|No| INSUFFICIENT_BALANCE[Insufficient Balance Error]
    INSUFFICIENT_BALANCE -->|Edit Amount| AMOUNT_ENTRY
    INSUFFICIENT_BALANCE -->|Back| PAYMENTS_HUB

    UPI_CONFIGURED_CHECK -->|Yes| PAYMENT_AUTH
    UPI_CONFIGURED_CHECK -->|No| UPI_REQUIRED[UPI Setup Required]
    UPI_REQUIRED -->|Setup UPI| UPI_SETUP
    UPI_REQUIRED -->|Back| PAYMENTS_HUB

    %% ============================================================
    %% PAYMENT AUTHENTICATION (PIN / Biometric)
    %% ============================================================
    PAYMENT_AUTH[Payment Auth Screen]
    PAYMENT_AUTH -->|Enter UPI PIN| PIN_VALIDATE{PIN Correct?}
    PAYMENT_AUTH -->|Use Biometric| BIO_CHECK{Biometric Available?}
    PAYMENT_AUTH -->|Cancel| PAYMENTS_HUB

    BIO_CHECK -->|Yes| BIO_PROMPT[Biometric Prompt]
    BIO_CHECK -->|No| PAYMENT_AUTH
    BIO_PROMPT -->|Authenticated| PAYMENT_PROCESSING
    BIO_PROMPT -->|Failed| BIO_FAIL[Biometric Failed]
    BIO_FAIL -->|Retry Biometric| BIO_PROMPT
    BIO_FAIL -->|Use PIN Instead| PAYMENT_AUTH

    PIN_VALIDATE -->|Correct| PAYMENT_PROCESSING
    PIN_VALIDATE -->|Incorrect| PIN_ERROR[Incorrect PIN]
    PIN_ERROR -->|Retry| PAYMENT_AUTH
    PIN_ERROR -->|3 Attempts Failed| PIN_LOCKED[Account Temporarily Locked]
    PIN_LOCKED -->|Back to Home| HOME

    %% ============================================================
    %% PAYMENT PROCESSING
    %% ============================================================
    PAYMENT_PROCESSING[/Processing Payment.../]
    PAYMENT_PROCESSING -->|Success| PAYMENT_SUCCESS
    PAYMENT_PROCESSING -->|Failure| PAYMENT_FAILURE
    PAYMENT_PROCESSING -->|Timeout| PAYMENT_TIMEOUT[Payment Timeout]

    PAYMENT_TIMEOUT -->|Check Status| TXN_STATUS_CHECK[/Checking Transaction Status.../]
    TXN_STATUS_CHECK -->|Success| PAYMENT_SUCCESS
    TXN_STATUS_CHECK -->|Failed| PAYMENT_FAILURE
    TXN_STATUS_CHECK -->|Pending| PAYMENT_PENDING[Payment Pending Screen]
    PAYMENT_PENDING -->|Refresh| TXN_STATUS_CHECK
    PAYMENT_PENDING -->|Back to Home| HOME

    %% ============================================================
    %% PAYMENT SUCCESS
    %% ============================================================
    PAYMENT_SUCCESS[Payment Success Screen]
    PAYMENT_SUCCESS -->|View Receipt| PAYMENT_RECEIPT
    PAYMENT_SUCCESS -->|Share Receipt| RECEIPT_SHARE([Share via OS Share Sheet])
    PAYMENT_SUCCESS -->|Add to Favorites| FAVORITE_SAVED[Payee Saved to Favorites]
    PAYMENT_SUCCESS -->|Done| HOME

    %% ============================================================
    %% PAYMENT FAILURE
    %% ============================================================
    PAYMENT_FAILURE[Payment Failed Screen]
    PAYMENT_FAILURE -->|Retry Payment| PAYMENT_REVIEW
    PAYMENT_FAILURE -->|Report Issue| REPORT_ISSUE[Report Issue Screen]
    PAYMENT_FAILURE -->|Back to Home| HOME
    REPORT_ISSUE -->|Submitted| HOME

    %% ============================================================
    %% PAYMENT RECEIPT
    %% ============================================================
    PAYMENT_RECEIPT[Payment Receipt Screen]
    PAYMENT_RECEIPT -->|Share| RECEIPT_SHARE
    PAYMENT_RECEIPT -->|Download PDF| RECEIPT_DOWNLOAD([PDF Downloaded])
    PAYMENT_RECEIPT -->|Done| HOME

    %% ============================================================
    %% EXIT POINTS
    %% ============================================================
    FAVORITE_SAVED -->|Done| HOME

    %% ============================================================
    %% STYLES
    %% ============================================================
    classDef entryPoint fill:#4CAF50,stroke:#2E7D32,color:#fff
    classDef exitPoint fill:#2196F3,stroke:#1565C0,color:#fff
    classDef errorState fill:#F44336,stroke:#C62828,color:#fff
    classDef loadingState fill:#FF9800,stroke:#E65100,color:#fff
    classDef decision fill:#FFC107,stroke:#F57F17,color:#000
    classDef successState fill:#4CAF50,stroke:#2E7D32,color:#fff

    class HOME,DEEP_LINK,BOTTOM_NAV entryPoint
    class PAYMENT_RECEIPT,RECEIPT_SHARE,RECEIPT_DOWNLOAD exitPoint
    class SHOW_MY_QR_ERROR,QR_INVALID,MERCHANT_DISC_ERROR,MERCHANT_DETAILS_ERROR,FAST_MPAY_ERROR,UPI_BANK_ERROR,UPI_VERIFY_ERROR,UPI_PIN_ERROR,UPI_PIN_MISMATCH,UPI_OLD_PIN_ERROR,UPI_UNLINK_ERROR,INSUFFICIENT_BALANCE,PIN_ERROR,PIN_LOCKED,BIO_FAIL,PAYMENT_FAILURE,PAYMENT_TIMEOUT,NFC_ERROR,NFC_UNAVAILABLE,CAM_PERM_DENIED errorState
    class SHOW_MY_QR_LOADING,MERCHANT_DISC_LOADING,MERCHANT_DETAILS_LOADING,FAST_MPAY_LOADING,UPI_LINK_BANK_LOADING,UPI_VERIFY_LOADING,UPI_PIN_LOADING,UPI_OLD_PIN_VERIFY,UPI_UNLINK_LOADING,PAYMENT_PROCESSING,TXN_STATUS_CHECK loadingState
    class CAM_PERM_CHECK,QR_VALIDATE,NFC_CHECK,UPI_CONFIG_CHECK,BALANCE_CHECK,UPI_CONFIGURED_CHECK,BIO_CHECK,PIN_VALIDATE,UPI_UNLINK_CONFIRM decision
    class PAYMENT_SUCCESS,UPI_SETUP_SUCCESS,FAVORITE_SAVED successState
