%%               financial-services, settings, pocket
%% Total Screens: 540+ nodes across all flows
%%
%% Entry Points: App Launch, Push Notification, Deep Link, QR Deep Link
%% Exit Points: (none - circular app lifecycle)

flowchart TD
    %% ════════════════════════════════════════════════════════════════
    %% ENTRY POINTS
    %% ════════════════════════════════════════════════════════════════

    ENTRY_APP([App Launch])
    ENTRY_PUSH([Push Notification])
    ENTRY_DEEP([Deep Link])
    ENTRY_QR([QR Deep Link])

    %% ════════════════════════════════════════════════════════════════
    %% AUTHENTICATION DOMAIN
    %% ════════════════════════════════════════════════════════════════

    subgraph AUTH [Authentication]
        direction TB
        SPLASH[Splash Screen]
        DEC_TOKEN{Token exists?}
        DEC_VALID{Token valid?}
        TOKEN_REFRESH[Token Refresh]
        DEC_REFRESH{Refresh OK?}

        LOGIN[Login Screen]
        DEC_LOGIN_API{Login API}
        REGISTER[Registration Wizard]
        DEC_REG_API{Register API}
        FORGOT_PWD[Forgot Password]

        DEC_FIRST{First login?}
        PASSCODE_SETUP[Setup Passcode]
        DEC_BIO{Biometric available?}
        BIO_ENROLL[Enable Biometric?]

        PASSCODE[Enter Passcode]
        DEC_PASSCODE{Passcode correct?}
        BIO_PROMPT[Biometric Prompt]
        DEC_BIO_OK{Bio verified?}

        SPLASH --> DEC_TOKEN
        DEC_TOKEN -->|Yes| DEC_VALID
        DEC_TOKEN -->|No| LOGIN
        DEC_VALID -->|Yes| DEC_BIO
        DEC_VALID -->|No| TOKEN_REFRESH
        TOKEN_REFRESH --> DEC_REFRESH
        DEC_REFRESH -->|Yes| DEC_BIO
        DEC_REFRESH -->|No| LOGIN

        LOGIN -->|Submit| DEC_LOGIN_API
        LOGIN -->|Register| REGISTER
        LOGIN -->|Forgot| FORGOT_PWD
        DEC_LOGIN_API -->|Success| DEC_FIRST
        DEC_LOGIN_API -->|Error| LOGIN
        REGISTER --> DEC_REG_API
        DEC_REG_API -->|Success| LOGIN
        DEC_REG_API -->|Error| REGISTER
        FORGOT_PWD -->|Reset sent| LOGIN

        DEC_FIRST -->|Yes| PASSCODE_SETUP
        DEC_FIRST -->|No| PASSCODE
        PASSCODE_SETUP --> DEC_BIO
        DEC_BIO -->|Yes| BIO_ENROLL
        DEC_BIO -->|No| PASSCODE
        BIO_ENROLL -->|Enrolled| BIO_PROMPT
        BIO_ENROLL -->|Skip| PASSCODE

        PASSCODE --> DEC_PASSCODE
        DEC_PASSCODE -->|Correct| AUTH_SUCCESS
        DEC_PASSCODE -->|Wrong 3x| LOGIN
        BIO_PROMPT --> DEC_BIO_OK
        DEC_BIO_OK -->|Success| AUTH_SUCCESS
        DEC_BIO_OK -->|Fail| PASSCODE

        AUTH_SUCCESS([Authenticated])
    end

    %% ════════════════════════════════════════════════════════════════
    %% MAIN NAVIGATION DOMAIN (Central Hub)
    %% ════════════════════════════════════════════════════════════════

    subgraph NAV [Main Navigation]
        direction TB
        HOME[Home Screen]
        HOME_PAGER[Account Pager]
        HOME_BALANCE[Balance Summary]
        HOME_ACTIONS[Quick Actions]

        ACCOUNTS[Accounts Screen]
        ACCOUNT_TABS[Savings / Loans / Shares Tabs]
        ACCOUNT_DETAIL[Account Detail]

        FINANCE[Finance Overview]
        FINANCE_SUMMARY[Balance + Recent Transactions]

        NOTIFICATIONS[Notification Center]
        NOTIF_DETAIL[Alert Detail]

        BOTTOM_NAV{Bottom Navigation}

        HOME --> HOME_PAGER
        HOME --> HOME_BALANCE
        HOME --> HOME_ACTIONS

        BOTTOM_NAV -->|Home| HOME
        BOTTOM_NAV -->|Accounts| ACCOUNTS
        BOTTOM_NAV -->|Payments| EXIT_TO_PAYMENTS
        BOTTOM_NAV -->|Profile| EXIT_TO_SETTINGS

        ACCOUNTS --> ACCOUNT_TABS
        ACCOUNT_TABS --> ACCOUNT_DETAIL
        HOME -->|Notifications Bell| NOTIFICATIONS
        NOTIFICATIONS --> NOTIF_DETAIL

        HOME -->|Finance Tab| FINANCE
        FINANCE --> FINANCE_SUMMARY

        EXIT_TO_PAYMENTS([To Payments])
        EXIT_TO_SETTINGS([To Settings])
    end

    %% ════════════════════════════════════════════════════════════════
    %% POCKET (Integrated into Home)
    %% ════════════════════════════════════════════════════════════════

    subgraph POCKET [Pocket - Favorites]
        direction TB
        DEC_POCKET{Pocket empty?}
        POCKET_VIEW[Show Pocket Accounts]
        ALL_VIEW[Show All Accounts]
        VIEW_TOGGLE[View Dropdown Toggle]
        MANAGE_POCKET[Manage Pocket Screen]
        LONG_PRESS_MENU[Account Context Menu]

        DEC_POCKET -->|Empty| ALL_VIEW
        DEC_POCKET -->|Has accounts| POCKET_VIEW
        VIEW_TOGGLE -->|Pocket| POCKET_VIEW
        VIEW_TOGGLE -->|All| ALL_VIEW
        VIEW_TOGGLE -->|Manage| MANAGE_POCKET
        LONG_PRESS_MENU -->|Add/Remove from Pocket| MANAGE_POCKET
        LONG_PRESS_MENU -->|View Details| ACCOUNT_DETAIL
    end

    %% ════════════════════════════════════════════════════════════════
    %% TRANSFERS DOMAIN
    %% ════════════════════════════════════════════════════════════════

    subgraph TRANSFERS [Transfers]
        direction TB
        TRANSFER_HUB[Transfer Hub]
        DEC_TRANSFER_TYPE{Transfer Type}

        INTRA_TRANSFER[P2P Transfer - Same Bank]
        INTER_TRANSFER[Bank Transfer - Different Bank]
        TRANSFER_FORM[Amount + Recipient Form]
        DEC_BALANCE{Sufficient balance?}
        CONFIRM_TRANSFER[Confirmation Screen]
        OTP_VERIFY[OTP / PIN Verification]
        DEC_OTP{OTP correct?}
        TRANSFER_PROCESSING[Processing...]
        DEC_TRANSFER_API{API Result}
        TRANSFER_RECEIPT[Transfer Receipt]

        BENEFICIARY_LIST[Beneficiary List]
        ADD_BENEFICIARY[Add Beneficiary]
        EDIT_BENEFICIARY[Edit Beneficiary]

        SI_LIST[Standing Instructions]
        CREATE_SI[Create Standing Instruction]
        SI_DETAIL[SI Detail]

        TRANSFER_HUB --> DEC_TRANSFER_TYPE
        DEC_TRANSFER_TYPE -->|P2P| INTRA_TRANSFER
        DEC_TRANSFER_TYPE -->|Bank| INTER_TRANSFER
        DEC_TRANSFER_TYPE -->|Beneficiaries| BENEFICIARY_LIST
        DEC_TRANSFER_TYPE -->|Standing Instructions| SI_LIST

        INTRA_TRANSFER --> TRANSFER_FORM
        INTER_TRANSFER --> TRANSFER_FORM
        TRANSFER_FORM --> DEC_BALANCE
        DEC_BALANCE -->|Yes| CONFIRM_TRANSFER
        DEC_BALANCE -->|No| TRANSFER_FORM
        CONFIRM_TRANSFER --> OTP_VERIFY
        OTP_VERIFY --> DEC_OTP
        DEC_OTP -->|Correct| TRANSFER_PROCESSING
        DEC_OTP -->|Wrong 3x| TRANSFER_HUB
        TRANSFER_PROCESSING --> DEC_TRANSFER_API
        DEC_TRANSFER_API -->|Success| TRANSFER_RECEIPT
        DEC_TRANSFER_API -->|Error| CONFIRM_TRANSFER

        BENEFICIARY_LIST --> ADD_BENEFICIARY
        BENEFICIARY_LIST --> EDIT_BENEFICIARY
        SI_LIST --> CREATE_SI
        SI_LIST --> SI_DETAIL
    end

    %% ════════════════════════════════════════════════════════════════
    %% PAYMENTS DOMAIN
    %% ════════════════════════════════════════════════════════════════

    subgraph PAYMENTS [Payments]
        direction TB
        PAYMENTS_HUB[Payments Hub]
        DEC_PAY_TYPE{Payment Type}

        SHOW_QR[Show My QR Code]
        QR_SCANNER[QR Scanner Camera]
        DEC_QR_VALID{QR Valid?}
        QR_RESULT[Scan Result]

        MERCHANT_LIST[Merchant Discovery]
        MERCHANT_DETAIL[Merchant Detail]
        DEC_NFC{NFC Available?}
        NFC_TAP[NFC Tap to Pay]

        FAST_PAY[Fast M-Pay - Favorites]

        UPI_SETUP[UPI Setup]
        UPI_LINK_BANK[Link Bank Account]
        UPI_SET_PIN[Set UPI PIN]
        UPI_MANAGE[Manage UPI]

        AMOUNT_ENTRY[Amount Entry]
        PAYMENT_REVIEW[Payment Review]
        DEC_PAY_BALANCE{Balance OK?}
        PAYMENT_AUTH[PIN / Biometric Auth]
        DEC_PAY_AUTH{Auth OK?}
        PAY_PROCESSING[Processing Payment...]
        DEC_PAY_API{API Result}
        PAY_SUCCESS[Payment Success]
        PAY_FAILURE[Payment Failed]
        PAY_RECEIPT[Payment Receipt]

        PAYMENTS_HUB --> DEC_PAY_TYPE
        DEC_PAY_TYPE -->|Show QR| SHOW_QR
        DEC_PAY_TYPE -->|Scan QR| QR_SCANNER
        DEC_PAY_TYPE -->|Merchants| MERCHANT_LIST
        DEC_PAY_TYPE -->|Fast Pay| FAST_PAY
        DEC_PAY_TYPE -->|UPI Setup| UPI_SETUP

        QR_SCANNER --> DEC_QR_VALID
        DEC_QR_VALID -->|Yes| QR_RESULT
        DEC_QR_VALID -->|No| QR_SCANNER
        QR_RESULT --> AMOUNT_ENTRY

        MERCHANT_LIST --> MERCHANT_DETAIL
        MERCHANT_DETAIL --> DEC_NFC
        DEC_NFC -->|Yes| NFC_TAP
        DEC_NFC -->|No| AMOUNT_ENTRY
        NFC_TAP --> AMOUNT_ENTRY

        FAST_PAY --> AMOUNT_ENTRY
        UPI_SETUP --> UPI_LINK_BANK --> UPI_SET_PIN --> UPI_MANAGE

        AMOUNT_ENTRY --> PAYMENT_REVIEW
        PAYMENT_REVIEW --> DEC_PAY_BALANCE
        DEC_PAY_BALANCE -->|Yes| PAYMENT_AUTH
        DEC_PAY_BALANCE -->|No| AMOUNT_ENTRY
        PAYMENT_AUTH --> DEC_PAY_AUTH
        DEC_PAY_AUTH -->|Success| PAY_PROCESSING
        DEC_PAY_AUTH -->|Fail 3x| PAYMENTS_HUB
        PAY_PROCESSING --> DEC_PAY_API
        DEC_PAY_API -->|Success| PAY_SUCCESS
        DEC_PAY_API -->|Failed| PAY_FAILURE
        PAY_SUCCESS --> PAY_RECEIPT
        PAY_FAILURE -->|Retry| PAYMENT_REVIEW
    end

    %% ════════════════════════════════════════════════════════════════
    %% FINANCIAL SERVICES DOMAIN
    %% ════════════════════════════════════════════════════════════════

    subgraph FINSERV [Financial Services]
        direction TB
        FINSERV_HUB[Financial Services Hub]
        DEC_FINSERV{Section}

        INVOICE_LIST[Invoice List]
        INVOICE_DETAIL[Invoice Detail]
        INVOICE_PAY[Pay Invoice]

        CARDS_LIST[Saved Cards]
        ADD_CARD[Add Card]
        CARD_DETAIL[Card Detail]

        HISTORY_LIST[Transaction History]
        HISTORY_FILTER[Filter & Search]
        HISTORY_EXPORT[Export PDF/CSV]

        RECEIPT_DETAIL[Receipt Detail]
        RECEIPT_SHARE[Share Receipt]
        RECEIPT_PDF[Download PDF]

        FINSERV_HUB --> DEC_FINSERV
        DEC_FINSERV -->|Invoices| INVOICE_LIST
        DEC_FINSERV -->|Saved Cards| CARDS_LIST
        DEC_FINSERV -->|History| HISTORY_LIST
        DEC_FINSERV -->|Recent Receipt| RECEIPT_DETAIL

        INVOICE_LIST --> INVOICE_DETAIL
        INVOICE_DETAIL --> INVOICE_PAY
        INVOICE_PAY -.->|Pick Card| CARDS_LIST

        CARDS_LIST --> ADD_CARD
        CARDS_LIST --> CARD_DETAIL

        HISTORY_LIST --> HISTORY_FILTER
        HISTORY_LIST --> HISTORY_EXPORT
        HISTORY_LIST -->|Tap transaction| RECEIPT_DETAIL

        RECEIPT_DETAIL --> RECEIPT_SHARE
        RECEIPT_DETAIL --> RECEIPT_PDF
    end

    %% ════════════════════════════════════════════════════════════════
    %% SETTINGS DOMAIN
    %% ════════════════════════════════════════════════════════════════

    subgraph SETTINGS [Settings & Profile]
        direction TB
        SETTINGS_MAIN[Settings Main]
        DEC_SETTINGS{Section}

        SECURITY[Security Settings]
        CHANGE_PIN[Change PIN]
        BIOMETRIC[Biometric Toggle]
        TWO_FA[2FA Setup/Manage]

        NOTIF_PREFS[Notification Preferences]

        PROFILE_VIEW[Profile Screen]
        EDIT_PROFILE[Edit Profile]

        EDIT_PASSWORD[Edit Password]

        KYC_HUB[KYC Verification]
        KYC_L1[KYC Level 1]
        KYC_L2[KYC Level 2 + Documents]
        KYC_STATUS[KYC Status]

        LANGUAGE[Language Selection]
        THEME[Theme Selection]
        FAQ_LIST[FAQ Screen]
        FAQ_DETAIL[FAQ Detail]
        ABOUT[About Screen]

        ACCOUNT_DATA[Account & Data - GDPR]
        DATA_EXPORT[Export My Data]
        DELETE_ACCOUNT[Delete Account]

        LOGOUT_CONFIRM[Logout Confirmation]

        SETTINGS_MAIN --> DEC_SETTINGS
        DEC_SETTINGS -->|Security| SECURITY
        DEC_SETTINGS -->|Notifications| NOTIF_PREFS
        DEC_SETTINGS -->|Profile| PROFILE_VIEW
        DEC_SETTINGS -->|Password| EDIT_PASSWORD
        DEC_SETTINGS -->|KYC| KYC_HUB
        DEC_SETTINGS -->|Language| LANGUAGE
        DEC_SETTINGS -->|Theme| THEME
        DEC_SETTINGS -->|FAQ| FAQ_LIST
        DEC_SETTINGS -->|About| ABOUT
        DEC_SETTINGS -->|Account & Data| ACCOUNT_DATA
        DEC_SETTINGS -->|Logout| LOGOUT_CONFIRM

        SECURITY --> CHANGE_PIN
        SECURITY --> BIOMETRIC
        SECURITY --> TWO_FA

        PROFILE_VIEW --> EDIT_PROFILE

        KYC_HUB --> KYC_L1
        KYC_HUB --> KYC_L2
        KYC_HUB --> KYC_STATUS

        FAQ_LIST --> FAQ_DETAIL

        ACCOUNT_DATA --> DATA_EXPORT
        ACCOUNT_DATA --> DELETE_ACCOUNT
    end

    %% ════════════════════════════════════════════════════════════════
    %% CROSS-FLOW CONNECTIONS
    %% ════════════════════════════════════════════════════════════════

    %% Entry → Auth
    ENTRY_APP --> SPLASH
    ENTRY_DEEP --> SPLASH
    ENTRY_PUSH --> NOTIFICATIONS
    ENTRY_QR --> QR_SCANNER

    %% Auth → Home
    AUTH_SUCCESS --> HOME

    %% Home → Feature Domains
    HOME_ACTIONS -->|Transfer| TRANSFER_HUB
    HOME_ACTIONS -->|Pay / Scan QR| PAYMENTS_HUB
    HOME_ACTIONS -->|History| FINSERV_HUB
    EXIT_TO_PAYMENTS --> PAYMENTS_HUB
    EXIT_TO_SETTINGS --> SETTINGS_MAIN
    ACCOUNT_DETAIL -->|Send Money| TRANSFER_HUB

    %% Pocket ↔ Home
    HOME_PAGER --> DEC_POCKET

    %% Feature Domains → Home (Return)
    TRANSFER_RECEIPT -->|Go Home| HOME
    PAY_RECEIPT -->|Go Home| HOME
    FINSERV_HUB -.->|Back| HOME
    SETTINGS_MAIN -.->|Back| HOME

    %% Settings → Auth (Logout / Delete)
    LOGOUT_CONFIRM -->|Confirm| LOGIN
    DELETE_ACCOUNT -->|Deleted| LOGIN

    %% Financial Services → Payments
    INVOICE_PAY -->|No saved card| PAYMENTS_HUB

