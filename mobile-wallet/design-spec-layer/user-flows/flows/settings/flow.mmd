%% Flow: settings
%% Version: 1.0
%% Created: 2026-03-18
%% Generated by: /flow-generate --from-features
%%
%% Features: settings, faq
%% Screens: SettingsMain, SecuritySettings, ChangePIN, BiometricSettings, TwoFactorSetup,
%%          NotificationPreferences, LanguageSelection, ThemeSelection, FAQList, FAQDetail,
%%          AboutScreen, LicensesScreen, TermsScreen, AccountDeletion, DataExport,
%%          LogoutConfirmation
%% Entry Points: Bottom Nav Profile Tab, Home Menu
%% Exit Points: Home Screen, Login Screen (after logout)

flowchart TD
    %% ============================================================
    %% ENTRY POINTS
    %% ============================================================
    EP_PROFILE["Bottom Nav Profile Tab"]
    EP_HOME["Home Menu > Settings"]

    EP_PROFILE --> SETTINGS_MAIN
    EP_HOME --> SETTINGS_MAIN

    %% ============================================================
    %% SETTINGS MAIN SCREEN
    %% ============================================================
    SETTINGS_MAIN["Settings Main Screen
    ----------------------
    - Security
    - Notifications
    - Language
    - Theme
    - FAQ
    - About
    - Account & Data
    - Logout"]

    SETTINGS_MAIN --> SEC_SETTINGS["Security Settings"]
    SETTINGS_MAIN --> NOTIF_PREFS["Notification Preferences"]
    SETTINGS_MAIN --> LANG_SELECT["Language Selection"]
    SETTINGS_MAIN --> THEME_SELECT["Theme Selection"]
    SETTINGS_MAIN --> FAQ_LIST["FAQ List"]
    SETTINGS_MAIN --> ABOUT_SCREEN["About Screen"]
    SETTINGS_MAIN --> ACCOUNT_DATA["Account & Data"]
    SETTINGS_MAIN --> LOGOUT_TAP["Tap Logout"]

    %% ============================================================
    %% SECURITY SETTINGS
    %% ============================================================
    SEC_SETTINGS --> CHANGE_PIN["Change PIN"]
    SEC_SETTINGS --> BIOMETRIC_TOGGLE["Biometric Authentication"]
    SEC_SETTINGS --> TWO_FA["Two-Factor Authentication"]

    %% -- Change PIN Flow --
    CHANGE_PIN --> ENTER_CURRENT_PIN["Enter Current PIN"]
    ENTER_CURRENT_PIN --> PIN_VALID{PIN Correct?}
    PIN_VALID -- Yes --> ENTER_NEW_PIN["Enter New PIN"]
    PIN_VALID -- No --> PIN_ERROR["Error: Incorrect PIN
    Retry or Cancel"]
    PIN_ERROR --> ENTER_CURRENT_PIN
    PIN_ERROR --> SEC_SETTINGS

    ENTER_NEW_PIN --> CONFIRM_NEW_PIN["Confirm New PIN"]
    CONFIRM_NEW_PIN --> PIN_MATCH{PINs Match?}
    PIN_MATCH -- Yes --> PIN_CHANGE_API["PUT /self/user
    Update PIN via Fineract"]
    PIN_MATCH -- No --> PIN_MISMATCH_ERR["Error: PINs do not match"]
    PIN_MISMATCH_ERR --> ENTER_NEW_PIN

    PIN_CHANGE_API --> PIN_API_RESULT{API Success?}
    PIN_API_RESULT -- Yes --> PIN_SUCCESS["PIN Changed Successfully"]
    PIN_API_RESULT -- No --> PIN_API_ERROR["Error: Failed to update PIN
    Check connection"]
    PIN_SUCCESS --> SEC_SETTINGS
    PIN_API_ERROR --> ENTER_NEW_PIN

    %% -- Biometric Toggle Flow --
    BIOMETRIC_TOGGLE --> BIO_AVAILABLE{Biometric
    Hardware Available?}
    BIO_AVAILABLE -- No --> BIO_UNAVAILABLE["Biometric Not Available
    on This Device"]
    BIO_UNAVAILABLE --> SEC_SETTINGS

    BIO_AVAILABLE -- Yes --> BIO_ENROLLED{Biometric
    Enrolled on Device?}
    BIO_ENROLLED -- No --> BIO_ENROLL_PROMPT["Prompt: Enroll biometrics
    in device settings"]
    BIO_ENROLL_PROMPT --> SEC_SETTINGS

    BIO_ENROLLED -- Yes --> BIO_CURRENT_STATE{Currently
    Enabled?}
    BIO_CURRENT_STATE -- "Enabling" --> BIO_VERIFY_PIN["Verify PIN to Enable"]
    BIO_CURRENT_STATE -- "Disabling" --> BIO_CONFIRM_DISABLE["Confirm Disable Biometric"]

    BIO_VERIFY_PIN --> BIO_PIN_OK{PIN Valid?}
    BIO_PIN_OK -- Yes --> BIO_PROMPT_SCAN["Scan Fingerprint / Face"]
    BIO_PIN_OK -- No --> BIO_PIN_ERR["Error: Incorrect PIN"]
    BIO_PIN_ERR --> BIO_VERIFY_PIN

    BIO_PROMPT_SCAN --> BIO_SCAN_OK{Scan Success?}
    BIO_SCAN_OK -- Yes --> BIO_ENABLED["Biometric Enabled
    Save preference locally"]
    BIO_SCAN_OK -- No --> BIO_SCAN_FAIL["Scan Failed - Retry"]
    BIO_SCAN_FAIL --> BIO_PROMPT_SCAN
    BIO_ENABLED --> SEC_SETTINGS

    BIO_CONFIRM_DISABLE --> BIO_DISABLE_CHOICE{Confirm?}
    BIO_DISABLE_CHOICE -- Yes --> BIO_DISABLED["Biometric Disabled"]
    BIO_DISABLE_CHOICE -- No --> SEC_SETTINGS
    BIO_DISABLED --> SEC_SETTINGS

    %% -- Two-Factor Authentication Flow --
    TWO_FA --> TWO_FA_STATUS{2FA Currently
    Enabled?}
    TWO_FA_STATUS -- No --> TWO_FA_SETUP["2FA Setup Screen
    Choose method:
    - SMS
    - Authenticator App"]
    TWO_FA_STATUS -- Yes --> TWO_FA_MANAGE["Manage 2FA
    - Change method
    - Disable 2FA"]

    TWO_FA_SETUP --> TWO_FA_METHOD{Method?}
    TWO_FA_METHOD -- SMS --> TWO_FA_SMS_VERIFY["Send SMS Code
    POST /twofactor via Fineract"]
    TWO_FA_METHOD -- "Authenticator" --> TWO_FA_QR["Display QR Code
    for Authenticator App"]

    TWO_FA_SMS_VERIFY --> TWO_FA_ENTER_CODE["Enter Verification Code"]
    TWO_FA_QR --> TWO_FA_ENTER_CODE

    TWO_FA_ENTER_CODE --> TWO_FA_VERIFY{Code Valid?}
    TWO_FA_VERIFY -- Yes --> TWO_FA_ENABLED["2FA Enabled Successfully
    POST /twofactor/validate"]
    TWO_FA_VERIFY -- No --> TWO_FA_CODE_ERR["Error: Invalid Code"]
    TWO_FA_CODE_ERR --> TWO_FA_ENTER_CODE
    TWO_FA_ENABLED --> SEC_SETTINGS

    TWO_FA_MANAGE --> TWO_FA_DISABLE_TAP["Tap Disable 2FA"]
    TWO_FA_DISABLE_TAP --> TWO_FA_CONFIRM_DISABLE["Confirm: Disable 2FA?
    This reduces account security."]
    TWO_FA_CONFIRM_DISABLE --> TWO_FA_DISABLE_CHOICE{Confirm?}
    TWO_FA_DISABLE_CHOICE -- Yes --> TWO_FA_VERIFY_IDENTITY["Verify PIN / Current 2FA Code"]
    TWO_FA_DISABLE_CHOICE -- No --> TWO_FA_MANAGE
    TWO_FA_VERIFY_IDENTITY --> TWO_FA_DISABLED["2FA Disabled
    DELETE /twofactor"]
    TWO_FA_DISABLED --> SEC_SETTINGS

    %% ============================================================
    %% NOTIFICATION PREFERENCES
    %% ============================================================
    NOTIF_PREFS --> NOTIF_LOAD["GET /notifications/preferences
    Load current preferences"]
    NOTIF_LOAD --> NOTIF_SCREEN["Notification Preferences Screen
    --------------------------------
    Toggle per category:
    - Transaction Alerts
    - Payment Reminders
    - Promotional Offers
    - Security Alerts
    - Account Updates
    --------------------------------
    Master Push Toggle"]

    NOTIF_SCREEN --> NOTIF_MASTER_OFF{Master Toggle
    Turned Off?}
    NOTIF_MASTER_OFF -- Yes --> NOTIF_CONFIRM_OFF["Confirm: Disable all
    push notifications?"]
    NOTIF_CONFIRM_OFF --> NOTIF_OFF_CHOICE{Confirm?}
    NOTIF_OFF_CHOICE -- Yes --> NOTIF_ALL_OFF["All Notifications Disabled
    PUT /notifications/preferences"]
    NOTIF_OFF_CHOICE -- No --> NOTIF_SCREEN
    NOTIF_ALL_OFF --> SETTINGS_MAIN

    NOTIF_MASTER_OFF -- No --> NOTIF_TOGGLE_CAT["Toggle Individual Category"]
    NOTIF_TOGGLE_CAT --> NOTIF_SAVE["Save Preference
    PUT /notifications/preferences"]
    NOTIF_SAVE --> NOTIF_SAVED["Preference Updated"]
    NOTIF_SAVED --> NOTIF_SCREEN

    %% ============================================================
    %% LANGUAGE SELECTION
    %% ============================================================
    LANG_SELECT --> LANG_SCREEN["Language Selection Screen
    ----------------------------
    - English (default)
    - Spanish
    - French
    - Arabic
    - Hindi
    - Swahili
    - More...
    ----------------------------
    Current: highlighted"]

    LANG_SCREEN --> LANG_PICK["Select Language"]
    LANG_PICK --> LANG_CONFIRM["Confirm: Change language?
    App will restart."]
    LANG_CONFIRM --> LANG_CHOICE{Confirm?}
    LANG_CHOICE -- Yes --> LANG_APPLY["Apply Language
    Save to local preferences
    Restart UI"]
    LANG_CHOICE -- No --> LANG_SCREEN
    LANG_APPLY --> SETTINGS_MAIN

    %% ============================================================
    %% THEME SELECTION
    %% ============================================================
    THEME_SELECT --> THEME_SCREEN["Theme Selection Screen
    -------------------------
    - Light
    - Dark
    - System Default
    -------------------------
    Current: highlighted"]

    THEME_SCREEN --> THEME_PICK["Select Theme"]
    THEME_PICK --> THEME_APPLY["Apply Theme
    Save to local preferences
    Update UI immediately"]
    THEME_APPLY --> SETTINGS_MAIN

    %% ============================================================
    %% FAQ FLOW
    %% ============================================================
    FAQ_LIST --> FAQ_LOAD["Load FAQ Data
    GET /faq or local cache"]
    FAQ_LOAD --> FAQ_SCREEN["FAQ List Screen
    ----------------------
    Search bar at top
    Categorized FAQ items:
    - Account
    - Payments
    - Security
    - General"]

    FAQ_SCREEN --> FAQ_SEARCH["Search FAQs"]
    FAQ_SEARCH --> FAQ_RESULTS{Results Found?}
    FAQ_RESULTS -- Yes --> FAQ_FILTERED["Filtered FAQ List"]
    FAQ_RESULTS -- No --> FAQ_NO_RESULTS["No results found
    Try different keywords"]
    FAQ_NO_RESULTS --> FAQ_SCREEN
    FAQ_FILTERED --> FAQ_TAP_ITEM["Tap FAQ Item"]

    FAQ_SCREEN --> FAQ_TAP_ITEM
    FAQ_TAP_ITEM --> FAQ_DETAIL["FAQ Detail Screen
    ----------------------
    Question (title)
    Answer (rich text)
    Related FAQs
    'Was this helpful?' prompt"]

    FAQ_DETAIL --> FAQ_HELPFUL{Was This Helpful?}
    FAQ_HELPFUL -- Yes --> FAQ_THANKS["Thank you for feedback"]
    FAQ_HELPFUL -- No --> FAQ_CONTACT["Show Contact Support option"]
    FAQ_THANKS --> FAQ_DETAIL
    FAQ_CONTACT --> FAQ_DETAIL

    FAQ_DETAIL --> FAQ_BACK["Back to FAQ List"]
    FAQ_BACK --> FAQ_SCREEN
    FAQ_DETAIL --> FAQ_RELATED["Tap Related FAQ"]
    FAQ_RELATED --> FAQ_DETAIL

    %% ============================================================
    %% ABOUT SCREEN
    %% ============================================================
    ABOUT_SCREEN --> ABOUT_DISPLAY["About Screen
    ----------------------
    App Name: Mifos Mobile Wallet
    Version: x.y.z
    Build: nnn
    ----------------------
    - Open Source Licenses
    - Terms of Service
    - Privacy Policy
    - Contact Support"]

    ABOUT_DISPLAY --> LICENSES_TAP["Tap Open Source Licenses"]
    LICENSES_TAP --> LICENSES_SCREEN["Licenses Screen
    List of OSS dependencies
    with license text"]
    LICENSES_SCREEN --> ABOUT_DISPLAY

    ABOUT_DISPLAY --> TERMS_TAP["Tap Terms of Service"]
    TERMS_TAP --> TERMS_SCREEN["Terms of Service
    (WebView or rich text)"]
    TERMS_SCREEN --> ABOUT_DISPLAY

    ABOUT_DISPLAY --> PRIVACY_TAP["Tap Privacy Policy"]
    PRIVACY_TAP --> PRIVACY_SCREEN["Privacy Policy
    (WebView or rich text)"]
    PRIVACY_SCREEN --> ABOUT_DISPLAY

    ABOUT_DISPLAY --> CONTACT_TAP["Tap Contact Support"]
    CONTACT_TAP --> CONTACT_SCREEN["Contact Support
    - Email
    - In-app chat
    - Phone"]
    CONTACT_SCREEN --> ABOUT_DISPLAY

    %% ============================================================
    %% ACCOUNT & DATA (GDPR)
    %% ============================================================
    ACCOUNT_DATA --> ACCOUNT_SCREEN["Account & Data Screen
    ----------------------------
    - Export My Data
    - Delete My Account"]

    ACCOUNT_SCREEN --> DATA_EXPORT_TAP["Tap Export My Data"]
    DATA_EXPORT_TAP --> DATA_EXPORT_CONFIRM["Confirm: Export all
    your account data?
    You will receive a
    downloadable file."]
    DATA_EXPORT_CONFIRM --> EXPORT_CHOICE{Confirm?}
    EXPORT_CHOICE -- Yes --> EXPORT_AUTH["Verify Identity
    Enter PIN"]
    EXPORT_CHOICE -- No --> ACCOUNT_SCREEN

    EXPORT_AUTH --> EXPORT_AUTH_OK{PIN Valid?}
    EXPORT_AUTH_OK -- Yes --> EXPORT_REQUEST["POST /self/data-export
    Request data export"]
    EXPORT_AUTH_OK -- No --> EXPORT_AUTH_ERR["Error: Incorrect PIN"]
    EXPORT_AUTH_ERR --> EXPORT_AUTH

    EXPORT_REQUEST --> EXPORT_API{API Success?}
    EXPORT_API -- Yes --> EXPORT_PROCESSING["Data Export Processing
    You will be notified
    when ready to download."]
    EXPORT_API -- No --> EXPORT_API_ERR["Error: Export request failed
    Try again later"]
    EXPORT_PROCESSING --> ACCOUNT_SCREEN
    EXPORT_API_ERR --> ACCOUNT_SCREEN

    ACCOUNT_SCREEN --> DELETE_TAP["Tap Delete My Account"]
    DELETE_TAP --> DELETE_WARNING["WARNING: Account Deletion
    ================================
    This action is IRREVERSIBLE.
    All your data will be
    permanently deleted.
    - Transaction history
    - Saved beneficiaries
    - Wallet balance (must be 0)
    ================================"]

    DELETE_WARNING --> DELETE_BALANCE_CHECK{Wallet Balance
    is Zero?}
    DELETE_BALANCE_CHECK -- No --> DELETE_BALANCE_ERR["Cannot delete account.
    Please withdraw or transfer
    remaining balance first."]
    DELETE_BALANCE_ERR --> ACCOUNT_SCREEN

    DELETE_BALANCE_CHECK -- Yes --> DELETE_CONFIRM_1["Type 'DELETE' to confirm"]
    DELETE_CONFIRM_1 --> DELETE_TEXT_MATCH{Text Matches
    'DELETE'?}
    DELETE_TEXT_MATCH -- No --> DELETE_TEXT_ERR["Text does not match.
    Type exactly: DELETE"]
    DELETE_TEXT_ERR --> DELETE_CONFIRM_1

    DELETE_TEXT_MATCH -- Yes --> DELETE_AUTH["Verify Identity
    Enter PIN"]
    DELETE_AUTH --> DELETE_AUTH_OK{PIN Valid?}
    DELETE_AUTH_OK -- No --> DELETE_AUTH_ERR["Error: Incorrect PIN"]
    DELETE_AUTH_ERR --> DELETE_AUTH
    DELETE_AUTH_OK -- Yes --> DELETE_FINAL_CONFIRM["Final Confirmation Dialog
    Are you absolutely sure?
    [Cancel] [Delete Permanently]"]

    DELETE_FINAL_CONFIRM --> DELETE_FINAL_CHOICE{Confirmed?}
    DELETE_FINAL_CHOICE -- No --> ACCOUNT_SCREEN
    DELETE_FINAL_CHOICE -- Yes --> DELETE_API["DELETE /self/account
    via Fineract API"]

    DELETE_API --> DELETE_API_RESULT{API Success?}
    DELETE_API_RESULT -- Yes --> DELETE_SUCCESS["Account Deleted
    Clearing local data..."]
    DELETE_API_RESULT -- No --> DELETE_API_ERR["Error: Deletion failed
    Contact support"]
    DELETE_API_ERR --> ACCOUNT_SCREEN
    DELETE_SUCCESS --> EXIT_LOGIN["Login Screen"]

    %% ============================================================
    %% LOGOUT FLOW
    %% ============================================================
    LOGOUT_TAP --> LOGGED_IN_CHECK{User Logged In?}
    LOGGED_IN_CHECK -- No --> EXIT_LOGIN
    LOGGED_IN_CHECK -- Yes --> LOGOUT_CONFIRM["Logout Confirmation Dialog
    Are you sure you want
    to log out?
    [Cancel] [Logout]"]

    LOGOUT_CONFIRM --> LOGOUT_CHOICE{Confirmed?}
    LOGOUT_CHOICE -- No --> SETTINGS_MAIN
    LOGOUT_CHOICE -- Yes --> LOGOUT_PROCESS["Clear Session
    - Revoke auth token
    - Clear sensitive cache
    - POST /self/logout"]
    LOGOUT_PROCESS --> EXIT_LOGIN

    %% ============================================================
    %% EXIT POINTS
    %% ============================================================
    EXIT_LOGIN["EXIT: Login Screen"]
    EXIT_HOME["EXIT: Home Screen"]

    SETTINGS_MAIN --> BACK_HOME["Back / Navigate Up"]
    BACK_HOME --> EXIT_HOME

    %% ============================================================
    %% STYLES
    %% ============================================================
    classDef entryPoint fill:#4CAF50,stroke:#2E7D32,color:#fff
    classDef exitPoint fill:#F44336,stroke:#C62828,color:#fff
    classDef screen fill:#2196F3,stroke:#1565C0,color:#fff
    classDef decision fill:#FF9800,stroke:#E65100,color:#fff
    classDef error fill:#FFCDD2,stroke:#E53935,color:#333
    classDef success fill:#C8E6C9,stroke:#43A047,color:#333
    classDef destructive fill:#D32F2F,stroke:#B71C1C,color:#fff

    class EP_PROFILE,EP_HOME entryPoint
    class EXIT_LOGIN,EXIT_HOME exitPoint
    class SETTINGS_MAIN,SEC_SETTINGS,NOTIF_SCREEN,LANG_SCREEN,THEME_SCREEN,FAQ_SCREEN,FAQ_DETAIL,ABOUT_DISPLAY,ACCOUNT_SCREEN,LICENSES_SCREEN,TERMS_SCREEN,PRIVACY_SCREEN,CONTACT_SCREEN screen
    class PIN_VALID,PIN_MATCH,BIO_AVAILABLE,BIO_ENROLLED,BIO_CURRENT_STATE,BIO_PIN_OK,BIO_SCAN_OK,BIO_DISABLE_CHOICE,TWO_FA_STATUS,TWO_FA_METHOD,TWO_FA_VERIFY,TWO_FA_DISABLE_CHOICE,NOTIF_MASTER_OFF,NOTIF_OFF_CHOICE,LANG_CHOICE,FAQ_RESULTS,FAQ_HELPFUL,LOGGED_IN_CHECK,LOGOUT_CHOICE,EXPORT_CHOICE,EXPORT_AUTH_OK,EXPORT_API,DELETE_BALANCE_CHECK,DELETE_TEXT_MATCH,DELETE_AUTH_OK,DELETE_FINAL_CHOICE,DELETE_API_RESULT,PIN_API_RESULT decision
    class PIN_ERROR,PIN_MISMATCH_ERR,BIO_UNAVAILABLE,BIO_PIN_ERR,BIO_SCAN_FAIL,TWO_FA_CODE_ERR,FAQ_NO_RESULTS,PIN_API_ERROR,EXPORT_AUTH_ERR,EXPORT_API_ERR,DELETE_BALANCE_ERR,DELETE_TEXT_ERR,DELETE_AUTH_ERR,DELETE_API_ERR error
    class PIN_SUCCESS,BIO_ENABLED,TWO_FA_ENABLED,NOTIF_SAVED,FAQ_THANKS,EXPORT_PROCESSING,DELETE_SUCCESS success
    class DELETE_WARNING,DELETE_CONFIRM_1,DELETE_FINAL_CONFIRM,DELETE_API destructive
