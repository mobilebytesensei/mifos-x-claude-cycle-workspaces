%% Flow: main-navigation
%% Version: 1.0
%% Created: 2026-03-18
%% Generated by: /flow-generate --from-features
%%
%% Features: home, accounts, finance, notification
%% Screens: SplashScreen, HomeScreen, AccountsScreen, AccountDetailScreen,
%%          FinanceOverviewScreen, NotificationCenterScreen, ErrorScreen
%% Entry Points: App Launch, Push Notification, Deep Link
%% Exit Points: Logout, Feature Screens (Payments, Profile, Settings)

flowchart TD
    %% ===== ENTRY POINTS =====
    EP_LAUNCH([App Launch])
    EP_PUSH([Push Notification])
    EP_DEEP([Deep Link])

    %% ===== SPLASH =====
    EP_LAUNCH --> SPLASH[Splash Screen]
    SPLASH --> AUTH_CHECK{Authenticated?}
    AUTH_CHECK -- No --> EXIT_LOGIN([Exit: Login Screen])
    AUTH_CHECK -- Yes --> TOKEN_VALID{Token Valid?}
    TOKEN_VALID -- No --> REFRESH_TOKEN[Refresh Auth Token]
    REFRESH_TOKEN --> REFRESH_OK{Refresh Success?}
    REFRESH_OK -- Yes --> HOME_LOAD
    REFRESH_OK -- No --> EXIT_LOGIN
    TOKEN_VALID -- Yes --> HOME_LOAD

    %% ===== PUSH NOTIFICATION ENTRY =====
    EP_PUSH --> PUSH_AUTH{Authenticated?}
    PUSH_AUTH -- No --> EXIT_LOGIN
    PUSH_AUTH -- Yes --> PUSH_TYPE{Notification Type?}
    PUSH_TYPE -- Transaction Alert --> NOTIF_CENTER_LOAD
    PUSH_TYPE -- Account Update --> ACCOUNT_DETAIL_LOAD
    PUSH_TYPE -- General --> HOME_LOAD

    %% ===== DEEP LINK ENTRY =====
    EP_DEEP --> DEEP_AUTH{Authenticated?}
    DEEP_AUTH -- No --> EXIT_LOGIN
    DEEP_AUTH -- Yes --> DEEP_ROUTE{Route Target?}
    DEEP_ROUTE -- /home --> HOME_LOAD
    DEEP_ROUTE -- /accounts/:id --> ACCOUNT_DETAIL_LOAD
    DEEP_ROUTE -- /finance --> FINANCE_LOAD
    DEEP_ROUTE -- /notifications --> NOTIF_CENTER_LOAD
    DEEP_ROUTE -- Unknown --> HOME_LOAD

    %% ===== HOME SCREEN =====
    HOME_LOAD[/Fetch Home Data\nGET /self/clients\nGET /self/accounts/]
    HOME_LOAD --> HOME_STATE{Response?}
    HOME_STATE -- Loading --> HOME_LOADING[Home: Loading Skeleton]
    HOME_LOADING --> HOME_STATE
    HOME_STATE -- Success --> HAS_ACCOUNTS{Has Accounts?}
    HOME_STATE -- Error --> HOME_ERROR[Home: Error State]
    HOME_ERROR --> HOME_RETRY{Retry?}
    HOME_RETRY -- Yes --> HOME_LOAD
    HOME_RETRY -- No --> HOME_ERROR

    HAS_ACCOUNTS -- Yes --> HOME_SUCCESS[Home Screen\nAccount Pager + Summary]
    HAS_ACCOUNTS -- No --> HOME_EMPTY[Home: Empty State\nNo Accounts Found]
    HOME_EMPTY --> NAV_ACCOUNTS_TAB

    %% ===== HOME SCREEN INTERACTIONS =====
    HOME_SUCCESS --> HOME_PULL_REFRESH{Pull to Refresh?}
    HOME_PULL_REFRESH -- Yes --> HOME_LOAD
    HOME_PULL_REFRESH -- No --> HOME_ACTIONS

    HOME_ACTIONS{User Action?}
    HOME_SUCCESS --> HOME_ACTIONS
    HOME_ACTIONS -- Swipe Account Pager --> PAGER_SWITCH
    HOME_ACTIONS -- Tap Account Card --> ACCOUNT_DETAIL_LOAD
    HOME_ACTIONS -- Tap Notification Bell --> NOTIF_CENTER_LOAD
    HOME_ACTIONS -- Bottom Nav: Accounts --> NAV_ACCOUNTS_TAB
    HOME_ACTIONS -- Bottom Nav: Payments --> EXIT_PAYMENTS([Exit: Payments Screen])
    HOME_ACTIONS -- Bottom Nav: Profile --> EXIT_PROFILE([Exit: Profile Screen])

    %% ===== ACCOUNT PAGER =====
    PAGER_SWITCH{Pager Tab?}
    PAGER_SWITCH -- Savings --> PAGER_SAVINGS[Savings Accounts List\nGET /self/savingsaccounts]
    PAGER_SWITCH -- Loans --> PAGER_LOANS[Loan Accounts List\nGET /self/loanaccounts]
    PAGER_SWITCH -- Shares --> PAGER_SHARES[Share Accounts List\nGET /self/shareaccounts]
    PAGER_SAVINGS --> HOME_ACTIONS
    PAGER_LOANS --> HOME_ACTIONS
    PAGER_SHARES --> HOME_ACTIONS

    %% ===== ACCOUNTS SCREEN (Bottom Nav Tab) =====
    NAV_ACCOUNTS_TAB[/Fetch All Accounts\nGET /self/savingsaccounts\nGET /self/loanaccounts\nGET /self/shareaccounts/]
    NAV_ACCOUNTS_TAB --> ACCOUNTS_STATE{Response?}
    ACCOUNTS_STATE -- Loading --> ACCOUNTS_LOADING[Accounts: Loading Skeleton]
    ACCOUNTS_LOADING --> ACCOUNTS_STATE
    ACCOUNTS_STATE -- Success --> ACCOUNTS_HAS_DATA{Has Accounts?}
    ACCOUNTS_STATE -- Error --> ACCOUNTS_ERROR[Accounts: Error State]
    ACCOUNTS_ERROR --> ACCOUNTS_RETRY{Retry?}
    ACCOUNTS_RETRY -- Yes --> NAV_ACCOUNTS_TAB
    ACCOUNTS_RETRY -- No --> ACCOUNTS_ERROR

    ACCOUNTS_HAS_DATA -- Yes --> ACCOUNTS_SUCCESS[Accounts Screen\nFiltered by Type Tabs]
    ACCOUNTS_HAS_DATA -- No --> ACCOUNTS_EMPTY[Accounts: Empty State\nNo accounts to display]

    ACCOUNTS_SUCCESS --> ACCOUNTS_PULL_REFRESH{Pull to Refresh?}
    ACCOUNTS_PULL_REFRESH -- Yes --> NAV_ACCOUNTS_TAB
    ACCOUNTS_PULL_REFRESH -- No --> ACCOUNTS_ACTIONS

    ACCOUNTS_ACTIONS{User Action?}
    ACCOUNTS_SUCCESS --> ACCOUNTS_ACTIONS
    ACCOUNTS_ACTIONS -- Tap Account Row --> ACCOUNT_DETAIL_LOAD
    ACCOUNTS_ACTIONS -- Filter by Type --> ACCOUNTS_FILTER[Apply Type Filter\nSavings / Loans / Shares / All]
    ACCOUNTS_FILTER --> ACCOUNTS_SUCCESS
    ACCOUNTS_ACTIONS -- Bottom Nav: Home --> HOME_LOAD
    ACCOUNTS_ACTIONS -- Bottom Nav: Payments --> EXIT_PAYMENTS
    ACCOUNTS_ACTIONS -- Bottom Nav: Profile --> EXIT_PROFILE

    %% ===== ACCOUNT DETAIL =====
    ACCOUNT_DETAIL_LOAD[/Fetch Account Detail\nGET /self/{type}accounts/{id}/]
    ACCOUNT_DETAIL_LOAD --> DETAIL_STATE{Response?}
    DETAIL_STATE -- Loading --> DETAIL_LOADING[Detail: Loading Skeleton]
    DETAIL_LOADING --> DETAIL_STATE
    DETAIL_STATE -- Success --> DETAIL_SUCCESS[Account Detail Screen\nBalance, Status, Transactions]
    DETAIL_STATE -- Error --> DETAIL_ERROR[Detail: Error State]
    DETAIL_ERROR --> DETAIL_RETRY{Retry?}
    DETAIL_RETRY -- Yes --> ACCOUNT_DETAIL_LOAD
    DETAIL_RETRY -- No --> DETAIL_ERROR

    DETAIL_SUCCESS --> DETAIL_PULL_REFRESH{Pull to Refresh?}
    DETAIL_PULL_REFRESH -- Yes --> ACCOUNT_DETAIL_LOAD
    DETAIL_PULL_REFRESH -- No --> DETAIL_ACTIONS

    DETAIL_ACTIONS{User Action?}
    DETAIL_SUCCESS --> DETAIL_ACTIONS
    DETAIL_ACTIONS -- View Transaction --> EXIT_TRANSACTION([Exit: Transaction Detail])
    DETAIL_ACTIONS -- Make Transfer --> EXIT_PAYMENTS
    DETAIL_ACTIONS -- Back --> BACK_FROM_DETAIL{Came From?}
    BACK_FROM_DETAIL -- Home --> HOME_LOAD
    BACK_FROM_DETAIL -- Accounts Tab --> NAV_ACCOUNTS_TAB
    BACK_FROM_DETAIL -- Deep Link --> HOME_LOAD

    %% ===== FINANCE OVERVIEW =====
    FINANCE_LOAD[/Fetch Finance Data\nGET /self/savingsaccounts\nGET /self/clients/{id}/transactions/]
    FINANCE_LOAD --> FINANCE_STATE{Response?}
    FINANCE_STATE -- Loading --> FINANCE_LOADING[Finance: Loading Skeleton]
    FINANCE_LOADING --> FINANCE_STATE
    FINANCE_STATE -- Success --> FINANCE_HAS_DATA{Has Financial Data?}
    FINANCE_STATE -- Error --> FINANCE_ERROR[Finance: Error State]
    FINANCE_ERROR --> FINANCE_RETRY{Retry?}
    FINANCE_RETRY -- Yes --> FINANCE_LOAD
    FINANCE_RETRY -- No --> FINANCE_ERROR

    FINANCE_HAS_DATA -- Yes --> FINANCE_SUCCESS[Finance Overview\nBalance Summary + Recent Transactions]
    FINANCE_HAS_DATA -- No --> FINANCE_EMPTY[Finance: Empty State\nNo financial activity yet]

    FINANCE_SUCCESS --> FINANCE_PULL_REFRESH{Pull to Refresh?}
    FINANCE_PULL_REFRESH -- Yes --> FINANCE_LOAD
    FINANCE_PULL_REFRESH -- No --> FINANCE_ACTIONS

    FINANCE_ACTIONS{User Action?}
    FINANCE_SUCCESS --> FINANCE_ACTIONS
    FINANCE_ACTIONS -- Tap Transaction --> EXIT_TRANSACTION
    FINANCE_ACTIONS -- Tap Account Summary --> ACCOUNT_DETAIL_LOAD
    FINANCE_ACTIONS -- Bottom Nav: Home --> HOME_LOAD
    FINANCE_ACTIONS -- Bottom Nav: Accounts --> NAV_ACCOUNTS_TAB
    FINANCE_ACTIONS -- Bottom Nav: Payments --> EXIT_PAYMENTS
    FINANCE_ACTIONS -- Bottom Nav: Profile --> EXIT_PROFILE

    %% ===== NOTIFICATION CENTER =====
    NOTIF_CENTER_LOAD[/Fetch Notifications\nGET /self/notifications/]
    NOTIF_CENTER_LOAD --> NOTIF_STATE{Response?}
    NOTIF_STATE -- Loading --> NOTIF_LOADING[Notifications: Loading Skeleton]
    NOTIF_LOADING --> NOTIF_STATE
    NOTIF_STATE -- Success --> HAS_NOTIFS{Has Notifications?}
    NOTIF_STATE -- Error --> NOTIF_ERROR[Notifications: Error State]
    NOTIF_ERROR --> NOTIF_RETRY{Retry?}
    NOTIF_RETRY -- Yes --> NOTIF_CENTER_LOAD
    NOTIF_RETRY -- No --> NOTIF_ERROR

    HAS_NOTIFS -- Yes --> NOTIF_SUCCESS[Notification Center\nAlerts + Transaction Notifications]
    HAS_NOTIFS -- No --> NOTIF_EMPTY[Notifications: Empty State\nNo notifications yet]

    NOTIF_SUCCESS --> NOTIF_PULL_REFRESH{Pull to Refresh?}
    NOTIF_PULL_REFRESH -- Yes --> NOTIF_CENTER_LOAD
    NOTIF_PULL_REFRESH -- No --> NOTIF_ACTIONS

    NOTIF_ACTIONS{User Action?}
    NOTIF_SUCCESS --> NOTIF_ACTIONS
    NOTIF_ACTIONS -- Tap Transaction Notification --> ACCOUNT_DETAIL_LOAD
    NOTIF_ACTIONS -- Tap Alert --> NOTIF_ALERT_DETAIL[Alert Detail View]
    NOTIF_ACTIONS -- Mark All Read --> NOTIF_MARK_READ[/PUT /self/notifications\nMark All Read/]
    NOTIF_MARK_READ --> NOTIF_CENTER_LOAD
    NOTIF_ACTIONS -- Dismiss Notification --> NOTIF_DISMISS[/DELETE /self/notifications/{id}/]
    NOTIF_DISMISS --> NOTIF_CENTER_LOAD
    NOTIF_ACTIONS -- Back --> HOME_LOAD

    NOTIF_ALERT_DETAIL --> NOTIF_ACTIONS

    %% ===== BOTTOM NAVIGATION =====
    %% Bottom nav is persistent across Home, Accounts, Payments, Profile tabs.
    %% Payments and Profile are exit points to other feature domains.

    %% ===== EXIT POINTS =====
    EXIT_LOGOUT([Exit: Logout])
    HOME_ACTIONS -- Logout --> LOGOUT_CONFIRM{Confirm Logout?}
    LOGOUT_CONFIRM -- Yes --> EXIT_LOGOUT
    LOGOUT_CONFIRM -- No --> HOME_ACTIONS

    %% ===== STYLES =====
    classDef loading fill:#FFF3CD,stroke:#856404,color:#856404
    classDef error fill:#F8D7DA,stroke:#721C24,color:#721C24
    classDef empty fill:#D1ECF1,stroke:#0C5460,color:#0C5460
    classDef success fill:#D4EDDA,stroke:#155724,color:#155724
    classDef entry fill:#CCE5FF,stroke:#004085,color:#004085
    classDef exit fill:#E2E3E5,stroke:#383D41,color:#383D41
    classDef api fill:#F5F5F5,stroke:#6C757D,color:#6C757D

    class HOME_LOADING,ACCOUNTS_LOADING,DETAIL_LOADING,FINANCE_LOADING,NOTIF_LOADING loading
    class HOME_ERROR,ACCOUNTS_ERROR,DETAIL_ERROR,FINANCE_ERROR,NOTIF_ERROR error
    class HOME_EMPTY,ACCOUNTS_EMPTY,FINANCE_EMPTY,NOTIF_EMPTY empty
    class HOME_SUCCESS,ACCOUNTS_SUCCESS,DETAIL_SUCCESS,FINANCE_SUCCESS,NOTIF_SUCCESS success
    class EP_LAUNCH,EP_PUSH,EP_DEEP entry
    class EXIT_LOGIN,EXIT_PAYMENTS,EXIT_PROFILE,EXIT_TRANSACTION,EXIT_LOGOUT exit
    class HOME_LOAD,NAV_ACCOUNTS_TAB,ACCOUNT_DETAIL_LOAD,FINANCE_LOAD,NOTIF_CENTER_LOAD,NOTIF_MARK_READ,NOTIF_DISMISS,REFRESH_TOKEN api
