---
// Base.astro — shared shell. Injects content/tokens.css (brand palette) inline, wires the
// theme toggle (persisted, no-flash), and renders Nav + Footer around the page slot.
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { loadSite } from "../lib/content.js";

const { title, description } = Astro.props;
const site = loadSite();
const brandName = site.brand?.name ?? "Products";
const pageTitle = title ? `${title} — ${brandName}` : `${brandName} — ${site.brand?.tagline ?? ""}`;
const desc = description ?? site.hero?.subhead ?? "";

const tokensPath = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../content/tokens.css");
const tokens = fs.existsSync(tokensPath) ? fs.readFileSync(tokensPath, "utf8") : "";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Material Design 3 type: Roboto Flex (display) + Roboto (body/label) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400..800&family=Roboto:wght@400;500;700&display=swap" />
    <!-- no-flash: LIGHT default; go dark only if the visitor toggled it -->
    <script is:inline>
      (function () {
        try { document.documentElement.setAttribute("data-theme", localStorage.getItem("theme") || "light"); }
        catch (e) { document.documentElement.setAttribute("data-theme", "light"); }
      })();
    </script>
    <style set:html={tokens}></style>
    <style is:global>
      :root { --maxw: 1160px; }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--md-surface); color: var(--md-on-surface);
        font-family: var(--md-font-body); line-height: 1.55;
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
        transition: background var(--md-dur-med) var(--md-ease-standard), color var(--md-dur-med) var(--md-ease-standard);
      }
      h1, h2, h3, h4 { font-family: var(--md-font-display); color: var(--md-on-surface); margin: 0; text-wrap: balance; }
      p { margin: 0; }
      a { color: var(--md-primary); text-decoration: none; }
      main { display: block; }
      section { padding-block: clamp(48px, 8vw, 96px); }
      .wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: 24px; }

      /* ── MD3 type scale ─────────────────────────────────────────────────── */
      .md-display-l { font-family: var(--md-font-display); font-weight: 700; font-size: clamp(2.6rem, 6vw, 3.6rem); line-height: 1.08; letter-spacing: -0.02em; }
      .md-display-m { font-family: var(--md-font-display); font-weight: 700; font-size: clamp(2.1rem, 4.5vw, 2.8rem); line-height: 1.12; letter-spacing: -0.015em; }
      .md-headline-l { font-family: var(--md-font-display); font-weight: 600; font-size: clamp(1.75rem, 3.6vw, 2.25rem); line-height: 1.18; letter-spacing: -0.01em; }
      .md-headline-m { font-family: var(--md-font-display); font-weight: 600; font-size: 1.5rem; line-height: 1.25; }
      .md-title-l { font-family: var(--md-font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.3; }
      .md-title-m { font-weight: 600; font-size: 1rem; line-height: 1.4; letter-spacing: 0.01em; }
      .md-body-l { font-size: 1.05rem; line-height: 1.6; color: var(--md-on-surface-variant); }
      .md-body-m { font-size: 0.95rem; line-height: 1.55; color: var(--md-on-surface-variant); }
      .md-label-l { font-weight: 500; font-size: 0.875rem; letter-spacing: 0.06em; }

      /* ── MD3 label / eyebrow (assist-chip style) ────────────────────────── */
      .eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--md-font-body); font-weight: 600; font-size: .72rem;
        letter-spacing: .1em; text-transform: uppercase;
        color: var(--md-on-secondary-container); background: var(--md-secondary-container);
        padding: 7px 14px; border-radius: var(--md-corner-sm);
      }

      /* ── MD3 buttons: state-layer overlay + shape + label ───────────────── */
      .btn {
        position: relative; overflow: hidden; isolation: isolate;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        height: 40px; padding: 0 24px; border-radius: var(--md-corner-full);
        font-family: var(--md-font-body); font-weight: 500; font-size: .875rem; letter-spacing: .04em;
        border: 1px solid transparent; cursor: pointer; user-select: none;
        transition: box-shadow var(--md-dur-short) var(--md-ease-standard),
                    background var(--md-dur-short) var(--md-ease-standard);
      }
      .btn::after {
        content: ""; position: absolute; inset: 0; z-index: -1;
        background: currentColor; opacity: 0;
        transition: opacity var(--md-dur-short) var(--md-ease-standard);
      }
      .btn:hover::after { opacity: var(--md-state-hover); }
      .btn:focus-visible::after { opacity: var(--md-state-focus); }
      .btn:active::after { opacity: var(--md-state-press); }

      /* Filled (primary) */
      .btn-primary { background: var(--md-primary); color: var(--md-on-primary); }
      .btn-primary:hover { box-shadow: var(--md-elev-1); }
      /* Filled tonal */
      .btn-tonal { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
      .btn-tonal:hover { box-shadow: var(--md-elev-1); }
      /* Outlined (was .btn-ghost) */
      .btn-ghost, .btn-outlined { background: transparent; color: var(--md-primary); border-color: var(--md-outline-variant); }
      .btn-ghost:hover, .btn-outlined:hover { border-color: var(--md-primary); }
      /* Text */
      .btn-text { background: transparent; color: var(--md-primary); padding: 0 12px; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; } body, * { transition: none !important; }
      }
      :focus-visible { outline: 3px solid color-mix(in srgb, var(--md-primary) 55%, transparent); outline-offset: 2px; border-radius: 6px; }
    </style>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        function current() {
          var explicit = document.documentElement.getAttribute("data-theme");
          if (explicit) return explicit;
          return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        window.__toggleTheme = function () {
          var next = current() === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        };
      })();
    </script>
  </body>
</html>
