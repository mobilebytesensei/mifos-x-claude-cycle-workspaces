---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ProductGrid from "../components/ProductGrid.astro";
import Community from "../components/Community.astro";
import Faq from "../components/Faq.astro";
import { loadSite } from "../lib/content.js";

// Structured data for the catalog + FAQ, from site.yaml (the FAQ is the same one rendered below).
const site = loadSite();
const faq = site.faq?.items ?? [];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: site.products_section?.head ?? "Products",
    itemListElement: (site.products ?? []).map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareApplication",
        name: p.name,
        applicationCategory: p.category,
        description: p.description,
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        ...(p.link?.href?.startsWith("http") ? { url: p.link.href } : {}),
      },
    })),
  },
  ...(faq.length ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  }] : []),
];
---
<Base jsonLd={jsonLd}>
  <Hero />
  <ProductGrid />
  <Faq />
  <Community />
</Base>
