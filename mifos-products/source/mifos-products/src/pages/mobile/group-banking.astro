---
import Base from "../../layouts/Base.astro";
import PlatformChips from "../../components/PlatformChips.astro";
import { loadSite, linkAttrs } from "../../lib/content.js";

const m = loadSite().mifossave ?? {};
const hero = m.hero ?? {};
const stats = hero.stats ?? [];
---
<Base title="MifosSave — Community banking, digitized" description={hero.subhead}>
  <article class="ms">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <a class="back" href="/mobile">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          All mobile apps
        </a>
        <div class="hero-grid">
          <div class="hcopy">
            {hero.eyebrow && <span class="pill">{hero.eyebrow}</span>}
            <h1><span class="wm">MifosSave</span><br/>{hero.head}</h1>
            {hero.subhead && <p class="subhead">{hero.subhead}</p>}
            <div class="cta-row">
              {m.site && <a class="btn solid" href={m.site} target="_blank" rel="noopener noreferrer">Visit MifosSave ↗</a>}
              {m.source && <a class="btn glass" href={m.source} target="_blank" rel="noopener noreferrer">Source on GitHub</a>}
            </div>
            <div class="reach"><PlatformChips platforms={m.platforms ?? []} size="lg" /></div>
          </div>
          {stats.length > 0 && (
            <div class="hstats">
              {stats.map((s) => (
                <div class="hstat"><div class="v">{s.value}</div><div class="l">{s.label}</div></div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    {m.problem && (
      <section class="band">
        <div class="wrap narrow">
          <span class="eyebrow">The problem</span>
          <h2>{m.problem.head}</h2>
          <p class="lead">{m.problem.body}</p>
        </div>
      </section>
    )}

    <!-- VALUES -->
    {m.values && (
      <section class="band alt">
        <div class="wrap">
          <h2 class="ctr">{m.values.head}</h2>
          <div class="cards five">
            {(m.values.items ?? []).map((v) => (
              <div class="card">
                <div class="ic">{v.icon}</div>
                <h3>{v.title}</h3>
                <p>{v.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FEATURES -->
    {m.features_section && (
      <section class="band">
        <div class="wrap">
          <header class="sec-head">
            <h2>{m.features_section.head}</h2>
            {m.features_section.subhead && <p class="sub">{m.features_section.subhead}</p>}
          </header>
          <div class="cards">
            {(m.features_section.items ?? []).map((f) => (
              <div class="card feat">
                <div class="ic sm">{f.icon}</div>
                <div><h3>{f.title}</h3><p>{f.body}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- LIFECYCLE -->
    {m.lifecycle && (
      <section class="band alt">
        <div class="wrap">
          <header class="sec-head"><h2>{m.lifecycle.head}</h2>{m.lifecycle.subhead && <p class="sub">{m.lifecycle.subhead}</p>}</header>
          <ol class="steps">
            {(m.lifecycle.steps ?? []).map((s) => (
              <li><span class="n">{s.n}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <!-- ARCHETYPES -->
    {m.archetypes && (
      <section class="band">
        <div class="wrap narrow ctr">
          <span class="eyebrow">One app, many models</span>
          <h2>{m.archetypes.head}</h2>
          <div class="chips">{(m.archetypes.items ?? []).map((a) => <span class="chip">{a}</span>)}</div>
        </div>
      </section>
    )}

    <!-- ROLES -->
    {m.roles && (
      <section class="band alt">
        <div class="wrap">
          <header class="sec-head"><h2>{m.roles.head}</h2>{m.roles.subhead && <p class="sub">{m.roles.subhead}</p>}</header>
          <div class="roles">
            {(m.roles.items ?? []).map((r) => (
              <div class="role"><span class="rname">{r.role}</span><p>{r.body}</p></div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- TECH -->
    {m.tech && (
      <section class="band">
        <div class="wrap">
          <header class="sec-head"><span class="kbadge">Kotlin Multiplatform</span><h2>{m.tech.head}</h2></header>
          <div class="cards four">
            {(m.tech.items ?? []).map((t) => (
              <div class="card"><h3>{t.title}</h3><p>{t.body}</p></div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- DEMO -->
    {m.demo && (
      <section class="band alt">
        <div class="wrap narrow">
          <header class="sec-head"><h2>{m.demo.head}</h2>{m.demo.subhead && <p class="sub">{m.demo.subhead}</p>}</header>
          <div class="demo">
            <table>
              <thead><tr><th>Role</th><th>Username</th><th>Password</th></tr></thead>
              <tbody>
                {(m.demo.credentials ?? []).map((c) => (
                  <tr><td>{c.role}</td><td><code>{c.username}</code></td><td><code>{c.password}</code></td></tr>
                ))}
              </tbody>
            </table>
            {m.demo.note && <p class="note">{m.demo.note}</p>}
            {m.demo.cta && <a class="btn solid" href={m.demo.cta.href} target="_blank" rel="noopener noreferrer">{m.demo.cta.label}</a>}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    {m.cta && (
      <section class="band">
        <div class="wrap">
          <div class="ctaband">
            <h2>{m.cta.head}</h2>
            {m.cta.subhead && <p>{m.cta.subhead}</p>}
            <div class="cta-row">
              {(m.cta.links ?? []).map((l, i) => (
                <a class={`btn ${i === 0 ? "solid" : "outline"}`} href={l.href} {...linkAttrs(l)}>{l.label}</a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  /* MifosSave brand — indigo, overrides the site brand for this page only */
  .ms { --ms: #4C56C0; --ms-2: #2A2F73; --ms-soft: #eceefb; }
  :global(:root[data-theme="dark"]) .ms { --ms: #8b93ec; --ms-soft: #1a1e42; }

  .wrap.narrow { max-width: 780px; }
  .ctr { text-align: center; }
  .eyebrow { color: var(--ms); background: var(--ms-soft); }
  .sec-head { text-align: center; display: flex; flex-direction: column; gap: 12px; align-items: center; margin-bottom: 40px; }
  .sec-head h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); }
  .band .sub, .lead { color: var(--muted); font-size: 1.05rem; }
  h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); }

  /* HERO */
  .hero { position: relative; color: #fff; padding-block: clamp(28px, 5vw, 44px) clamp(56px, 9vw, 96px);
    background: radial-gradient(600px 300px at 15% 0%, rgba(255,255,255,.12), transparent 60%),
                linear-gradient(160deg, #4C56C0 0%, #2A2F73 100%); }
  .back { display: inline-flex; align-items: center; gap: 7px; color: rgba(255,255,255,.82); font-weight: 600; font-size: .9rem; margin: 8px 0 34px; }
  .back:hover { color: #fff; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr .9fr; gap: 44px; align-items: center; }
  .pill { display: inline-block; font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    background: rgba(255,255,255,.16); color: #fff; padding: 6px 13px; border-radius: 999px; }
  .hero h1 { color: #fff; font-size: clamp(2rem, 5vw, 3.2rem); margin-top: 18px; }
  .wm { font-size: .5em; font-weight: 800; letter-spacing: .01em; opacity: .9; text-transform: uppercase; }
  .subhead { margin-top: 18px; color: rgba(255,255,255,.9); font-size: clamp(1rem, 1.8vw, 1.18rem); max-width: 620px; }
  .cta-row { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: .95rem; padding: 12px 20px; border-radius: 999px; border: 1px solid transparent; transition: transform .15s ease, background .2s ease; }
  .btn:hover { transform: translateY(-1px); }
  .btn.solid { background: #fff; color: var(--ms-2); }
  .btn.glass { background: rgba(255,255,255,.14); color: #fff; border-color: rgba(255,255,255,.4); }
  .btn.glass:hover { background: rgba(255,255,255,.22); }
  .btn.outline { background: transparent; color: var(--ms); border-color: color-mix(in srgb, var(--ms) 40%, var(--border)); }
  .btn.outline:hover { background: var(--ms-soft); }
  .reach { margin-top: 26px; }
  .hero :global(.plats li) { background: rgba(255,255,255,.15); border-color: rgba(255,255,255,.28); color: #fff; }
  .hstats { display: flex; flex-direction: column; gap: 14px; }
  .hstat { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); border-radius: 16px; padding: 18px 22px; }
  .hstat .v { font-size: 1.5rem; font-weight: 800; }
  .hstat .l { color: rgba(255,255,255,.82); font-size: .9rem; margin-top: 2px; }

  /* BANDS */
  .band { padding-block: clamp(48px, 8vw, 88px); }
  .band.alt { background: var(--surface); }

  .cards { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .cards.five { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .cards.four { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--elev-1); transition: transform .18s ease, box-shadow .18s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: var(--elev-2); }
  .card h3 { font-size: 1.08rem; margin-bottom: 8px; }
  .card p { color: var(--muted); font-size: .93rem; }
  .card .ic { width: 46px; height: 46px; display: grid; place-items: center; font-size: 1.4rem; border-radius: 12px; background: var(--ms-soft); margin-bottom: 14px; }
  .card.feat { display: flex; gap: 14px; align-items: flex-start; }
  .ic.sm { width: 42px; height: 42px; flex: none; font-size: 1.25rem; margin-bottom: 0; }

  /* STEPS */
  .steps { list-style: none; margin: 0 auto; padding: 0; max-width: 780px; display: flex; flex-direction: column; gap: 8px; }
  .steps li { display: flex; gap: 18px; align-items: flex-start; background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 18px 22px; }
  .steps .n { flex: none; width: 36px; height: 36px; display: grid; place-items: center; font-weight: 800; color: #fff; background: var(--ms); border-radius: 999px; }
  .steps h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .steps p { color: var(--muted); font-size: .93rem; }

  /* CHIPS */
  .chips { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .chip { font-weight: 700; color: var(--ms); background: var(--ms-soft); border: 1px solid color-mix(in srgb, var(--ms) 22%, var(--border)); padding: 8px 16px; border-radius: 999px; }

  /* ROLES */
  .roles { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .role { background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--ms); border-radius: 12px; padding: 18px 20px; }
  .rname { font-weight: 800; color: var(--ms); }
  .role p { color: var(--muted); margin-top: 6px; font-size: .93rem; }

  .kbadge { font-weight: 800; font-size: .78rem; color: #fff; background: var(--ms); padding: 5px 12px; border-radius: 999px; }

  /* DEMO */
  .demo { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; box-shadow: var(--elev-1); text-align: center; }
  .demo table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
  .demo th, .demo td { border: 1px solid var(--border); padding: 10px 12px; text-align: left; font-size: .92rem; }
  .demo th { background: var(--surface); font-size: .76rem; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .demo code { background: var(--surface-2); padding: 2px 7px; border-radius: 6px; font-size: .88em; }
  .demo .note { color: var(--muted); font-size: .9rem; margin-bottom: 18px; }

  /* CTA */
  .ctaband { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;
    background: linear-gradient(160deg, #4C56C0 0%, #2A2F73 100%); color: #fff; border-radius: 24px; padding: clamp(40px, 7vw, 72px); box-shadow: var(--elev-3); }
  .ctaband h2 { color: #fff; }
  .ctaband p { color: rgba(255,255,255,.88); max-width: 560px; }
  .ctaband .cta-row { justify-content: center; }

  @media (max-width: 840px) { .hero-grid { grid-template-columns: 1fr; } .hstats { flex-direction: row; flex-wrap: wrap; } .hstat { flex: 1; min-width: 140px; } }
</style>
