---
import Base from "../../layouts/Base.astro";
import PlatformChips from "../../components/PlatformChips.astro";
import { loadSite, linkAttrs } from "../../lib/content.js";

export function getStaticPaths() {
  const mobile = loadSite().mobile ?? {};
  // group-banking has a bespoke full page at /mobile/group-banking — exclude it here.
  const apps = (mobile.apps ?? []).filter((a) => a.id !== "group-banking");
  const tpl = mobile.template;
  const records = [...apps.map((a) => ({ ...a, isTemplate: false }))];
  if (tpl) records.push({ ...tpl, isTemplate: true });
  return records.map((r) => ({ params: { app: r.id }, props: { rec: r } }));
}

const { rec } = Astro.props;
const STATUS = { live: "Live", reference: "Reference", soon: "Coming soon", template: "Template" };
// Normalize primary/source links across app records (site + source) and the template (github).
const primary = rec.site ?? (rec.github ? { label: "View on GitHub", href: rec.github, external: true } : null);
const source = rec.source ?? rec.github ?? null;
const eyebrow = rec.label ?? rec.category;
const accent = rec.accent ?? "brand";
const highlights = rec.highlights ?? [];
const body = rec.long_description ?? rec.description ?? "";
---
<Base title={rec.name} description={rec.tagline ?? rec.description}>
  <article class={`detail accent-${accent}`}>
    <div class="wrap">
      <a class="back" href="/mobile">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        All mobile apps
      </a>

      <header class="head">
        <div class="icon" aria-hidden="true">{rec.icon ?? "📱"}</div>
        <div class="titles">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1>{rec.name}{rec.brand ? <span class="as"> · {rec.brand}</span> : null}</h1>
          {rec.tagline && <p class="tagline">{rec.tagline}</p>}
          <div class="meta">
            {rec.status && <span class={`status s-${rec.status}`}>{STATUS[rec.status] ?? rec.status}</span>}
            <PlatformChips platforms={rec.platforms ?? []} size="sm" />
          </div>
        </div>
      </header>

      <div class="cta-row">
        {primary && (
          <a class={`btn ${primary.pending ? "btn-ghost" : "btn-primary"}`} href={primary.href} {...linkAttrs(primary)}>
            {primary.label}
          </a>
        )}
        {source && (
          <a class="btn btn-ghost" href={source} target="_blank" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
            Source
          </a>
        )}
      </div>

      <div class="grid">
        <section class="body">
          <h2>Overview</h2>
          <p>{body}</p>
          {rec.isTemplate && (
            <p class="note">
              <strong>White-label pattern:</strong> the shell is generic; a per-project
              customizer stamps identity and branding, so one template powers every Mifos
              app — the same way <a href="/mobile/group-banking">Group Banking</a> ships publicly as MifosSave.
            </p>
          )}
        </section>

        {highlights.length > 0 && (
          <aside class="side">
            <h3>{rec.isTemplate ? "What's included" : "Highlights"}</h3>
            <ul class="checks">
              {highlights.map((h) => (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  <span set:html={h.replace(/`([^`]+)`/g, '<code>$1</code>')}></span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>

      <div class="kmp-note">
        <span class="kbadge">Kotlin Multiplatform</span>
        Built with Compose Multiplatform — shared UI and logic across Android, iOS, Desktop, and Web, wired to the Mifos X core.
      </div>
    </div>
  </article>
</Base>

<style>
  .detail { --a: var(--brand); --a-c: var(--brand-container); padding-block: clamp(32px, 6vw, 64px); }
  .accent-teal { --a: var(--teal); --a-c: var(--teal-container); }
  .accent-amber { --a: var(--amber); --a-c: var(--amber-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); }
  .back { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-weight: 600; font-size: .9rem; margin-bottom: 28px; }
  .back:hover { color: var(--text); }
  .head { display: flex; gap: 20px; align-items: flex-start; }
  .icon { width: 68px; height: 68px; flex: none; display: grid; place-items: center; font-size: 2rem; border-radius: 18px; background: var(--a-c); }
  .titles h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin-top: 8px; }
  .as { color: var(--a); }
  .tagline { margin-top: 10px; font-size: 1.15rem; color: var(--muted); }
  .meta { margin-top: 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .status { font-size: .68rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; }
  .s-live { color: #0a7d3c; background: #d8f3e3; }
  .s-reference, .s-template { color: var(--muted); background: var(--surface); }
  :global(:root[data-theme="dark"]) .s-live { color: #7ee7a8; background: #12351f; }

  .cta-row { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; }
  .cta-row .btn-primary { background: var(--a); }

  .grid { margin-top: 44px; display: grid; grid-template-columns: 1.6fr 1fr; gap: 32px; align-items: start; }
  .body h2 { font-size: 1.4rem; margin-bottom: 14px; }
  .body p { color: var(--muted); font-size: 1.02rem; margin-bottom: 16px; }
  .note { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--a); border-radius: 12px; padding: 16px 18px; }
  .note a { color: var(--a); text-decoration: underline; text-underline-offset: 3px; }
  .side { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--elev-1); }
  .side h3 { font-size: 1.05rem; margin-bottom: 14px; }
  .checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .checks li { display: flex; gap: 10px; align-items: flex-start; font-size: .95rem; color: var(--text); }
  .checks svg { flex: none; margin-top: 2px; color: var(--a); }
  .checks :global(code) { background: var(--surface-2); padding: 1px 6px; border-radius: 6px; font-size: .88em; }

  .kmp-note { margin-top: 44px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    background: var(--brand-container); border-radius: 16px; padding: 18px 22px; color: var(--muted); font-size: .95rem; }
  .kbadge { font-weight: 800; font-size: .78rem; color: var(--brand-on); background: var(--brand); padding: 5px 12px; border-radius: 999px; }

  @media (max-width: 780px) { .grid { grid-template-columns: 1fr; } }
</style>
