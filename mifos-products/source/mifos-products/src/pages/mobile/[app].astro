---
import Base from "../../layouts/Base.astro";
import AppHero from "../../components/AppHero.astro";
import AppOverview from "../../components/AppOverview.astro";
import AppProblem from "../../components/AppProblem.astro";
import AppFeatureGrid from "../../components/AppFeatureGrid.astro";
import AppTechStrip from "../../components/AppTechStrip.astro";
import AppDownloads from "../../components/AppDownloads.astro";
import AppHighlights from "../../components/AppHighlights.astro";
import { loadSite } from "../../lib/content.js";

export function getStaticPaths() {
  const mobile = loadSite().mobile ?? {};
  // group-banking has a bespoke full page at /mobile/group-banking — exclude it here.
  const apps = (mobile.apps ?? []).filter((a) => a.id !== "group-banking");
  const tpl = mobile.template;
  const records = [...apps.map((a) => ({ ...a, isTemplate: false }))];
  if (tpl) records.push({ ...tpl, isTemplate: true });
  return records.map((r) => ({ params: { app: r.id }, props: { rec: r } }));
}

const { rec } = Astro.props;
const accent = rec.accent ?? "brand";
// Normalize primary/source links across app records (site + source) and the template (github).
const primary = rec.site ?? (rec.github ? { label: "View on GitHub", href: rec.github, external: true } : null);
const source = rec.source ?? rec.github ?? null;
---
<Base title={rec.name} description={rec.tagline ?? rec.description}>
  <AppHero rec={rec} primary={primary} source={source} />
  <AppOverview rec={rec} alt={false} />
  <AppProblem problem={rec.problem} alt={true} />
  <AppFeatureGrid features={rec.features ?? []} accent={accent} title={rec.isTemplate ? "What's included" : "What it does"} alt={false} />
  <AppTechStrip tech={rec.tech ?? []} runConfigs={rec.run_configs ?? []} accent={accent} alt={true} />
  <AppDownloads rec={rec} alt={false} />
  <AppHighlights highlights={rec.highlights ?? []} title={rec.isTemplate ? "Why fork this" : "Highlights"} accent={accent} alt={true} />
</Base>
