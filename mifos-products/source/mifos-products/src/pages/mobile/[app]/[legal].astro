---
// /mobile/<app>/<privacy|terms>/ — an app's legal pages, from content/legal/<app>/<page>.md.
// Only pages that exist on disk get a route, so an app without a policy never links to a blank page.
import { marked } from "marked";
import Base from "../../../layouts/Base.astro";
import { loadSite, loadLegal, LEGAL_PAGES } from "../../../lib/content.js";

export function getStaticPaths() {
  const mobile = loadSite().mobile ?? {};
  const records = [...(mobile.apps ?? []), ...(mobile.template ? [mobile.template] : [])];
  return records.flatMap((rec) =>
    Object.entries(loadLegal(rec.id)).map(([legal, md]) => ({ params: { app: rec.id, legal }, props: { rec, legal, md } })),
  );
}

const { rec, legal, md } = Astro.props;
const html = marked.parse(md);
---
<Base title={`${LEGAL_PAGES[legal]} — ${rec.name}`} description={`${LEGAL_PAGES[legal]} for ${rec.name}.`}>
  <article class="wrap legal">
    <a class="back" href={`/mobile/${rec.id}/`}>← {rec.name}</a>
    <div class="prose" set:html={html} />
  </article>
</Base>

<style>
  .legal { max-width: 760px; padding-block: 48px 72px; }
  .back { display: inline-block; margin-bottom: 24px; font-size: 0.9rem; color: var(--brand); }
  .prose :global(h1) { font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0 0 12px; }
  .prose :global(h2) { font-size: 1.3rem; margin: 2em 0 0.6em; }
  .prose :global(p), .prose :global(li) { line-height: 1.7; color: var(--text); }
  .prose :global(a) { color: var(--brand); overflow-wrap: anywhere; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: 0.92rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--border); padding: 10px 12px; text-align: left; vertical-align: top; }
  .prose :global(th) { background: var(--surface, transparent); }
</style>
