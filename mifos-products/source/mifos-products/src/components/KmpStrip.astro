---
import { loadSite } from "../lib/content.js";
const site = loadSite();
const k = site.mobile?.kmp ?? {};
const points = k.points ?? [];
---
<section class="kmp">
  <div class="wrap">
    <header class="sec-head">
      {k.eyebrow && <span class="eyebrow">{k.eyebrow}</span>}
      {k.head && <h2>{k.head}</h2>}
    </header>
    <div class="grid">
      {points.map((p) => (
        <div class="point">
          <div class="pi" aria-hidden="true">{p.icon}</div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sec-head { text-align: center; display: flex; flex-direction: column; gap: 12px; align-items: center; margin-bottom: 44px; }
  .sec-head h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .point { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--elev-1); }
  .pi { width: 46px; height: 46px; display: grid; place-items: center; font-size: 1.4rem; border-radius: 12px; background: var(--brand-container); margin-bottom: 14px; }
  .point h3 { font-size: 1.08rem; margin-bottom: 8px; }
  .point p { color: var(--muted); font-size: .93rem; }
</style>
