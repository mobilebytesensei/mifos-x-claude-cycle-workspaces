---
// MobileDownloads — a "Download & beta channels" section for the /mobile index.
// One compact row per app (name + its store badges). group-banking pulls its
// channels from the mifossave block; other apps from mobile.apps[].downloads.
import { loadSite } from "../lib/content.js";
import StoreBadges from "./StoreBadges.astro";

const site = loadSite();
const apps = site.mobile?.apps ?? [];
const ms = site.mifossave ?? {};
const tpl = site.mobile?.template;

const rows = apps
  .map((a) => {
    const dl = a.id === "group-banking" ? ms.downloads : a.downloads;
    return dl ? { id: a.id, name: a.name, brand: a.brand, icon: a.icon, accent: a.accent ?? "brand", dl } : null;
  })
  .filter(Boolean);

if (tpl?.downloads) {
  rows.push({ id: tpl.id, name: tpl.name, brand: tpl.label, icon: tpl.icon, accent: tpl.accent ?? "brand", dl: tpl.downloads });
}
---
{rows.length > 0 && (
  <section id="download" class="dls">
    <div class="wrap">
      <header class="sec-head">
        <span class="eyebrow">Get the apps</span>
        <h2>Download &amp; beta channels</h2>
        <p class="sub">Every app ships to Firebase App Distribution, TestFlight, Google Play, the App Store, and (where it targets desktop) the Mac App Store. Links go live as each channel is published.</p>
      </header>
      <div class="rows">
        {rows.map((r) => (
          <div class={`dlrow accent-${r.accent}`}>
            <a class="who" href={`/mobile/${r.id}`}>
              <span class="ic" aria-hidden="true">{r.icon}</span>
              <span class="nm">{r.name}{r.brand ? <em> · {r.brand}</em> : null}</span>
            </a>
            <StoreBadges downloads={r.dl} channels={r.dl.channels} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .dls { background: var(--md-surface); }
  .sec-head { text-align: center; max-width: 760px; margin: 0 auto 44px; display: flex; flex-direction: column; gap: 14px; align-items: center; }
  .sec-head h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .sub { color: var(--md-on-surface-variant); font-size: 1.02rem; }
  .rows { display: flex; flex-direction: column; gap: 16px; }
  .dlrow {
    --a: var(--md-primary); --a-c: var(--md-primary-container); --on-a-c: var(--md-on-primary-container);
    display: grid; grid-template-columns: 240px 1fr; gap: 20px; align-items: center;
    background: var(--md-surface-container-low); border-radius: var(--md-corner-lg);
    padding: 20px 24px; box-shadow: var(--md-elev-1);
  }
  .accent-teal   { --a: var(--md-secondary); --a-c: var(--md-secondary-container); --on-a-c: var(--md-on-secondary-container); }
  .accent-amber  { --a: var(--md-tertiary);  --a-c: var(--md-tertiary-container);  --on-a-c: var(--md-on-tertiary-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); --on-a-c: var(--violet); }
  .who { display: inline-flex; align-items: center; gap: 12px; color: var(--md-on-surface); }
  .who:hover .nm { color: var(--a); }
  .ic { width: 44px; height: 44px; flex: none; display: grid; place-items: center; font-size: 1.35rem; border-radius: var(--md-corner-md); background: var(--a-c); color: var(--on-a-c); }
  .nm { font-family: var(--md-font-display); font-weight: 600; font-size: 1.1rem; }
  .nm em { color: var(--a); font-style: normal; }
  @media (max-width: 720px) { .dlrow { grid-template-columns: 1fr; gap: 14px; } }
</style>
