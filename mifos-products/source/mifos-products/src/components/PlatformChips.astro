---
// PlatformChips — renders platform-reach chips (Android / iOS / Desktop / Web) with glyphs.
const { platforms = [], size = "sm" } = Astro.props;
const GLYPH = {
  Android: '<path d="M6 18h12V9H6zM4 9v9M20 9v9M8 3l1.5 2.5M16 3l-1.5 2.5M9 7h.01M15 7h.01"/>',
  iOS:     '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  Desktop: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  Web:     '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/>',
};
---
<ul class={`plats ${size}`}>
  {platforms.map((p) => (
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={GLYPH[p] ?? GLYPH.Web}></svg>
      {p}
    </li>
  ))}
</ul>
<style>
  .plats { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .plats li {
    display: inline-flex; align-items: center; gap: 6px;
    font-weight: 600; color: var(--muted);
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px;
  }
  .plats.sm li { font-size: .74rem; padding: 4px 10px; }
  .plats.lg li { font-size: .88rem; padding: 7px 14px; color: var(--text); }
  .plats svg { width: 15px; height: 15px; opacity: .85; }
  .plats.lg svg { width: 17px; height: 17px; }
</style>
