---
// AppFeatureGrid — reusable feature-card grid for an app detail page.
// Props: features [{icon,title,body}], accent ("brand"|"teal"|"amber"|"violet"), title, alt (bg band).
const { features = [], accent = "brand", title = "What it does", alt = false } = Astro.props;
---
{features.length > 0 && (
  <section class:list={[`band accent-${accent}`, { alt }]}>
    <div class="wrap">
      <h2 class="ctr">{title}</h2>
      <div class="grid">
        {features.map((f) => (
          <div class="card">
            <div class="ic" aria-hidden="true">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .band { --a: var(--md-primary); --a-c: var(--md-primary-container); padding-block: clamp(48px, 8vw, 88px); }
  .band.alt { background: var(--md-surface-container-low); }
  .accent-teal   { --a: var(--md-secondary); --a-c: var(--md-secondary-container); }
  .accent-amber  { --a: var(--md-tertiary);  --a-c: var(--md-tertiary-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); }
  .ctr { text-align: center; margin-bottom: 40px; font-family: var(--md-font-display); font-weight: 600; font-size: clamp(1.6rem, 3.5vw, 2.2rem); }
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .card { background: var(--md-surface-container-lowest); border-radius: var(--md-corner-lg); padding: 24px; box-shadow: var(--md-elev-1); transition: box-shadow .2s ease, transform .2s ease; }
  .card:hover { box-shadow: var(--md-elev-2); transform: translateY(-2px); }
  .ic { width: 46px; height: 46px; display: grid; place-items: center; font-size: 1.4rem; border-radius: var(--md-corner-md); background: var(--a-c); margin-bottom: 14px; }
  .card h3 { font-family: var(--md-font-display); font-weight: 600; font-size: 1.05rem; margin-bottom: 8px; }
  .card p { color: var(--md-on-surface-variant); font-size: .93rem; line-height: 1.55; }
</style>
