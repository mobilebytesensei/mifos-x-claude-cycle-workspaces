---
// AppOverview — the long-form description band, with an optional white-label callout for the template.
const { rec, alt = false } = Astro.props;
const body = rec.long_description ?? rec.description ?? "";
---
<section class:list={["band", { alt }]}>
  <div class="wrap narrow">
    <span class="eyebrow">Overview</span>
    <p class="body">{body}</p>
    {rec.isTemplate && (
      <p class="note">
        <strong>White-label pattern:</strong> the shell is generic; a per-project
        customizer stamps identity and branding, so one template powers every Mifos
        app — the same way <a href="/mobile/group-banking">Group Banking</a> ships publicly as MifosSave.
      </p>
    )}
  </div>
</section>

<style>
  .band { padding-block: clamp(48px, 8vw, 88px); }
  .band.alt { background: var(--md-surface-container-low); }
  .wrap.narrow { max-width: 720px; }
  .body { margin-top: 16px; color: var(--md-on-surface-variant); font-size: 1.05rem; line-height: 1.65; }
  .note { margin-top: 20px; background: var(--md-surface-container-lowest); border: 1px solid var(--md-outline-variant); border-left: 3px solid var(--md-primary); border-radius: var(--md-corner-md); padding: 16px 18px; }
  .note a { color: var(--md-primary); text-decoration: underline; text-underline-offset: 3px; }
</style>
