---
import { linkAttrs } from "../lib/content.js";
const { product } = Astro.props;
const p = product ?? {};
const accent = p.accent ?? "brand";       // brand | teal | amber | violet — maps to tokens
const tags = p.tags ?? [];
const subs = p.subproducts ?? [];
---
<article class={`card accent-${accent}`}>
  <div class="head">
    <div class="icon" aria-hidden="true">{p.icon ?? "▦"}</div>
    <span class="cat">{p.category}</span>
  </div>
  <h3>{p.name}</h3>
  <p class="desc">{p.description}</p>

  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  )}

  {subs.length > 0 && (
    <div class="subs">
      {subs.map((s) => (
        <a class="chip" href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>
      ))}
    </div>
  )}

  {p.link && (
    <a class="more" href={p.link.href} {...linkAttrs(p.link)}>
      {p.link.label}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  )}
</article>

<style>
  /* MD3 elevated card */
  .card {
    --a: var(--md-primary); --a-c: var(--md-primary-container); --on-a-c: var(--md-on-primary-container);
    display: flex; flex-direction: column; gap: 14px;
    background: var(--md-surface-container-low); border: none; border-radius: var(--md-corner-lg);
    padding: 28px; box-shadow: var(--md-elev-1);
    transition: box-shadow var(--md-dur-med) var(--md-ease-standard), transform var(--md-dur-med) var(--md-ease-standard);
    position: relative; overflow: hidden;
  }
  .card::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--a); }
  .card:hover { box-shadow: var(--md-elev-3); transform: translateY(-2px); }
  .accent-teal   { --a: var(--md-secondary); --a-c: var(--md-secondary-container); --on-a-c: var(--md-on-secondary-container); }
  .accent-amber  { --a: var(--md-tertiary);  --a-c: var(--md-tertiary-container);  --on-a-c: var(--md-on-tertiary-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); --on-a-c: var(--violet); }

  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .icon {
    width: 52px; height: 52px; display: grid; place-items: center;
    font-size: 1.5rem; border-radius: var(--md-corner-md); background: var(--a-c); color: var(--on-a-c);
  }
  .cat { font-size: .7rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--a); text-align: right; }
  h3 { font-family: var(--md-font-display); font-size: 1.35rem; font-weight: 600; }
  .desc { color: var(--md-on-surface-variant); font-size: .95rem; line-height: 1.55; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: .74rem; font-weight: 500; color: var(--md-on-surface-variant); background: transparent; border: 1px solid var(--md-outline-variant); padding: 5px 11px; border-radius: var(--md-corner-sm); }
  .subs { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: .78rem; font-weight: 600; color: var(--on-a-c); background: var(--a-c); padding: 6px 12px; border-radius: var(--md-corner-sm); transition: box-shadow var(--md-dur-short) var(--md-ease-standard); }
  .chip:hover { box-shadow: var(--md-elev-1); }
  .more { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--a); }
  .more svg { transition: transform var(--md-dur-short) var(--md-ease-standard); }
  .more:hover svg { transform: translateX(3px); }
</style>
