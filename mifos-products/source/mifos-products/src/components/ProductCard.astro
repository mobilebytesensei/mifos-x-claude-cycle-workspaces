---
import { linkAttrs } from "../lib/content.js";
const { product } = Astro.props;
const p = product ?? {};
const accent = p.accent ?? "brand";       // brand | teal | amber | violet — maps to tokens
const tags = p.tags ?? [];
const subs = p.subproducts ?? [];
---
<article class={`card accent-${accent}`}>
  <div class="head">
    <div class="icon" aria-hidden="true">{p.icon ?? "▦"}</div>
    <span class="cat">{p.category}</span>
  </div>
  <h3>{p.name}</h3>
  <p class="desc">{p.description}</p>

  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  )}

  {subs.length > 0 && (
    <div class="subs">
      {subs.map((s) => (
        <a class="chip" href={s.href} target="_blank" rel="noopener noreferrer">{s.name}</a>
      ))}
    </div>
  )}

  {p.link && (
    <a class="more" href={p.link.href} {...linkAttrs(p.link)}>
      {p.link.label}
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  )}
</article>

<style>
  .card {
    --a: var(--brand); --a-c: var(--brand-container);
    display: flex; flex-direction: column; gap: 14px;
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 28px; box-shadow: var(--elev-1);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    position: relative; overflow: hidden;
  }
  .card::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--a); opacity: .9;
  }
  .card:hover { transform: translateY(-4px); box-shadow: var(--elev-3); border-color: color-mix(in srgb, var(--a) 40%, var(--border)); }
  .accent-teal   { --a: var(--teal);   --a-c: var(--teal-container); }
  .accent-amber  { --a: var(--amber);  --a-c: var(--amber-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); }

  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .icon {
    width: 48px; height: 48px; display: grid; place-items: center;
    font-size: 1.5rem; border-radius: 12px; background: var(--a-c); color: var(--a);
  }
  .cat { font-size: .72rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--a); text-align: right; }
  h3 { font-size: 1.35rem; }
  .desc { color: var(--muted); font-size: .96rem; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: .74rem; font-weight: 600; color: var(--muted); background: var(--surface); border: 1px solid var(--border); padding: 4px 10px; border-radius: 999px; }
  .subs { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-size: .78rem; font-weight: 600; color: var(--a); background: var(--a-c); padding: 5px 11px; border-radius: 999px; }
  .chip:hover { filter: brightness(.96); }
  .more { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--a); }
  .more svg { transition: transform .15s ease; }
  .more:hover svg { transform: translateX(3px); }
</style>
