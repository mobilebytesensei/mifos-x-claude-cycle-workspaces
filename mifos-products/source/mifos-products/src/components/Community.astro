---
import { loadSite, linkAttrs } from "../lib/content.js";
const site = loadSite();
const c = site.community ?? {};
const links = c.links ?? [];

const ICONS = {
  code:  '<path d="M8 6l-6 6 6 6M16 6l6 6-6 6"/>',
  chat:  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/>',
};
---
<section class="community">
  <div class="wrap panel">
    {c.eyebrow && <span class="eyebrow">{c.eyebrow}</span>}
    {c.head && <h2>{c.head}</h2>}
    {c.subhead && <p class="sub">{c.subhead}</p>}
    {links.length > 0 && (
      <div class="links">
        {links.map((l) => (
          <a class="btn btn-ghost" href={l.href} {...linkAttrs(l)}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[l.icon] ?? ICONS.globe}></svg>
            {l.label}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .panel {
    text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px;
    background: linear-gradient(135deg, var(--brand-container), color-mix(in srgb, var(--teal-container) 60%, var(--brand-container)));
    border: 1px solid var(--border); border-radius: 24px; padding: clamp(40px, 7vw, 72px);
  }
  .panel h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); max-width: 620px; }
  .sub { color: var(--muted); max-width: 560px; font-size: 1.05rem; }
  .links { margin-top: 12px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .links .btn { background: var(--card); }
</style>
