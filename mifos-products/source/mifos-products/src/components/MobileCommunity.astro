---
import { loadSite, linkAttrs } from "../lib/content.js";
const site = loadSite();
const c = site.mobile?.community ?? {};
const links = c.links ?? [];
---
<section class="mcomm">
  <div class="wrap panel">
    {c.head && <h2>{c.head}</h2>}
    {c.subhead && <p class="sub">{c.subhead}</p>}
    {links.length > 0 && (
      <div class="links">
        {links.map((l) => (
          <a class="btn btn-ghost" href={l.href} {...linkAttrs(l)}>{l.label}</a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .panel { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px;
    background: linear-gradient(135deg, var(--brand-container), color-mix(in srgb, var(--teal-container) 60%, var(--brand-container)));
    border: 1px solid var(--border); border-radius: 24px; padding: clamp(36px, 6vw, 64px); }
  .panel h2 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); max-width: 640px; }
  .sub { color: var(--muted); max-width: 560px; }
  .links { margin-top: 8px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .links .btn { background: var(--card); }
</style>
