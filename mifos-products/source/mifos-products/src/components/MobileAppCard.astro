---
import { linkAttrs } from "../lib/content.js";
import PlatformChips from "./PlatformChips.astro";
const { app } = Astro.props;
const a = app ?? {};
const accent = a.accent ?? "brand";
const site = a.site;
const sitePending = site?.pending === true;
const STATUS = { live: "Live", reference: "Reference", soon: "Coming soon" };
---
<article id={a.id} class={`mcard accent-${accent}`}>
  <div class="top">
    <div class="icon" aria-hidden="true">{a.icon ?? "📱"}</div>
    <div class="titles">
      <h3><a href={`/mobile/${a.id}`}>{a.name}{a.brand ? <span class="as"> · {a.brand}</span> : null}</a></h3>
      <span class="cat">{a.category}</span>
    </div>
    {a.status && <span class={`status s-${a.status}`}>{STATUS[a.status] ?? a.status}</span>}
  </div>

  {a.tagline && <p class="tagline">{a.tagline}</p>}
  {a.description && <p class="desc">{a.description}</p>}

  <PlatformChips platforms={a.platforms ?? []} size="sm" />

  <div class="actions">
    <a class="btn btn-primary" href={`/mobile/${a.id}`}>
      View details
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
    {site && !sitePending && (
      <a class="ext" href={site.href} {...linkAttrs(site)}>{site.label} ↗</a>
    )}
    {a.source && (
      <a class="src" href={a.source} target="_blank" rel="noopener noreferrer" aria-label={`${a.name} source on GitHub`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
        Source
      </a>
    )}
  </div>
</article>

<style>
  .mcard {
    --a: var(--brand); --a-c: var(--brand-container);
    display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 84px;
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 26px; box-shadow: var(--elev-1); position: relative; overflow: hidden;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .mcard::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--a); }
  .mcard:hover { transform: translateY(-4px); box-shadow: var(--elev-3); border-color: color-mix(in srgb, var(--a) 40%, var(--border)); }
  .accent-teal { --a: var(--teal); --a-c: var(--teal-container); }
  .accent-amber { --a: var(--amber); --a-c: var(--amber-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); }

  .top { display: flex; align-items: flex-start; gap: 14px; }
  .icon { width: 52px; height: 52px; flex: none; display: grid; place-items: center; font-size: 1.6rem; border-radius: 14px; background: var(--a-c); }
  .titles { flex: 1; min-width: 0; }
  h3 { font-size: 1.25rem; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--a); }
  .as { color: var(--a); font-weight: 700; }
  .cat { display: block; margin-top: 3px; font-size: .74rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--a); }
  .status { flex: none; font-size: .68rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; }
  .s-live { color: #0a7d3c; background: #d8f3e3; }
  .s-reference { color: var(--muted); background: var(--surface); }
  :global(:root[data-theme="dark"]) .s-live { color: #7ee7a8; background: #12351f; }

  .tagline { font-weight: 600; color: var(--text); }
  .desc { color: var(--muted); font-size: .95rem; }
  .actions { margin-top: auto; display: flex; align-items: center; gap: 14px; padding-top: 4px; flex-wrap: wrap; }
  .btn { font-size: .9rem; padding: 10px 16px; }
  .btn-primary { background: var(--a); }
  .ext { font-weight: 600; color: var(--a); font-size: .9rem; }
  .ext:hover { text-decoration: underline; text-underline-offset: 3px; }
  .src { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: var(--muted); font-size: .9rem; margin-left: auto; }
  .src:hover { color: var(--text); }
</style>
