---
// StoreBadges — official-style distribution buttons (Firebase App Distribution,
// TestFlight, Google Play, App Store, Mac App Store, Web). Data-driven: pass a
// `downloads` map { channel: url }. A channel with no url renders as "Coming soon".
const {
  downloads = {},
  channels = ["firebase", "testflight", "playstore", "appstore", "macappstore", "web"],
} = Astro.props;

// line1 = small kicker, line2 = store name. logo = inline SVG key.
const META = {
  playstore:    { line1: "Get it on",        line2: "Google Play",      logo: "play" },
  appstore:     { line1: "Download on the",   line2: "App Store",        logo: "apple" },
  macappstore:  { line1: "Download on the",   line2: "Mac App Store",    logo: "apple" },
  testflight:   { line1: "Join the beta on",  line2: "TestFlight",       logo: "testflight" },
  firebase:     { line1: "Get the beta —",    line2: "Firebase App Distribution", logo: "firebase" },
  web:          { line1: "Open the",          line2: "Web app",          logo: "web" },
  github:       { line1: "View on",           line2: "GitHub",           logo: "github" },
  template:     { line1: "Generate from",     line2: "Use this template", logo: "github" },
};

const items = channels
  .filter((c) => META[c])
  .map((c) => ({ key: c, ...META[c], url: downloads[c] || "" }));
---
<div class="badges">
  {items.map((it) => {
    const Tag = it.url ? "a" : "span";
    return (
      <Tag
        class:list={["badge", `logo-${it.logo}`, !it.url && "soon"]}
        {...(it.url ? { href: it.url, target: "_blank", rel: "noopener noreferrer" } : { "aria-disabled": "true" })}
      >
        <span class="glyph" aria-hidden="true">
          {it.logo === "apple" && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.417 2.2-1.11 2.98-.744.84-1.98 1.49-3.02 1.41-.13-1.1.42-2.27 1.09-3 .74-.82 2.04-1.44 3.04-1.39zM20.5 17.4c-.55 1.27-.82 1.84-1.53 2.97-.99 1.57-2.39 3.53-4.12 3.54-1.54.02-1.94-1.01-4.03-1-2.09.01-2.53 1.02-4.07 1-1.73-.01-3.05-1.78-4.05-3.35C-.02 18.16-.31 13.5 1.4 11.03c.99-1.42 2.55-2.26 4.02-2.26 1.5 0 2.44 1.02 3.68 1.02 1.2 0 1.93-1.02 3.66-1.02 1.31 0 2.7.71 3.69 1.94-3.24 1.78-2.71 6.4.05 6.69z"/></svg>}
          {it.logo === "play" && <svg viewBox="0 0 24 24"><path fill="#00e5ff" d="M3.6 1.8 13.4 12 3.6 22.2c-.35-.2-.6-.6-.6-1.1V2.9c0-.5.25-.9.6-1.1z"/><path fill="#00e676" d="M16.5 8.9 5.9 2.8 3.6 1.8c.25-.15.6-.15.95.05l12 6.9-.05.15z"/><path fill="#ffea00" d="M20.4 11.1c.7.4.7 1.4 0 1.8l-3.9 2.2-2.9-3.1 2.9-3.1 3.9 2.2z"/><path fill="#ff3d00" d="M3.6 22.2 13.4 12l3.1 3.1-12 6.9c-.35.2-.7.2-.95.05l.05.15z"/></svg>}
          {it.logo === "firebase" && <svg viewBox="0 0 24 24"><path fill="#ffc24a" d="M4 18.5 6.2 4.7c.1-.5.7-.6 1-.2l2.1 3.9L4 18.5z"/><path fill="#f4bd62" d="M4 18.5 6.2 4.7c.1-.5.7-.6 1-.2l2.1 3.9L4 18.5z" opacity=".6"/><path fill="#f6820c" d="m14.2 9.3-2.6-4.9c-.2-.4-.8-.4-1 0L4 18.5 14.2 9.3z" opacity=".01"/><path fill="#fde068" d="m4 18.5 6.3-11.9 2.3 4.3L14.2 9.3 4 18.5z" opacity=".4"/><path fill="#fca50a" d="m14.2 9.3 1.7 6.2L11 18.9 4 18.5 14.2 9.3z" opacity=".3"/><path fill="#f6820c" d="M20 18.5 18 5.9c-.1-.5-.7-.7-1-.3L4 18.5l7.9 4.4c.5.3 1.1.3 1.6 0L20 18.5z"/><path fill="#fde068" d="M14.2 9.3 4 18.5l10.2-9.2 1.7 6.2-1.7-6.2z" opacity=".2"/></svg>}
          {it.logo === "testflight" && <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="11" fill="#0d96f2"/><path fill="#fff" d="M12 5.5 15.8 15c.15.4-.28.77-.63.53L12 13.6l-3.17 1.93c-.35.24-.78-.13-.63-.53L12 5.5z"/></svg>}
          {it.logo === "web" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg>}
          {it.logo === "github" && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>}
        </span>
        <span class="txt">
          <small>{it.line1}</small>
          <strong>{it.line2}</strong>
        </span>
        {!it.url && <span class="tag">Soon</span>}
      </Tag>
    );
  })}
</div>

<style>
  .badges { display: flex; flex-wrap: wrap; gap: 12px; }
  .badge {
    position: relative; display: inline-flex; align-items: center; gap: 11px;
    min-width: 176px; height: 56px; padding: 0 18px 0 16px;
    background: #111318; color: #fff; border: 1px solid rgba(255,255,255,.14);
    border-radius: var(--md-corner-md, 12px);
    transition: box-shadow var(--md-dur-short, 150ms) var(--md-ease-standard, ease),
                transform var(--md-dur-short, 150ms) var(--md-ease-standard, ease);
  }
  .badge:hover { box-shadow: var(--md-elev-2); transform: translateY(-2px); }
  .badge.soon { opacity: .55; cursor: default; }
  .badge.soon:hover { box-shadow: none; transform: none; }
  :global(:root[data-theme="dark"]) .badge { background: #000; border-color: rgba(255,255,255,.2); }

  .glyph { display: grid; place-items: center; width: 26px; height: 26px; color: #fff; }
  .glyph svg { width: 24px; height: 24px; }
  .logo-apple .glyph svg { width: 22px; height: 22px; }

  .txt { display: flex; flex-direction: column; line-height: 1.1; text-align: left; }
  .txt small { font-size: .62rem; letter-spacing: .02em; opacity: .82; text-transform: none; }
  .txt strong { font-size: 1rem; font-weight: 600; letter-spacing: .01em; }
  .logo-firebase .txt strong { font-size: .82rem; }
  .logo-github .txt strong { font-size: .92rem; }

  .tag {
    position: absolute; top: -8px; right: -6px;
    font-size: .58rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    background: var(--md-tertiary-container); color: var(--md-on-tertiary-container);
    padding: 3px 7px; border-radius: 999px;
  }
</style>
