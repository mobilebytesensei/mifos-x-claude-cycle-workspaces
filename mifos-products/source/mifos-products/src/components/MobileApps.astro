---
import { loadSite } from "../lib/content.js";
import MobileAppCard from "./MobileAppCard.astro";
const site = loadSite();
const sec = site.mobile?.apps_section ?? {};
const apps = site.mobile?.apps ?? [];
---
<section id="apps" class="mapps">
  <div class="wrap">
    <header class="sec-head">
      {sec.eyebrow && <span class="eyebrow">{sec.eyebrow}</span>}
      {sec.head && <h2>{sec.head}</h2>}
      {sec.subhead && <p class="sub">{sec.subhead}</p>}
    </header>
    <div class="grid">
      {apps.map((a) => <MobileAppCard app={a} />)}
    </div>
  </div>
</section>

<style>
  .mapps { background: var(--surface); }
  .sec-head { text-align: center; max-width: 760px; margin: 0 auto 48px; display: flex; flex-direction: column; gap: 14px; align-items: center; }
  .sec-head h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .sub { color: var(--muted); font-size: 1.05rem; }
  .grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); }
</style>
