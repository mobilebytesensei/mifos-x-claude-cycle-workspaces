---
// AppProblem — "the problem" narrow band. Props: problem { head, body }.
const { problem, alt = false } = Astro.props;
---
{problem && (
  <section class:list={["band", { alt }]}>
    <div class="wrap narrow">
      <span class="eyebrow">The problem</span>
      <h2>{problem.head}</h2>
      <p class="lead">{problem.body}</p>
    </div>
  </section>
)}

<style>
  .band { padding-block: clamp(48px, 8vw, 88px); }
  .band.alt { background: var(--md-surface-container-low); }
  .wrap.narrow { max-width: 720px; }
  h2 { font-family: var(--md-font-display); font-weight: 600; font-size: clamp(1.5rem, 3.5vw, 2rem); margin-top: 14px; }
  .lead { margin-top: 14px; color: var(--md-on-surface-variant); font-size: 1.05rem; line-height: 1.6; }
</style>
