---
import { loadSite, href, linkAttrs } from "../lib/content.js";
const site = loadSite();
const hero = site.hero ?? {};
const stats = hero.stats ?? [];
---
<section class="hero">
  <div class="wrap hero-inner">
    {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
    <h1>{hero.head}</h1>
    {hero.subhead && <p class="subhead">{hero.subhead}</p>}

    <div class="cta-row">
      {hero.primary_cta && (
        <a class="btn btn-primary" href={href(hero.primary_cta.href)} {...linkAttrs(hero.primary_cta)}>
          {hero.primary_cta.label}
        </a>
      )}
      {hero.secondary_cta && (
        <a class="btn btn-ghost" href={href(hero.secondary_cta.href)} {...linkAttrs(hero.secondary_cta)}>
          {hero.secondary_cta.label}
        </a>
      )}
    </div>

    {stats.length > 0 && (
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
  <div class="glow" aria-hidden="true"></div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(64px, 12vw, 128px); }
  .hero-inner { position: relative; z-index: 1; text-align: center; max-width: 860px; }
  .wrap.hero-inner { margin-inline: auto; }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem); margin-top: 20px;
    background: linear-gradient(135deg, var(--text), var(--brand));
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .subhead { margin-top: 20px; font-size: clamp(1.05rem, 2vw, 1.28rem); color: var(--muted); max-width: 680px; margin-inline: auto; }
  .cta-row { margin-top: 32px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .stats { margin-top: 56px; display: flex; gap: clamp(24px, 6vw, 72px); justify-content: center; flex-wrap: wrap; }
  .stat-value { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; color: var(--brand); letter-spacing: -.02em; }
  .stat-label { color: var(--muted); font-size: .9rem; margin-top: 4px; }
  .glow {
    position: absolute; inset: -20% 0 auto 0; height: 520px; z-index: 0;
    background:
      radial-gradient(600px 320px at 50% -10%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 70%),
      radial-gradient(400px 260px at 15% 0%, color-mix(in srgb, var(--teal) 16%, transparent), transparent 70%);
    filter: blur(4px); pointer-events: none;
  }
</style>
