---
import { loadSite, href, linkAttrs } from "../lib/content.js";
const site = loadSite();
const hero = site.hero ?? {};
const stats = hero.stats ?? [];
---
<section class="hero">
  <div class="wrap hero-inner">
    {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
    <h1>{hero.head}</h1>
    {hero.subhead && <p class="subhead">{hero.subhead}</p>}

    <div class="cta-row">
      {hero.primary_cta && (
        <a class="btn btn-primary" href={href(hero.primary_cta.href)} {...linkAttrs(hero.primary_cta)}>
          {hero.primary_cta.label}
        </a>
      )}
      {hero.secondary_cta && (
        <a class="btn btn-ghost" href={href(hero.secondary_cta.href)} {...linkAttrs(hero.secondary_cta)}>
          {hero.secondary_cta.label}
        </a>
      )}
    </div>

    {stats.length > 0 && (
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
  <div class="glow" aria-hidden="true"></div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(64px, 12vw, 128px); }
  .hero-inner { position: relative; z-index: 1; text-align: center; max-width: 860px; }
  .wrap.hero-inner { margin-inline: auto; }
  h1 {
    font-family: var(--md-font-display); font-weight: 700; letter-spacing: -0.02em; line-height: 1.06;
    font-size: clamp(2.4rem, 6vw, 3.9rem); margin-top: 22px; color: var(--md-on-surface);
  }
  .subhead { margin-top: 20px; font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--md-on-surface-variant); max-width: 680px; margin-inline: auto; }
  .cta-row { margin-top: 32px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .stats { margin-top: 56px; display: flex; gap: clamp(20px, 5vw, 56px); justify-content: center; flex-wrap: wrap; }
  .stat { background: var(--md-surface-container); border-radius: var(--md-corner-lg); padding: 18px 28px; min-width: 140px; }
  .stat-value { font-family: var(--md-font-display); font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 700; color: var(--md-primary); letter-spacing: -.02em; }
  .stat-label { color: var(--md-on-surface-variant); font-size: .85rem; margin-top: 4px; }
  .glow {
    position: absolute; inset: -20% 0 auto 0; height: 520px; z-index: 0;
    background:
      radial-gradient(600px 320px at 50% -10%, color-mix(in srgb, var(--md-primary) 18%, transparent), transparent 70%),
      radial-gradient(400px 260px at 15% 0%, color-mix(in srgb, var(--md-secondary) 14%, transparent), transparent 70%);
    filter: blur(4px); pointer-events: none;
  }
</style>
