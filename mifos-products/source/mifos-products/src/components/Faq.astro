---
// Faq.astro — site.yaml#faq as native <details> (no JS). Renders nothing when there is no FAQ.
import { loadSite } from "../lib/content.js";
const f = loadSite().faq ?? {};
const items = f.items ?? [];
---
{items.length > 0 && (
  <section class="faq">
    <div class="wrap">
      {f.eyebrow && <span class="eyebrow">{f.eyebrow}</span>}
      {f.head && <h2>{f.head}</h2>}
      <div class="list">
        {items.map((it) => (
          <details>
            <summary>{it.q}</summary>
            <p>{it.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq { padding-block: 64px; text-align: center; }
  .list { max-width: 760px; margin: 28px auto 0; text-align: left; display: grid; gap: 12px; }
  details { border: 1px solid var(--border); border-radius: 14px; padding: 16px 20px; background: var(--surface); }
  summary { cursor: pointer; font-weight: 600; color: var(--text); }
  details p { margin: 12px 0 0; color: var(--muted); line-height: 1.65; }
</style>
