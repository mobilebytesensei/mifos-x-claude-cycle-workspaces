---
// AppHero — tonal hero band for a mobile-app detail page. Accent-driven (brand/teal/violet/amber),
// consistent across every app so the section rhythm reads the same from page to page.
import PlatformChips from "./PlatformChips.astro";
import { linkAttrs } from "../lib/content.js";

const { rec, primary, source } = Astro.props;
const STATUS = { live: "Live", reference: "Reference", template: "Template" };
const accent = rec.accent ?? "brand";
const eyebrow = rec.label ?? rec.category;
---
<header class={`ahero accent-${accent}`}>
  <div class="wrap">
    <a class="back" href="/mobile">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
      All mobile apps
    </a>

    <div class="row">
      <div class="icon" aria-hidden="true">{rec.icon ?? "📱"}</div>
      <div class="titles">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{rec.name}{rec.brand ? <span class="as"> · {rec.brand}</span> : null}</h1>
        {rec.tagline && <p class="tagline">{rec.tagline}</p>}
        <div class="meta">
          {rec.status && <span class={`status s-${rec.status}`}>{STATUS[rec.status] ?? rec.status}</span>}
          <PlatformChips platforms={rec.platforms ?? []} size="sm" />
        </div>
      </div>
    </div>

    <div class="cta-row">
      {primary && (
        <a class={`btn ${primary.pending ? "btn-ghost" : "btn-primary"}`} href={primary.href} {...linkAttrs(primary)}>{primary.label}</a>
      )}
      {source && (
        <a class="btn btn-ghost" href={source} target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.7c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9l-.01 2.81c0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z"/></svg>
          Source
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .ahero {
    --a: var(--md-primary); --a-c: var(--md-primary-container); --on-a: var(--md-on-primary);
    background: linear-gradient(160deg, var(--a-c) 0%, var(--md-surface) 130%);
    padding-block: clamp(28px, 5vw, 48px) clamp(40px, 7vw, 64px);
  }
  .accent-teal   { --a: var(--md-secondary); --a-c: var(--md-secondary-container); --on-a: var(--md-on-secondary); }
  .accent-amber  { --a: var(--md-tertiary);  --a-c: var(--md-tertiary-container);  --on-a: var(--md-on-tertiary); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); --on-a: #ffffff; }

  .back { display: inline-flex; align-items: center; gap: 7px; color: var(--md-on-surface-variant); font-weight: 600; font-size: .9rem; margin-bottom: 28px; }
  .back:hover { color: var(--md-on-surface); }
  .row { display: flex; gap: 20px; align-items: flex-start; }
  .icon { width: 68px; height: 68px; flex: none; display: grid; place-items: center; font-size: 2rem; border-radius: var(--md-corner-lg); background: var(--md-surface-container-lowest); box-shadow: var(--md-elev-1); }
  .titles h1 { font-family: var(--md-font-display); font-weight: 700; font-size: clamp(1.9rem, 4.5vw, 3rem); margin-top: 8px; letter-spacing: -0.01em; }
  .as { color: var(--a); }
  .tagline { margin-top: 10px; font-size: 1.15rem; color: var(--md-on-surface-variant); }
  .meta { margin-top: 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .status { font-size: .68rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; padding: 4px 9px; border-radius: var(--md-corner-sm); }
  .s-live { color: var(--md-success); background: var(--md-success-container); }
  .s-reference, .s-template { color: var(--md-on-surface-variant); background: var(--md-surface-container); }

  .cta-row { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; }
  .cta-row .btn-primary { background: var(--a); color: var(--on-a); }
</style>
