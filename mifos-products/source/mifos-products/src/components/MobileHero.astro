---
import { loadSite, linkAttrs } from "../lib/content.js";
import PlatformChips from "./PlatformChips.astro";
const site = loadSite();
const h = site.mobile?.hero ?? {};
const platforms = h.platforms ?? [];
---
<section class="mhero">
  <div class="wrap mhero-inner">
    <div class="copy">
      {h.eyebrow && <span class="eyebrow">{h.eyebrow}</span>}
      <h1>{h.head}</h1>
      {h.subhead && <p class="subhead">{h.subhead}</p>}
      <div class="cta-row">
        {h.primary_cta && <a class="btn btn-primary" href={h.primary_cta.href}>{h.primary_cta.label}</a>}
        {h.secondary_cta && (
          <a class="btn btn-ghost" href={h.secondary_cta.href} {...linkAttrs(h.secondary_cta)}>{h.secondary_cta.label}</a>
        )}
      </div>
      {platforms.length > 0 && (
        <div class="reach">
          <span class="reach-label">One Kotlin codebase →</span>
          <PlatformChips platforms={platforms} size="lg" />
        </div>
      )}
    </div>

    <!-- Stylized multi-platform device cluster (pure CSS, no assets) -->
    <div class="devices" aria-hidden="true">
      <div class="dev phone a"><span></span><span></span><span></span></div>
      <div class="dev phone b"><span></span><span></span><span></span></div>
      <div class="dev tablet"><span></span><span></span></div>
      <div class="badge kt">Kotlin</div>
    </div>
  </div>
  <div class="glow" aria-hidden="true"></div>
</section>

<style>
  .mhero { position: relative; overflow: hidden; padding-block: clamp(56px, 10vw, 104px); }
  .mhero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem);
    background: linear-gradient(135deg, var(--text), var(--brand)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .subhead { margin-top: 18px; font-size: clamp(1rem, 1.8vw, 1.18rem); color: var(--muted); max-width: 560px; }
  .cta-row { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
  .reach { margin-top: 30px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .reach-label { font-weight: 700; color: var(--text); font-size: .9rem; }

  .devices { position: relative; height: 340px; }
  .dev { position: absolute; border-radius: 22px; background: var(--card); border: 1px solid var(--border); box-shadow: var(--elev-3); padding: 14px 12px; display: flex; flex-direction: column; gap: 8px; }
  .dev span { display: block; border-radius: 6px; background: linear-gradient(90deg, var(--brand-container), var(--surface-2)); height: 12px; }
  .dev span:first-child { height: 40px; background: linear-gradient(120deg, var(--brand), var(--teal)); opacity: .85; }
  .phone { width: 150px; height: 300px; }
  .phone.a { left: 8%; top: 20px; transform: rotate(-7deg); z-index: 2; }
  .phone.b { left: 40%; top: 0; z-index: 3; }
  .tablet { right: 0; top: 60px; width: 210px; height: 250px; transform: rotate(6deg); z-index: 1; }
  .badge.kt { position: absolute; left: 30%; bottom: 6px; z-index: 4;
    font-weight: 800; font-size: .8rem; color: var(--brand-on); background: var(--brand);
    padding: 7px 14px; border-radius: 999px; box-shadow: var(--elev-2); letter-spacing: .02em; }

  .glow { position: absolute; inset: -10% -10% auto auto; width: 620px; height: 500px; z-index: 0;
    background: radial-gradient(420px 300px at 80% 10%, color-mix(in srgb, var(--brand) 20%, transparent), transparent 70%),
                radial-gradient(360px 260px at 60% 0%, color-mix(in srgb, var(--teal) 16%, transparent), transparent 70%);
    pointer-events: none; }

  @media (max-width: 880px) {
    .mhero-inner { grid-template-columns: 1fr; }
    .devices { display: none; }
  }
</style>
