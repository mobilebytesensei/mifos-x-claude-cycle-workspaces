---
import { loadSite, href, linkAttrs } from "../lib/content.js";
const site = loadSite();
const brand = site.brand ?? {};
const footer = site.footer ?? {};
const columns = footer.columns ?? [];
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="col brand-col">
      <span class="brand-text">{brand.short ?? brand.name}<em>.mifos</em></span>
      {footer.blurb && <p class="blurb">{footer.blurb}</p>}
    </div>
    {columns.map((c) => (
      <div class="col">
        <h4>{c.heading}</h4>
        <ul>
          {(c.links ?? []).map((l) => (
            <li><a href={href(l.href)} {...linkAttrs(l)}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap bottom">
    <span>{footer.copyright}</span>
  </div>
</footer>

<style>
  .footer { background: var(--surface-2); border-top: 1px solid var(--border); padding-block: 56px 28px; }
  .footer-inner { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 32px; }
  .brand-text { font-size: 1.15rem; font-weight: 800; letter-spacing: -.02em; }
  .brand-text em { color: var(--brand); font-style: normal; }
  .blurb { margin-top: 12px; color: var(--muted); font-size: .92rem; max-width: 340px; }
  h4 { font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  ul a { color: var(--text); font-size: .93rem; }
  ul a:hover { color: var(--brand); }
  .bottom { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border); color: var(--muted); font-size: .85rem; }
  @media (max-width: 760px) { .footer-inner { grid-template-columns: 1fr 1fr; } .brand-col { grid-column: 1 / -1; } }
</style>
