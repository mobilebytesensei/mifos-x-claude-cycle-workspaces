---
import { loadSite, href, linkAttrs } from "../lib/content.js";
const site = loadSite();
const brand = site.brand ?? {};
const nav = site.nav ?? {};
const links = nav.links ?? [];
const cta = nav.cta;
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label={brand.name}>
      {brand.logo
        ? <img src={brand.logo} alt={brand.name} height="28" />
        : <span class="brand-text">{brand.short ?? brand.name}<em>.mifos</em></span>}
    </a>

    <nav class="links" aria-label="Primary">
      {links.map((l) => (
        <a href={href(l.href)} {...linkAttrs(l)}>{l.label}</a>
      ))}
    </nav>

    <div class="right">
      {cta && <a class="btn btn-primary cta" href={href(cta.href)} {...linkAttrs(cta)}>{cta.label}</a>}
      <button class="theme" type="button" aria-label="Toggle theme" onclick="window.__toggleTheme && window.__toggleTheme()">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--md-surface) 82%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--md-outline-variant);
  }
  .nav-inner { display: flex; align-items: center; gap: 16px; height: 64px; }
  .brand { display: inline-flex; align-items: center; font-family: var(--md-font-display); font-weight: 800; color: var(--md-on-surface); }
  .brand-text { font-size: 1.18rem; letter-spacing: -.01em; }
  .brand-text em { color: var(--md-primary); font-style: normal; }
  .links { display: flex; align-items: center; gap: 4px; margin-inline: auto; }
  .links a {
    position: relative; color: var(--md-on-surface-variant); font-weight: 500; font-size: .9rem;
    padding: 8px 14px; border-radius: var(--md-corner-full); overflow: hidden; isolation: isolate;
    transition: color var(--md-dur-short) var(--md-ease-standard);
  }
  .links a::after { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--md-on-surface); opacity: 0; transition: opacity var(--md-dur-short) var(--md-ease-standard); }
  .links a:hover { color: var(--md-on-surface); }
  .links a:hover::after { opacity: var(--md-state-hover); }
  .right { display: flex; align-items: center; gap: 8px; }
  .theme {
    position: relative; overflow: hidden; isolation: isolate;
    display: inline-grid; place-items: center; width: 40px; height: 40px;
    border-radius: var(--md-corner-full); border: none; background: transparent;
    color: var(--md-on-surface-variant); cursor: pointer;
  }
  .theme::after { content: ""; position: absolute; inset: 0; z-index: -1; background: currentColor; opacity: 0; transition: opacity var(--md-dur-short) var(--md-ease-standard); }
  .theme:hover::after { opacity: var(--md-state-hover); }
  .theme .moon { display: none; }
  :global(:root[data-theme="dark"]) .theme .sun { display: none; }
  :global(:root[data-theme="dark"]) .theme .moon { display: block; }
  @media (max-width: 860px) {
    .links { display: none; }
    .cta { display: none; }
  }
</style>
