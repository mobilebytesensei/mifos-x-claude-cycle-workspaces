---
import { loadSite } from "../lib/content.js";
import PlatformChips from "./PlatformChips.astro";
const site = loadSite();
const t = site.mobile?.template;
const highlights = (t?.highlights ?? []).slice(0, 4);
---
{t && (
  <section class="tband">
    <div class="wrap panel">
      <div class="left">
        <span class="label">{t.label ?? "White Label Template"}</span>
        <h2><span class="ic" aria-hidden="true">{t.icon}</span> {t.name}</h2>
        {t.tagline && <p class="tagline">{t.tagline}</p>}
        {t.description && <p class="desc">{t.description}</p>}
        <PlatformChips platforms={t.platforms ?? []} size="sm" />
        <div class="cta-row">
          <a class="btn btn-primary" href={`/mobile/${t.id}`}>Explore the template</a>
          {t.github && <a class="btn btn-ghost" href={t.github} target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>}
        </div>
      </div>
      {highlights.length > 0 && (
        <ul class="checks">
          {highlights.map((h) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <span set:html={h.replace(/`([^`]+)`/g, '<code>$1</code>')}></span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .panel {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center;
    background: linear-gradient(135deg, var(--brand), color-mix(in srgb, var(--teal) 60%, var(--brand)));
    color: #fff; border-radius: 24px; padding: clamp(32px, 5vw, 56px); box-shadow: var(--elev-3);
  }
  .label { display: inline-block; font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    background: rgba(255,255,255,.18); color: #fff; padding: 5px 12px; border-radius: 999px; }
  .panel h2 { color: #fff; font-size: clamp(1.6rem, 3.5vw, 2.3rem); margin-top: 16px; display: flex; align-items: center; gap: 12px; }
  .ic { font-size: 1.6rem; }
  .tagline { color: rgba(255,255,255,.92); font-weight: 600; margin-top: 12px; font-size: 1.05rem; }
  .desc { color: rgba(255,255,255,.82); margin-top: 10px; max-width: 560px; }
  .panel :global(.plats li) { background: rgba(255,255,255,.16); border-color: rgba(255,255,255,.28); color: #fff; }
  .cta-row { margin-top: 22px; display: flex; gap: 12px; flex-wrap: wrap; }
  .cta-row .btn-primary { background: #fff; color: var(--brand-strong); }
  .cta-row .btn-ghost { color: #fff; border-color: rgba(255,255,255,.5); }
  .cta-row .btn-ghost:hover { background: rgba(255,255,255,.12); }
  .checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .checks li { display: flex; gap: 10px; align-items: flex-start; color: #fff; font-weight: 500; }
  .checks svg { flex: none; margin-top: 2px; color: #fff; }
  .checks :global(code) { background: rgba(255,255,255,.2); padding: 1px 6px; border-radius: 6px; font-size: .88em; }
  @media (max-width: 820px) { .panel { grid-template-columns: 1fr; gap: 28px; } }
</style>
