---
// AppDownloads — "Get {name}" / "Get started" section, reused across every app + the template.
import StoreBadges from "./StoreBadges.astro";
const { rec, alt = false } = Astro.props;
const dl = rec.downloads;
---
{dl && (
  <section class:list={["band", { alt }]}>
    <div class="wrap narrow ctr">
      <span class="eyebrow">Get {rec.name}</span>
      <h2>{rec.isTemplate ? "Get started" : "Download & beta channels"}</h2>
      <p class="sub">
        {rec.isTemplate
          ? "Generate your own repo from the template, or browse the source on GitHub."
          : `Ship-ready channels for ${(rec.platforms ?? []).join(", ")}. Store links go live as each channel is published.`}
      </p>
      <div class="badges"><StoreBadges downloads={dl} channels={dl.channels} /></div>
    </div>
  </section>
)}

<style>
  .band { padding-block: clamp(48px, 8vw, 88px); }
  .band.alt { background: var(--md-surface-container-low); }
  .wrap.narrow { max-width: 720px; }
  .ctr { text-align: center; }
  h2 { font-family: var(--md-font-display); font-weight: 600; font-size: clamp(1.6rem, 3.5vw, 2.2rem); margin-top: 14px; }
  .sub { margin-top: 12px; color: var(--md-on-surface-variant); }
  .badges { margin-top: 26px; display: flex; justify-content: center; }
</style>
