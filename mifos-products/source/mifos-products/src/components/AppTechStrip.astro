---
// AppTechStrip — tech-stack chip row, optionally with run configurations underneath.
const { tech = [], runConfigs = [], accent = "brand", alt = false } = Astro.props;
---
{(tech.length > 0 || runConfigs.length > 0) && (
  <section class:list={[`band accent-${accent}`, { alt }]}>
    <div class="wrap narrow ctr">
      <span class="eyebrow">Under the hood</span>
      <h2>Built with</h2>
      {tech.length > 0 && (
        <ul class="chips">
          {tech.map((t) => <li>{t}</li>)}
        </ul>
      )}
      {runConfigs.length > 0 && (
        <div class="runs">
          <h3>Run it locally</h3>
          <div class="run-grid">
            {runConfigs.map((r) => (
              <div class="run">
                <code>{r.config}</code>
                <span>{r.label}{r.note ? ` — ${r.note}` : ""}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .band { --a: var(--md-primary); --a-c: var(--md-primary-container); padding-block: clamp(48px, 8vw, 88px); }
  .band.alt { background: var(--md-surface-container-low); }
  .accent-teal   { --a: var(--md-secondary); --a-c: var(--md-secondary-container); }
  .accent-amber  { --a: var(--md-tertiary);  --a-c: var(--md-tertiary-container); }
  .accent-violet { --a: var(--violet); --a-c: var(--violet-container); }
  .wrap.narrow { max-width: 720px; }
  .ctr { text-align: center; }
  h2 { font-family: var(--md-font-display); font-weight: 600; font-size: clamp(1.5rem, 3.5vw, 2rem); margin-top: 14px; }
  .chips { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .chips li { font-weight: 600; font-size: .88rem; color: var(--a); background: var(--a-c); padding: 8px 16px; border-radius: var(--md-corner-sm); }
  .runs { margin-top: 40px; text-align: left; }
  .runs h3 { text-align: center; font-size: 1rem; font-weight: 600; margin-bottom: 16px; color: var(--md-on-surface-variant); }
  .run-grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .run { display: flex; flex-direction: column; gap: 4px; background: var(--md-surface-container-lowest); border-radius: var(--md-corner-md); padding: 14px 16px; box-shadow: var(--md-elev-1); }
  .run code { font-weight: 700; color: var(--a); font-size: .92rem; }
  .run span { color: var(--md-on-surface-variant); font-size: .82rem; }
</style>
