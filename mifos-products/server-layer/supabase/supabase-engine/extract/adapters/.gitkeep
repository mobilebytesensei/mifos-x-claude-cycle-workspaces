# Custom Adapters Directory

Place custom source adapters here.

Example:
  # adapters/tmdb_adapter.py
  from extract.base import BaseAdapter

  class TmdbAdapter(BaseAdapter):
      def fetch(self) -> list[dict]:
          # Fetch from TMDB API
          return [...]

Then register in extract/__init__.py:
  from .adapters.tmdb_adapter import TmdbAdapter
  ADAPTERS["tmdb"] = TmdbAdapter
