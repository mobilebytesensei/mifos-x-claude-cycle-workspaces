%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6200EE', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3700B3', 'lineColor': '#6200EE', 'secondaryColor': '#03DAC6', 'tertiaryColor': '#E8DEF8' }}}%%
flowchart TD
    subgraph about["ℹ️ About"]
        AboutScreen[About Screen] --> AppVersion[App Version]
        AboutScreen --> LicenseInfo[License Info]
        AboutScreen --> ContactSupport[Contact Support]
        AboutScreen --> PrivacyPolicy[Privacy Policy]
    end

    subgraph search["🔍 Search"]
        SearchHome[Search Screen] --> SearchInput[Enter Search Query]
        SearchInput --> SearchType{Search<br/>Type}

        SearchType -->|Clients| SearchClients[Search Clients]
        SearchType -->|Centers| SearchCenters[Search Centers]
        SearchType -->|Groups| SearchGroups[Search Groups]
        SearchType -->|Loans| SearchLoans[Search Loans]
        SearchType -->|Savings| SearchSavings[Search Savings]

        SearchClients --> ClientResults[Client Results]
        SearchCenters --> CenterResults[Center Results]
        SearchGroups --> GroupResults[Group Results]
        SearchLoans --> LoanResults[Loan Results]
        SearchSavings --> SavingsResults[Savings Results]

        ClientResults --> SelectResult[Select Result]
        CenterResults --> SelectResult
        GroupResults --> SelectResult
        LoanResults --> SelectResult
        SavingsResults --> SelectResult

        SelectResult --> EntityDetails([→ Entity Details])
    end

    subgraph search_record["🗂️ Search Records"]
        SearchRecords[Search Records Screen] --> RecentSearches[Recent Searches]
        SearchRecords --> SavedSearches[Saved Searches]

        RecentSearches --> SelectRecent[Select Recent]
        SelectRecent --> ExecuteSearch[Execute Search]
        ExecuteSearch --> SearchHome

        SavedSearches --> SelectSaved[Select Saved]
        SelectSaved --> ExecuteSaved[Execute Saved]
        ExecuteSaved --> SearchHome

        SavedSearches --> DeleteSaved[Delete Saved]
        DeleteSaved --> ConfirmDelete{Confirm?}
        ConfirmDelete -->|Yes| RemoveSaved[Remove]
        ConfirmDelete -->|No| SavedSearches
    end

    subgraph reports["📊 Reports"]
        ReportHome[Reports Screen] --> ReportCategories[Report Categories]

        ReportCategories --> ClientReports[Client Reports]
        ReportCategories --> LoanReports[Loan Reports]
        ReportCategories --> SavingsReports[Savings Reports]
        ReportCategories --> CollectionReports[Collection Reports]

        ClientReports --> SelectClientReport[Select Report]
        LoanReports --> SelectLoanReport[Select Report]
        SavingsReports --> SelectSavingsReport[Select Report]
        CollectionReports --> SelectCollectionReport[Select Report]

        SelectClientReport --> ReportParams[Enter Parameters]
        SelectLoanReport --> ReportParams
        SelectSavingsReport --> ReportParams
        SelectCollectionReport --> ReportParams

        ReportParams --> GenerateReport[Generate Report]
        GenerateReport --> ReportView[View Report]
        ReportView --> ExportReport[Export Report]
        ReportView --> ShareReport[Share Report]
    end

    subgraph checker["✅ Checker Inbox"]
        CheckerInbox[Checker Inbox Screen] --> PendingTasks[Pending Tasks]
        CheckerInbox --> ApprovedTasks[Approved Tasks]
        CheckerInbox --> RejectedTasks[Rejected Tasks]

        PendingTasks --> SelectTask[Select Task]
        SelectTask --> TaskDetails[Task Details]
        TaskDetails --> ReviewTask[Review Task]

        ReviewTask --> TaskAction{Action}
        TaskAction -->|Approve| ApproveTask[Approve]
        TaskAction -->|Reject| RejectTask[Reject]

        ApproveTask --> ApproveConfirm{Confirm?}
        ApproveConfirm -->|Yes| ApproveAPI[POST /approve]
        ApproveConfirm -->|No| TaskDetails
        ApproveAPI --> ApproveSuccess[Task Approved]
        ApproveSuccess --> PendingTasks

        RejectTask --> RejectReason[Enter Reason]
        RejectReason --> RejectConfirm{Confirm?}
        RejectConfirm -->|Yes| RejectAPI[POST /reject]
        RejectConfirm -->|No| TaskDetails
        RejectAPI --> RejectSuccess[Task Rejected]
        RejectSuccess --> PendingTasks
    end

    style AboutScreen fill:#6200EE,stroke:#3700B3,color:#fff
    style SearchHome fill:#03DAC6,stroke:#018786,color:#000
    style ReportHome fill:#FF9800,stroke:#F57C00,color:#000
    style CheckerInbox fill:#9C27B0,stroke:#7B1FA2,color:#fff
    style ApproveSuccess fill:#4CAF50,stroke:#2E7D32,color:#fff
