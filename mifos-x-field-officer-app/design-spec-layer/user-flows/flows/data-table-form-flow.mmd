%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#1976D2', 'secondaryColor': '#fff', 'tertiaryColor': '#E3F2FD'}}}%%
flowchart TD
    subgraph DataDriven["100% Data-Driven Architecture"]
        direction TB

        API["Fineract API<br/>GET /datatables?apptable=m_client"]
        API --> RESPONSE["Response: List&lt;DataTableEntity&gt;<br/>(1, 6, or N tables - DYNAMIC)"]

        RESPONSE --> VM["ViewModel"]

        subgraph VMState["ViewModel State (All Keys from API)"]
            direction LR
            DT["dataTables: List&lt;DataTableEntity&gt;"]
            TV["tableValues: Map&lt;String, Map&lt;String, Any&gt;&gt;"]
            TVAL["tableValidation: Map&lt;String, Boolean&gt;"]
        end

        VM --> VMState
    end

    subgraph MultiTable["DynamicDataTableList - Multi-Table Wrapper"]
        direction TB

        LIST["DynamicDataTableList(<br/>  dataTables = list,<br/>  allValues = state.tableValues,<br/>  onValuesChange = { table, values -> }<br/>)"]

        LIST --> LOOP["dataTables.forEach { dataTable -&gt; }"]
        LOOP --> |"N iterations<br/>(dynamic)"| FORM["DynamicDataTableForm(dataTable)"]
    end

    VMState --> LIST

    subgraph BuildingBlock["DynamicDataTableForm - Single Table Building Block"]
        direction TB

        A["DynamicDataTableForm(dataTable, values, onValuesChange)"]

        A --> B{"showHeader?"}
        B -->|"true"| C["DataTableHeader<br/>Card with tableName + edit icon"]
        B -->|"false"| D["Skip Header"]

        C --> E["DynamicFormGrid"]
        D --> E

        E --> F["Filter columnHeaderData"]
        F --> F1["Remove: id, *_id, timestamps"]
        F1 --> F2["Keep: User-editable columns"]

        F2 --> G["LazyVerticalGrid<br/>(1 or 2 columns)"]

        G --> H["For each ColumnHeader<br/>(M fields - dynamic)"]

        H --> I["DynamicField Router"]

        I -->|"BOOLEAN"| J1["BooleanField<br/>Switch toggle"]
        I -->|"INTEGER"| J2["IntegerField<br/>Number keyboard"]
        I -->|"DECIMAL"| J3["DecimalField<br/>Decimal keyboard"]
        I -->|"STRING"| J4["StringField<br/>Single line text"]
        I -->|"TEXT"| J5["MultilineTextField<br/>Expandable textarea"]
        I -->|"DATE"| J6["DateField<br/>Date picker dialog"]
        I -->|"DATETIME"| J7["DateTimeField<br/>DateTime picker"]
        I -->|"CODELOOKUP"| J8["DropdownField<br/>ExposedDropdownMenu"]

        J1 & J2 & J3 & J4 & J5 & J6 & J7 & J8 --> K["onValueChange(fieldName, value)"]

        K --> L["Update values map"]
        L --> M["Call onValuesChange(newMap)"]

        M --> N{"onValidationChange<br/>provided?"}
        N -->|"yes"| O["Validate all fields"]
        O --> P["Call onValidationChange(isValid)"]
        N -->|"no"| Q["Done"]
        P --> Q
    end

    FORM --> A

    subgraph StateFlow["State Flow Back to ViewModel"]
        direction TB
        UPDATE["viewModel.updateTableValues(tableName, values)"]
        UPDATE --> COLLECT["viewModel.collectAllFormData()"]
        COLLECT --> SAVE["Save to API"]
    end

    M --> UPDATE

    subgraph UsageExamples["Usage Examples (Parent Screens)"]
        direction LR

        U1["ClientDetailsScreen<br/>(N data tables)"]
        U2["LoanApplicationScreen<br/>(6 data tables)"]
        U3["BottomSheetDialog"]
        U4["AccordionSection"]
        U5["TabContent"]
    end

    U1 & U2 & U3 & U4 & U5 -->|"embed"| LIST

    subgraph DynamicConcept["What is Dynamic?"]
        direction TB
        DYN1["# of tables = dataTables.size"]
        DYN2["Table name = registeredTableName"]
        DYN3["# of fields = columnHeaderData.size"]
        DYN4["Field type = columnDisplayType"]
        DYN5["Dropdown options = columnValues"]
    end

    style API fill:#4CAF50,color:#fff
    style RESPONSE fill:#4CAF50,color:#fff
    style LIST fill:#FF9800,color:#fff
    style A fill:#1976D2,color:#fff
    style E fill:#4CAF50,color:#fff
    style I fill:#2196F3,color:#fff
    style K fill:#FF9800,color:#fff
    style Q fill:#4CAF50,color:#fff
    style UPDATE fill:#9C27B0,color:#fff
