%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6200EE', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3700B3', 'lineColor': '#6200EE', 'secondaryColor': '#03DAC6', 'tertiaryColor': '#E8DEF8' }}}%%
flowchart TD
    subgraph client_list["📋 Client List"]
        ClientList[Client List Screen] --> SearchClient[Search Clients]
        ClientList --> FilterClient[Filter by Status]
        ClientList --> CreateClient[Create New Client]
        ClientList --> SelectClient[Select Client]
    end

    subgraph client_details["👤 Client Details"]
        SelectClient --> ClientDetails[Client Details Screen]
        ClientDetails --> ClientProfile[View Profile]
        ClientDetails --> ClientAccounts[View Accounts]
        ClientDetails --> ClientDocuments[View Documents]
        ClientDetails --> ClientIdentifiers[View Identifiers]
        ClientDetails --> ClientCharges[View Charges]
        ClientDetails --> ClientSurvey[Take Survey]
        ClientDetails --> ActivateClient[Activate Client]
        ClientDetails --> TransferClient[Transfer Client]
        ClientDetails --> CloseClient[Close Client]
    end

    subgraph client_create["➕ Create Client"]
        CreateClient --> CreateForm[Create New Client Form]
        CreateForm --> BasicInfo[Basic Information]
        BasicInfo --> AddressInfo[Address Details]
        AddressInfo --> IdentificationInfo[Identification]
        IdentificationInfo --> ReviewSubmit[Review & Submit]
        ReviewSubmit --> CreateAPI[POST /clients]
        CreateAPI --> CreateResult{Result}
        CreateResult -->|Success| ClientDetails
        CreateResult -->|Error| CreateForm
    end

    subgraph client_profile["📝 Profile Management"]
        ClientProfile --> ProfileDetails[Profile Details]
        ProfileDetails --> EditProfile[Edit Profile]
        EditProfile --> SaveProfile[Save Changes]
        SaveProfile --> ProfileDetails
    end

    subgraph client_accounts["💰 Client Accounts"]
        ClientAccounts --> LoanAccounts[Loan Accounts]
        ClientAccounts --> SavingsAccounts[Savings Accounts]
        ClientAccounts --> ShareAccounts[Share Accounts]
        ClientAccounts --> FixedDeposit[Fixed Deposits]
        ClientAccounts --> RecurringDeposit[Recurring Deposits]

        LoanAccounts --> LoanDetails([→ Loan Flow])
        SavingsAccounts --> SavingsDetails([→ Savings Flow])
    end

    subgraph documents["📄 Documents"]
        ClientDocuments --> DocumentList[Document List]
        DocumentList --> AddDocument[Add Document]
        DocumentList --> PreviewDoc[Preview Document]

        AddDocument --> SelectFile[Select File]
        SelectFile --> UploadDoc[Upload Document]
        UploadDoc --> UploadResult{Result}
        UploadResult -->|Success| DocumentList
        UploadResult -->|Error| AddDocument
    end

    subgraph identifiers["🆔 Identifiers"]
        ClientIdentifiers --> IdentifierList[Identifier List]
        IdentifierList --> AddIdentifier[Add Identifier]
        IdentifierList --> EditIdentifier[Edit Identifier]

        AddIdentifier --> IdentifierForm[Identifier Form]
        IdentifierForm --> SaveIdentifier[Save]
        SaveIdentifier --> IdentifierList
    end

    subgraph survey["📊 Surveys"]
        ClientSurvey --> SurveyList[Available Surveys]
        SurveyList --> StartSurvey[Start Survey]
        StartSurvey --> SurveyQuestions[Survey Questions]
        SurveyQuestions --> NextQuestion{More<br/>Questions?}
        NextQuestion -->|Yes| SurveyQuestions
        NextQuestion -->|No| SubmitSurvey[Submit Survey]
        SubmitSurvey --> SurveyComplete[Survey Complete]
    end

    subgraph notes["📝 Notes"]
        ClientDetails --> NotesList[Notes List]
        NotesList --> AddNote[Add Note]
        NotesList --> ViewNote[View Note]
        AddNote --> SaveNote[Save Note]
        SaveNote --> NotesList
    end

    style ClientList fill:#6200EE,stroke:#3700B3,color:#fff
    style ClientDetails fill:#03DAC6,stroke:#018786,color:#000
    style CreateForm fill:#FF9800,stroke:#F57C00,color:#000
    style DocumentList fill:#9C27B0,stroke:#7B1FA2,color:#fff
    style SurveyQuestions fill:#4CAF50,stroke:#2E7D32,color:#fff
