%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6200EE', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3700B3', 'lineColor': '#6200EE', 'secondaryColor': '#03DAC6', 'tertiaryColor': '#E8DEF8' }}}%%
flowchart TD
    subgraph loan["💳 Loan Management"]
        LoanList[Loan Accounts] --> SelectLoan[Select Loan]
        SelectLoan --> LoanAccount[Loan Account Screen]

        LoanAccount --> LoanProfile[Loan Profile]
        LoanAccount --> LoanSummary[Loan Summary]
        LoanAccount --> LoanSchedule[Repayment Schedule]
        LoanAccount --> LoanTransactions[Transactions]
        LoanAccount --> LoanCharges[Charges]
        LoanAccount --> LoanActions[Actions]

        LoanActions --> ApproveLoan[Approve Loan]
        LoanActions --> DisburseLoan[Disburse Loan]
        LoanActions --> RepayLoan[Make Repayment]

        ApproveLoan --> ApproveForm[Approval Form]
        ApproveForm --> ApproveDate[Set Approval Date]
        ApproveDate --> ApproveAPI[Approve Loan API]
        ApproveAPI --> ApproveResult{Result}
        ApproveResult -->|Success| LoanAccount
        ApproveResult -->|Error| ApproveForm

        DisburseLoan --> DisburseForm[Disbursement Form]
        DisburseForm --> DisburseDetails[Enter Details]
        DisburseDetails --> DisburseAPI[Disburse Loan API]
        DisburseAPI --> DisburseResult{Result}
        DisburseResult -->|Success| LoanAccount
        DisburseResult -->|Error| DisburseForm

        RepayLoan --> RepayForm[Repayment Form]
        RepayForm --> EnterAmount[Enter Amount]
        EnterAmount --> PaymentMethod[Payment Method]
        PaymentMethod --> RepayAPI[Record Repayment API]
        RepayAPI --> RepayResult{Result}
        RepayResult -->|Success| RepayReceipt[Receipt]
        RepayResult -->|Error| RepayForm
        RepayReceipt --> LoanAccount
    end

    subgraph new_loan["➕ New Loan"]
        NewLoan[New Loan Account] --> SelectProduct[Select Loan Product]
        SelectProduct --> LoanTerms[Enter Loan Terms]
        LoanTerms --> ReviewLoan[Review Loan]
        ReviewLoan --> SubmitLoan[Submit Application]
        SubmitLoan --> LoanSubmitResult{Result}
        LoanSubmitResult -->|Success| LoanAccount
        LoanSubmitResult -->|Error| LoanTerms
    end

    subgraph savings["💰 Savings Management"]
        SavingsList[Savings Accounts] --> SelectSavings[Select Account]
        SelectSavings --> SavingsAccount[Savings Account Screen]

        SavingsAccount --> SavingsSummary[Account Summary]
        SavingsAccount --> SavingsActions[Actions]

        SavingsActions --> ApproveSavings[Approve Account]
        SavingsActions --> ActivateSavings[Activate Account]
        SavingsActions --> SavingsTransaction[Make Transaction]

        ApproveSavings --> ApprovalForm[Approval Form]
        ApprovalForm --> SavingsApproveAPI[Approve Savings API]
        SavingsApproveAPI --> SavingsAccount

        ActivateSavings --> ActivateForm[Activation Form]
        ActivateForm --> SavingsActivateAPI[Activate Savings API]
        SavingsActivateAPI --> SavingsAccount

        SavingsTransaction --> TransactionType{Transaction<br/>Type}
        TransactionType -->|Deposit| DepositForm[Deposit Form]
        TransactionType -->|Withdrawal| WithdrawForm[Withdrawal Form]
        DepositForm --> TransactionAPI[Transaction API]
        WithdrawForm --> TransactionAPI
        TransactionAPI --> TransactionReceipt[Transaction Receipt]
        TransactionReceipt --> SavingsAccount
    end

    subgraph recurring["🔄 Recurring Deposits"]
        RDList[Recurring Deposits] --> SelectRD[Select RD Account]
        SelectRD --> RDAccount[RD Account Screen]

        RDAccount --> RDSummary[Account Summary]
        RDAccount --> RDSchedule[Deposit Schedule]
        RDAccount --> RDTransaction[Make Deposit]

        RDTransaction --> RDDepositForm[Deposit Form]
        RDDepositForm --> RDDepositAPI[Deposit API]
        RDDepositAPI --> RDReceipt[Receipt]
        RDReceipt --> RDAccount
    end

    subgraph group_loan["👥 Group Loans"]
        GroupLoan[Group Loan Account] --> GroupLoanDetails[Loan Details]
        GroupLoanDetails --> GroupMembers[Member Loans]
        GroupMembers --> MemberRepay[Member Repayment]
    end

    style LoanAccount fill:#6200EE,stroke:#3700B3,color:#fff
    style SavingsAccount fill:#03DAC6,stroke:#018786,color:#000
    style RDAccount fill:#FF9800,stroke:#F57C00,color:#000
    style RepayReceipt fill:#4CAF50,stroke:#2E7D32,color:#fff
    style TransactionReceipt fill:#4CAF50,stroke:#2E7D32,color:#fff
