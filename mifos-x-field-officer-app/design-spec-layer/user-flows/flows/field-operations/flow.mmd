%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6200EE', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3700B3', 'lineColor': '#6200EE', 'secondaryColor': '#03DAC6', 'tertiaryColor': '#E8DEF8' }}}%%
flowchart TD
    subgraph centers["🏢 Center Management"]
        CenterList[Center List Screen] --> SearchCenter[Search Centers]
        CenterList --> CreateCenter[Create Center]
        CenterList --> SelectCenter[Select Center]
        CenterList --> SyncCenters[Sync Centers]

        SelectCenter --> CenterDetails[Center Details Screen]
        CenterDetails --> CenterGroups[View Groups]
        CenterDetails --> CenterAccounts[View Accounts]
        CenterDetails --> ActivateCenter[Activate Center]

        CreateCenter --> CenterForm[Create Center Form]
        CenterForm --> EnterCenterInfo[Enter Center Info]
        EnterCenterInfo --> SelectOffice[Select Office]
        SelectOffice --> SelectStaff[Select Staff]
        SelectStaff --> SubmitCenter[Submit]
        SubmitCenter --> CenterResult{Result}
        CenterResult -->|Success| CenterDetails
        CenterResult -->|Error| CenterForm

        SyncCenters --> SyncCenterDialog[Sync Dialog]
        SyncCenterDialog --> SyncCenterProgress[Syncing...]
        SyncCenterProgress --> SyncCenterComplete[Sync Complete]
    end

    subgraph groups["👥 Group Management"]
        CenterGroups --> GroupList[Group List Screen]
        GroupList --> SearchGroup[Search Groups]
        GroupList --> CreateGroup[Create Group]
        GroupList --> SelectGroup[Select Group]
        GroupList --> SyncGroups[Sync Groups]

        SelectGroup --> GroupDetails[Group Details Screen]
        GroupDetails --> GroupMembers[View Members]
        GroupDetails --> GroupAccounts[View Accounts]
        GroupDetails --> ActivateGroup[Activate Group]

        CreateGroup --> GroupForm[Create Group Form]
        GroupForm --> EnterGroupInfo[Enter Group Info]
        EnterGroupInfo --> SelectGroupOffice[Select Office]
        SelectGroupOffice --> AddMembers[Add Members]
        AddMembers --> SubmitGroup[Submit]
        SubmitGroup --> GroupResult{Result}
        GroupResult -->|Success| GroupDetails
        GroupResult -->|Error| GroupForm

        SyncGroups --> SyncGroupDialog[Sync Dialog]
        SyncGroupDialog --> SyncGroupComplete[Sync Complete]
    end

    subgraph collection["📋 Collection Sheet"]
        CollectionHome[Collection Sheet Home] --> SelectCollectionType{Collection<br/>Type}

        SelectCollectionType -->|Center| GenerateCenter[Generate Center Sheet]
        SelectCollectionType -->|Individual| IndividualSheet[Individual Sheet]

        GenerateCenter --> SelectCenterDate[Select Date & Center]
        SelectCenterDate --> GenerateAPI[GET /collectionsheet]
        GenerateAPI --> CollectionSheet[Collection Sheet]

        CollectionSheet --> EnterPayments[Enter Payments]
        EnterPayments --> PaymentDetails[Payment Details]
        PaymentDetails --> SubmitCollection[Submit Collection]
        SubmitCollection --> CollectionResult{Result}
        CollectionResult -->|Success| CollectionSuccess[Success]
        CollectionResult -->|Error| EnterPayments

        IndividualSheet --> IndividualList[Individual List]
        IndividualList --> SelectIndividual[Select Individual]
        SelectIndividual --> IndividualDetails[Individual Details]
        IndividualDetails --> IndividualPayment[Record Payment]
        IndividualPayment --> IndividualResult{Result}
        IndividualResult -->|Success| IndividualList
    end

    subgraph offline["📴 Offline Mode"]
        OfflineHome[Offline Dashboard] --> SyncStatus[Sync Status]
        OfflineHome --> PendingSync[Pending Sync]
        OfflineHome --> OfflineData[Offline Data]

        PendingSync --> ViewPending[View Pending Items]
        ViewPending --> SyncNow[Sync Now]
        SyncNow --> SyncProgress[Syncing...]
        SyncProgress --> SyncResult{Result}
        SyncResult -->|Success| SyncComplete[All Synced]
        SyncResult -->|Partial| PartialSync[Partial Sync]
        SyncResult -->|Error| SyncError[Sync Failed]

        OfflineData --> CachedClients[Cached Clients]
        OfflineData --> CachedCenters[Cached Centers]
        OfflineData --> CachedCollections[Cached Collections]
    end

    subgraph path_tracking["📍 Path Tracking"]
        PathHome[Path Tracking Home] --> StartTracking[Start Tracking]
        PathHome --> ViewHistory[View History]

        StartTracking --> TrackingActive[Tracking Active]
        TrackingActive --> RecordLocation[Record Location]
        RecordLocation --> AddVisit[Add Client Visit]
        AddVisit --> VisitDetails[Visit Details]
        VisitDetails --> SaveVisit[Save Visit]
        SaveVisit --> TrackingActive

        TrackingActive --> StopTracking[Stop Tracking]
        StopTracking --> TrackingSummary[Tracking Summary]
        TrackingSummary --> UploadPath[Upload Path]

        ViewHistory --> PathList[Path History List]
        PathList --> PathDetails[Path Details]
        PathDetails --> PathMap[View on Map]
    end

    style CenterList fill:#6200EE,stroke:#3700B3,color:#fff
    style GroupList fill:#03DAC6,stroke:#018786,color:#000
    style CollectionSheet fill:#FF9800,stroke:#F57C00,color:#000
    style OfflineHome fill:#9C27B0,stroke:#7B1FA2,color:#fff
    style TrackingActive fill:#4CAF50,stroke:#2E7D32,color:#fff
