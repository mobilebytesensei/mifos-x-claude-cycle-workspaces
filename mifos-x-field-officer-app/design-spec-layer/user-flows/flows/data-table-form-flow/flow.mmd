%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6200EE', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3700B3', 'lineColor': '#6200EE', 'secondaryColor': '#03DAC6', 'tertiaryColor': '#E8DEF8' }}}%%
flowchart TD
    subgraph data_table["📊 Data Table Flow"]
        EntityScreen[Entity Screen] --> DataTableList[Data Tables List]
        DataTableList --> SelectDataTable[Select Data Table]
        SelectDataTable --> DataTableView[Data Table View]

        DataTableView --> ViewEntries[View Entries]
        DataTableView --> AddEntry[Add Entry]
        DataTableView --> EditEntry[Edit Entry]
        DataTableView --> DeleteEntry[Delete Entry]
    end

    subgraph form_flow["📝 Form Flow"]
        AddEntry --> DataTableForm[Data Table Form]
        EditEntry --> DataTableForm

        DataTableForm --> FormFields[Form Fields]
        FormFields --> ValidateForm{Validate<br/>Form}

        ValidateForm -->|Invalid| ShowErrors[Show Validation Errors]
        ShowErrors --> FormFields

        ValidateForm -->|Valid| SubmitForm[Submit Form]
        SubmitForm --> FormResult{Result}
        FormResult -->|Success| FormSuccess[Success]
        FormResult -->|Error| FormError[Show Error]

        FormSuccess --> DataTableView
        FormError --> FormFields
    end

    subgraph field_types["🔤 Field Types"]
        FormFields --> TextField[Text Field]
        FormFields --> NumberField[Number Field]
        FormFields --> DateField[Date Field]
        FormFields --> DropdownField[Dropdown Field]
        FormFields --> CheckboxField[Checkbox Field]
        FormFields --> MultiSelectField[Multi-Select Field]

        DropdownField --> LoadOptions[Load Options]
        LoadOptions --> SelectOption[Select Option]

        DateField --> DatePicker[Date Picker]
        DatePicker --> SelectDate[Select Date]

        MultiSelectField --> MultiSelectDialog[Multi-Select Dialog]
        MultiSelectDialog --> SelectMultiple[Select Items]
    end

    subgraph delete_flow["🗑️ Delete Flow"]
        DeleteEntry --> DeleteConfirm{Confirm<br/>Delete?}
        DeleteConfirm -->|No| DataTableView
        DeleteConfirm -->|Yes| DeleteAPI[DELETE Entry]
        DeleteAPI --> DeleteResult{Result}
        DeleteResult -->|Success| DeleteSuccess[Entry Deleted]
        DeleteResult -->|Error| DeleteError[Delete Failed]
        DeleteSuccess --> DataTableView
        DeleteError --> DataTableView
    end

    style EntityScreen fill:#6200EE,stroke:#3700B3,color:#fff
    style DataTableView fill:#03DAC6,stroke:#018786,color:#000
    style DataTableForm fill:#FF9800,stroke:#F57C00,color:#000
    style FormSuccess fill:#4CAF50,stroke:#2E7D32,color:#fff
    style DeleteSuccess fill:#4CAF50,stroke:#2E7D32,color:#fff
