%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#6200EE', 'primaryTextColor': '#fff', 'primaryBorderColor': '#3700B3', 'lineColor': '#6200EE', 'secondaryColor': '#03DAC6', 'tertiaryColor': '#E8DEF8' }}}%%
flowchart TD
    subgraph auth["🔐 Authentication Flow"]
        Start([App Launch]) --> SplashScreen[Splash Screen]
        SplashScreen --> CheckSession{Session<br/>Valid?}

        CheckSession -->|No| LoginScreen[Login Screen]
        CheckSession -->|Yes| PasscodeScreen[Passcode Screen]

        LoginScreen --> ValidateInputs{Validate<br/>Inputs}
        ValidateInputs -->|Invalid| ShowValidationError[Show Validation Error]
        ShowValidationError --> LoginScreen

        ValidateInputs -->|Valid| AuthAPI[POST /authentication]
        AuthAPI --> AuthResult{Auth<br/>Result}

        AuthResult -->|Error| ShowLoginError[Show Error Message]
        ShowLoginError --> LoginScreen

        AuthResult -->|Success| SaveSession[Save Session]
        SaveSession --> PasscodeCheck{Passcode<br/>Set?}

        PasscodeCheck -->|No| HomeScreen([Home Screen])
        PasscodeCheck -->|Yes| PasscodeScreen

        PasscodeScreen --> PasscodeValid{Passcode<br/>Correct?}
        PasscodeValid -->|No| PasscodeError[Show Error]
        PasscodeError --> PasscodeScreen
        PasscodeValid -->|Yes| HomeScreen
    end

    subgraph settings["⚙️ Settings Flow"]
        SettingsScreen[Settings Screen] --> ThemeSettings[Theme Settings]
        SettingsScreen --> LanguageSettings[Language Settings]
        SettingsScreen --> ServerConfig[Server Configuration]
        SettingsScreen --> SyncSurveys[Sync Surveys]

        ServerConfig --> UpdateServerConfig[Update Server URL]
        UpdateServerConfig --> ValidateServer{Server<br/>Valid?}
        ValidateServer -->|Yes| SaveConfig[Save Configuration]
        ValidateServer -->|No| ServerError[Show Error]

        SyncSurveys --> SyncDialog[Sync Surveys Dialog]
        SyncDialog --> SyncComplete[Sync Complete]
    end

    subgraph activate["✅ Activate Entity Flow"]
        EntityList[Entity List] --> SelectEntity[Select Entity]
        SelectEntity --> ActivateScreen[Activate Screen]
        ActivateScreen --> SelectDate[Select Activation Date]
        SelectDate --> ConfirmActivate{Confirm<br/>Activate?}
        ConfirmActivate -->|No| EntityList
        ConfirmActivate -->|Yes| ActivateAPI[POST /entity/activate]
        ActivateAPI --> ActivateResult{Result}
        ActivateResult -->|Success| ActivateSuccess[Show Success]
        ActivateResult -->|Error| ActivateError[Show Error]
        ActivateSuccess --> EntityDetails[Entity Details]
    end

    HomeScreen --> SettingsScreen
    HomeScreen --> EntityList

    style Start fill:#4CAF50,stroke:#2E7D32,color:#fff
    style HomeScreen fill:#4CAF50,stroke:#2E7D32,color:#fff
    style LoginScreen fill:#6200EE,stroke:#3700B3,color:#fff
    style PasscodeScreen fill:#6200EE,stroke:#3700B3,color:#fff
    style SettingsScreen fill:#03DAC6,stroke:#018786,color:#000
    style ActivateScreen fill:#FF9800,stroke:#F57C00,color:#000
