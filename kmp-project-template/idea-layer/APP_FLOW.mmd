%% APP_FLOW.mmd — Money Toolkit (kmp-project-template)
%% Re-materialized 2026-08-05 (/idea sync --artifacts-only) from the 15
%% screens/{feature}/flow.yaml nav edges + flows/kmp-project-template-flows.yaml.
%% Re-verified against current SoT: no nav-edge changes since 2026-08-01; the
%% 2026-08-03 ui.yaml edits were component/state enrichments (no new screens or
%% edges). No invented screens or edges.
%% 35 screen nodes across 4 domains. Solid = shipped. Dashed = planned / UI-pending / declared-intent.
%% FAITHFUL: NO auth feature — NavHost starts directly at `home`; 2-tab bottom nav
%% (Home + Profile); NO home 'Markets' tile ships at HEAD — the crypto cluster is
%% reached via navigateToCrypto() and the home→coinMarkets edge is declared-intent only.
flowchart TD
    %% ── App entry + bottom-nav shell (2 tabs, no auth gate) ──
    navhost{{"NavHost start · AuthenticatedNavbar (no auth feature)"}}
    shell(["Bottom Nav shell — Home · Profile tabs"])
    navhost -->|app launch| shell
    shell -->|Home tab| home
    shell -->|Profile tab| profile

    %% ── Domain: App Shell ──
    subgraph SHELL["App Shell"]
        home["home — HomeScreen · composite dashboard"]
        profile["profile — ProfileScreen · leaf tab"]
        settings["settings — SettingsScreen"]
        notification["notification — NotificationScreen · registered leaf"]
        themeDialog(["theme-dialog — SettingsDialog"])
        languageDialog(["language-dialog — LanguageDialog"])
        devMenu(["dev-menu — DevMenuDialog · dev-only"])
        stateGallery["state-gallery — StateGalleryScreen · dev-only"]
        transitionGallery["transition-gallery — TransitionGalleryScreen · dev-only"]
        transitionDemo["transition-demo — TransitionDemoScreen · dev-only"]
    end

    home -->|settings icon · ad-hoc| settings
    settings -.->|version long-press · dev| devMenu
    settings -->|Change Theme card| themeDialog
    settings -->|Change Language card| languageDialog
    themeDialog -.->|dismiss| settings
    languageDialog -.->|dismiss| settings
    devMenu -.->|State Gallery| stateGallery
    devMenu -.->|Transition Gallery| transitionGallery
    stateGallery -.->|back| settings
    transitionGallery -.->|variant tap| transitionDemo
    transitionDemo -.->|auto-pop 2s| transitionGallery
    transitionGallery -.->|back| settings

    %% ── Domain: Banking / local ──
    subgraph BANKING["Banking / local"]
        loansList["loans-list — PersonalLoansListScreen"]
        loanDetail["loan-detail — LoanDetailScreen"]
        loanAddedit["loan-addedit — AddOrEditLoanScreen"]
        amortSchedule["amortization-schedule — AmortizationScheduleScreen"]
        emiCalculator["emiCalculator — EmiCalculatorScreen"]
        affordability["affordability-calculator — AffordabilityCalculatorScreen"]
        amortization["amortization — AmortizationScreen · calculators"]
        comparison["comparison — LoanComparisonScreen"]
        wizard["wizard — LoanCalcWizardScreen"]
        billsList["bills-list — BillRemindersListScreen"]
        billAddedit["bill-addedit — AddOrEditBillReminderScreen"]
    end

    home -->|Loan tile / hero| loansList
    home -->|Upcoming Bills 'See all'| billsList
    home -->|EMI Calculator tile| emiCalculator
    home -->|Affordability tile| affordability
    home -->|Amortization tile| amortization
    home -->|Compare Loans tile| comparison
    home -->|Loan Wizard tile| wizard
    loansList -->|New loan FAB| loanAddedit
    loansList -->|row tap| loanDetail
    loanDetail -->|Edit| loanAddedit
    loanDetail -->|Schedule · ad-hoc| amortSchedule
    loanDetail -->|back / delete confirm| loansList
    loanAddedit -->|saved / back| loansList
    amortSchedule -->|back| loanDetail
    emiCalculator -->|back| home
    wizard -.->|Step 5 Save · upsert Loan| loansList
    billsList -->|New bill FAB| billAddedit
    billsList -->|row tap · edit| billAddedit
    billAddedit -->|back| billsList

    %% ── Domain: Economic / network ──
    subgraph ECONOMIC["Economic / network"]
        rates["rates — RatesListScreen · FRED"]
        rateDetail["rateDetail — RateDetailScreen"]
        currencyList["currency-rates-list — CurrencyRatesScreen · Frankfurter"]
        spotConverter(["currency-spot-converter — embedded facet"])
        rateHistory["rate-history — RateHistoryScreen"]
        macro["macro — CountryMacroScreen · World Bank"]
        countryPicker["countryPicker — CountryPickerScreen"]
        macroDetail["macroIndicatorDetail — IndicatorDetailScreen"]
    end

    home -->|Today's Rates 'See all'| rates
    home -->|USD Exchange / Currency tile| currencyList
    home -->|Rate History tile| rateHistory
    home -->|Country Macro tile| macro
    rates -->|rate row tap| rateDetail
    rateDetail -->|back| rates
    currencyList -.->|embeds facet| spotConverter
    macro -->|country chip| countryPicker
    macro -->|indicator card| macroDetail
    countryPicker -->|country picked · rebuild| macro
    macroDetail -->|back| macro

    %% ── Domain: Crypto (half-built cluster — UI-pending) ──
    subgraph CRYPTO["Crypto"]
        coinMarkets["coinMarkets — CoinMarketsScreen · paged"]
        coinDetail["coinDetail — CoinDetailScreen · PLANNED"]
        watchlist["watchlist — WatchlistScreen · UI-pending"]
        addToWatchlist(["add-to-watchlist — AddToWatchlistStar · embedded"])
        alertsList["alerts-list — PriceAlertsListScreen · UI-pending"]
        alertAddedit["alert-addedit — AddOrEditAlertScreen · UI-pending"]
    end

    home -.->|Markets tile · declared-intent / navigateToCrypto| coinMarkets
    coinMarkets -->|top-bar Watchlist action| watchlist
    coinMarkets -->|top-bar Price-alerts action| alertsList
    coinMarkets -.->|row tap · PLANNED no-op| coinDetail
    coinMarkets -.->|embeds star| addToWatchlist
    watchlist -.->|row tap · PLANNED| coinDetail
    watchlist -->|empty CTA / back| coinMarkets
    home -.->|navigateToWatchlist · when wired| watchlist
    home -.->|navigateToAlerts · PROPOSED| alertsList
    alertsList -->|New alert FAB| alertAddedit
    alertsList -->|row tap · edit| alertAddedit
    alertAddedit -->|saved / back| alertsList

    %% ── Styling ──
    classDef entry fill:#4CAF50,color:#fff,stroke:#2E7D32;
    classDef shell fill:#607D8B,color:#fff,stroke:#37474F;
    classDef banking fill:#2196F3,color:#fff,stroke:#1565C0;
    classDef economic fill:#009688,color:#fff,stroke:#00695C;
    classDef crypto fill:#FF9800,color:#fff,stroke:#E65100;
    classDef overlay fill:#ECEFF1,color:#37474F,stroke:#90A4AE,stroke-dasharray:3 3;
    classDef devonly fill:#9E9E9E,color:#fff,stroke:#616161,stroke-dasharray:4 3;
    classDef pending fill:#FFF3E0,color:#E65100,stroke:#FB8C00,stroke-dasharray:6 4;
    classDef planned fill:#FCE4EC,color:#AD1457,stroke:#EC407A,stroke-dasharray:6 4;

    class navhost,shell entry;
    class home,profile,settings,notification shell;
    class themeDialog,languageDialog overlay;
    class devMenu,stateGallery,transitionGallery,transitionDemo devonly;
    class loansList,loanDetail,loanAddedit,amortSchedule,emiCalculator,affordability,amortization,comparison,wizard,billsList,billAddedit banking;
    class rates,rateDetail,currencyList,spotConverter,rateHistory,macro,countryPicker,macroDetail economic;
    class coinMarkets crypto;
    class coinDetail planned;
    class watchlist,addToWatchlist,alertsList,alertAddedit pending;
